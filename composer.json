        "drupal/allowed_formats": "^3.0",
        "drupal/auto_entitylabel": "^3.0",
        "drupal/auto_rotate_lite": "^1.0",
        "drupal/better_exposed_filters": "^7.2",
        "drupal/block_class": "^2.0",
        "drupal/block_visibility_groups": "^2.0",
        "drupal/blog": "^3.1",
        "drupal/calendar": "^1.0@alpha",
        "drupal/calendar_view": "^2.1",
        "drupal/captcha": "^2.0",
        "drupal/cer": "^5.0@beta",
        "drupal/chosen": "^3.0",
        "drupal/colorbox": "^2.0",
        "drupal/comment_notify": "^1.3",
        "drupal/composer_deploy": "^1.7",
        "drupal/computed_field": "^4.0@alpha",
        "drupal/conditional_fields": "^4.0@alpha",
        "drupal/config_ignore": "^3.3",
        "drupal/config_pages": "^2.15",
        "drupal/config_update": "^2.0@alpha",
        "drupal/core-composer-scaffold": "^11.4",
        "drupal/core-project-message": "^11.4",
        "drupal/core-recommended": "^11.4",
        "drupal/csv_serialization": "^4.0",
        "drupal/ctools": "^4.0",
        "drupal/date_all_day": "^2.0",
        "drupal/date_popup": "^2.0",
        "drupal/dropzonejs": "^2.7",
        "drupal/eck": "^2.0",
        "drupal/eck_bundle_permissions": "^1.1",
        "drupal/entity": "^1.4",
        "drupal/entity_browser": "^2.8",
        "drupal/entity_print": "^2.18",
        "drupal/entity_reference_revisions": "^1.10",
        "drupal/epp": "^1.3",
        "drupal/eva": "^3.0",
        "drupal/exif_orientation": "^1.5",
        "drupal/feeds": "^3.0@beta",
        "drupal/feeds_tamper": "^2.0@beta",
        "drupal/field_expression": "^2.0",
        "drupal/field_formatter_class": "^1.6",
        "drupal/field_group": "^4.0",
        "drupal/field_token_value": "^3.0",
        "drupal/file_mdm": "^3.0",
        "drupal/filefield_paths": "^1.0@beta",
        "drupal/flag": "^5.2",
        "drupal/form_mode_control": "^2.1",
        "drupal/fpa": "^4.0",
        "drupal/fullcalendar": "^3.0",
        "drupal/fullcalendar_view": "^5.1",
        "drupal/geocoder": "^3.39||^4.15",
        "drupal/geofield": "^10.3",
        "drupal/geofield_map": "^11.1",
        "drupal/image_effects": "^4.0",
        "drupal/image_style_warmer": "^1.2",
        "drupal/inline_entity_form": "^3.0",
        "drupal/insert_view": "^3.0",
        "drupal/job_scheduler": "^4.0",
        "drupal/jquery_ui_accordion": "^2.0",
        "drupal/layout_builder_styles": "^2.1",
        "drupal/leaflet": "^10.0",
        "drupal/linkicon": "^2.0",
        "drupal/mailsystem": "^4.4",
        "drupal/media_bulk_upload": "^3.0",
        "drupal/metatag": "^2.0",
        "drupal/migrate_plus": "^6.0",
        "drupal/migrate_source_csv": "^3.5",
        "drupal/migrate_spreadsheet": "^2.2",
        "drupal/migrate_tools": "^6.0",
        "drupal/migrate_upgrade": "^4.0",
        "drupal/modal_page": "^6.0@beta",
        "drupal/module_builder": "^4.1",
        "drupal/module_filter": "^5.0",
        "drupal/optional_end_date": "^1.4",
        "drupal/page_manager": "^4.0@RC",
        "drupal/paragraphs": "^1.21",
        "drupal/pathauto": "^1.11",
        "drupal/prepopulate": "^2.3",
        "drupal/profile": "^1.7",
        "drupal/recaptcha": "^3.1",
        "drupal/redirect": "^1.8",
        "drupal/registration": "^3.0@beta",
        "drupal/role_delegation": "^1.2",
        "drupal/rules": "^4.0",
        "drupal/rules_flag": "^1.0",
        "drupal/rules_token": "^2.0",
        "drupal/s3fs": "^3.9",
        "drupal/site_settings": "^2.0@alpha",
        "drupal/smart_date": "^4.2",
        "drupal/smtp": "*",
        "drupal/stage_file_proxy": "^3.1",
        "drupal/superfish": "^1.4",
        "drupal/symfony_mailer": "^1.6",
        "drupal/taxonomy_menu": "^3.6",
        "drupal/token": "^1.11",
        "drupal/token_filter": "^2.1",
        "drupal/token_views_filter": "^2.0",
        "drupal/tr_rulez": "^2.0",
        "drupal/twig_tweak": "^3.2",
        "drupal/upgrade_status": "^4.0",
        "drupal/views_aggregator": "^2.1",
        "drupal/views_autocomplete_filters": "^2.0",
        "drupal/views_bootstrap": "^5.3",
        "drupal/views_bulk_operations": "^4.2",
        "drupal/views_data_export": "^1.2",
        "drupal/views_entity_form_field": "^1.0@beta",
        "drupal/views_field_view": "^1.0@beta",
        "drupal/views_load_more": "^2.0@alpha",
        "drupal/views_simple_math_field": "^3.0",
        "drupal/views_slideshow": "^5.0",
        "drupal/views_tree": "^3.0",
        "drupal/views_url_path_arguments": "^1.1",
        "drupal/weight": "^3.3",
        "drupal/workflow": "^2.0",
        "drupal/xls_serialization": "^2.1",
        "drupal/xmlsitemap": "^2.0",
        "drush/drush": "^13.7",
        "endroid/qr-code": "^6.0",
        "enyo/dropzone": "^5.7",
        "geocoder-php/google-maps-provider": "^4.7",
        "guzzlehttp/guzzle": "^7.12.1",
        "guzzlehttp/psr7": "^2.12.1",
        "mtdowling/jmespath.php": "^2.9.1",
        "oomphinc/composer-installers-extender": "^2.0",
        "phpoffice/phpspreadsheet": "^2.2",
        "psr/cache": "^3.0",
        "webklex/php-imap": "^6.2",
        "wikimedia/composer-merge-plugin": "^2.0",
        "willdurand/geocoder": "^4.0"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "oomphinc/composer-installers-extender": true,
            "wikimedia/composer-merge-plugin": true,
            "cweagans/composer-patches": true,
            "php-http/discovery": true,
            "symfony/runtime": true
        },
        "audit": {
            "ignore": {
                "PKSA-96jv-mtjg-g2v8": "phpoffice/phpspreadsheet 2.4.7 is pinned by two DISABLED modules (migrate_spreadsheet, xls_views_data_export); the 2->3 upgrade is a ROADMAP item (surfaced 2026-11-07). Acknowledged 2026-11-08 so composer update --lock / require are not blocked; remove these ignores when phpspreadsheet moves to 3.10.8+.",
                "PKSA-dxd5-wy68-pq29": "phpoffice/phpspreadsheet 2.4.7 is pinned by two DISABLED modules (migrate_spreadsheet, xls_views_data_export); the 2->3 upgrade is a ROADMAP item (surfaced 2026-11-07). Acknowledged 2026-11-08 so composer update --lock / require are not blocked; remove these ignores when phpspreadsheet moves to 3.10.8+.",
                "PKSA-r15m-kszr-8n8q": "phpoffice/phpspreadsheet 2.4.7 is pinned by two DISABLED modules (migrate_spreadsheet, xls_views_data_export); the 2->3 upgrade is a ROADMAP item (surfaced 2026-11-07). Acknowledged 2026-11-08 so composer update --lock / require are not blocked; remove these ignores when phpspreadsheet moves to 3.10.8+."
            }
        }
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "patches": {
            "drupal/core": {
                "strnatcasecmp-Passing-null-to-parameter-2of-type-string-is-deprecated": "patches/3315678-25.patch"
            },
            "drupal/views_aggregator": {
                "3484017-tablegetcellraw-return-value": "patches/views_aggregator-3484017-mr27.patch"
            },
            "drupal/page_manager": {
                "page-manager-3438993-MR34-24": "patches/page-manager-3438993-MR34-24.patch",
                "calculateDependencies() must return $this, not the array — core 11.4 search post-update chains ->getDependencies() on it (page_manager 4.0.0; no upstream fix tagged)": "patches/page_manager-calculateDependencies-return-this.patch"
            }
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[web-root]/robots.txt": false,
                "[web-root]/.htaccess": false
            }
        },
        "merge-plugin": {
            "include": [
                "web/modules/contrib/dropzonejs/composer.libraries.json"
            ]
        },
        "installer-types": [
            "drupal-library"
        ],
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library",
                "harvesthq/chosen"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/8/install",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        }
    },
    "require-dev": {
        "drupal/devel": "^5.0"
    }
}
