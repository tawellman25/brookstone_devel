--- /dev/null
+++ b/tests/src/Functional/Plugin/ViewsAggregatorNodeTest.php
@@ -0,0 +1,86 @@
+<?php
+
+namespace Drupal\Tests\views_aggregator\Functional\Plugin;
+
+use Drupal\field\Entity\FieldConfig;
+use Drupal\field\Entity\FieldStorageConfig;
+use Drupal\node\Entity\Node;
+use Drupal\node\Entity\NodeType;
+use Drupal\Tests\views\Functional\ViewTestBase;
+
+/**
+ * Tests Views Aggregator on Node specific Views.
+ */
+class ViewsAggregatorNodeTest extends ViewTestBase {
+
+  /**
+   * Views used by this test.
+   *
+   * @var array
+   */
+  public static $testViews = ['va_test_node_table'];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'node',
+    'views',
+    'views_aggregator',
+    'views_aggregator_test_config',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected $defaultTheme = 'stark';
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp($import_test_views = TRUE, $modules = ['views_aggregator_test_config']): void {
+    parent::setUp($import_test_views, $modules);
+    $this->enableViewsTestModule();
+    // Create a content type with a numeric field.
+    NodeType::create([
+      'type' => 'person',
+      'name' => 'Person',
+    ])->save();
+
+    FieldStorageConfig::create([
+      'field_name' => 'field_age',
+      'entity_type' => 'node',
+      'type' => 'integer',
+    ])->save();
+
+    FieldConfig::create([
+      'field_name' => 'field_age',
+      'entity_type' => 'node',
+      'bundle' => 'person',
+      'label' => 'Age',
+    ])->save();
+  }
+
+  /**
+   * Tests aggregator behavior when a field on an entity is NULL.
+   */
+  public function testNullEntityFieldAggregation(): void {
+    // Create a node with no value for field_age.
+    $node = Node::create([
+      'type' => 'person',
+      'title' => 'Peter',
+    ]);
+    $node->save();
+
+    // Visit the page and check the rendered output.
+    $this->drupalGet('va-test-node-table');
+
+    // Check that Peter is listed.
+    $this->assertSession()->pageTextContains('Peter');
+
+    // Check that the sum of field_age handles NULL safely.
+    $xpath = '//tfoot/tr/td[contains(@class, "views-field-field-age")]';
+    $this->assertSession()->elementTextContains('xpath', $xpath, '0');
+  }
+
+}
-- 
