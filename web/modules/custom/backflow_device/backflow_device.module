<?php

/**
 * @file
 * Backflow Device lifecycle hooks.
 *
 * Gate 2 (module logic only — no new fields):
 *  - On insert, assign a stable Device ID title (BF-NNNNNN) and generate a
 *    permanent QR code encoding the device's ABSOLUTE CANONICAL URL.
 *  - On the public "full" view mode, render a pull-through street address
 *    (current value, reaching into the referenced property by code) without
 *    granting any access on the properties entity.
 *
 * The QR is permanent: it is generated once on insert (when field_qr_code is
 * empty) and never regenerated by a later ->save(). The QR encodes the
 * canonical route (immutable) — Redirect 301s it to the property-path alias.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\ContentEntityInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Render\Markup;
use Drupal\Core\Url;
use Drupal\Core\File\FileExists;
use Drupal\Core\File\FileSystemInterface;
use Drupal\Core\Site\Settings;
use Endroid\QrCode\Builder\Builder;
use Endroid\QrCode\Encoding\Encoding;
use Endroid\QrCode\ErrorCorrectionLevel;
use Endroid\QrCode\Writer\PngWriter;

/**
 * Canonical production base URL for QR generation in non-web contexts.
 *
 * The device QR must encode a full, off-site-scannable URL. In a Drush/import/
 * queue context there is no request host, so this is the fallback host used
 * when Drupal would otherwise emit "http://default/". Override site-wide by
 * setting $settings['base_url'] in settings.php (preferred where configured).
 */
const BACKFLOW_DEVICE_CANONICAL_BASE_URL = 'https://brookstoneoutdoors.com';

/**
 * Implements hook_entity_insert().
 *
 * Only fires on insert (id now known). A normal later ->save() is an update
 * and never re-enters this hook, so the title and QR are written exactly once.
 */
function backflow_device_entity_insert(EntityInterface $entity) {
  if ($entity->getEntityTypeId() !== 'property_backflow_device') {
    return;
  }
  _backflow_device_finalize($entity);
}

/**
 * Assigns the Device ID title and the permanent QR code, then saves once.
 *
 * Guarded so it is a no-op once the title is set and field_qr_code is
 * populated — a defensive belt-and-suspenders in addition to only hooking
 * insert.
 */
/**
 * The stable, clean device code: BF- + zero-padded entity id (BF-NNNNNN).
 *
 * This is the canonical device identifier used on the QR filename, the test
 * report, and the service tag. It never changes and never includes the model.
 * The human-facing TITLE may append the material model (see below), but the
 * code stays clean for documents and filenames.
 */
function _backflow_device_code(ContentEntityInterface $device): string {
  return 'BF-' . str_pad((string) $device->id(), 6, '0', STR_PAD_LEFT);
}

function _backflow_device_finalize(ContentEntityInterface $device) {
  $device_code = _backflow_device_code($device);

  // Title = device code, with the material model appended when one is set at
  // insert (e.g. "BF-000005 - 765 PVB"). Set once on insert; the code portion
  // is always the stable id, so the title stays meaningful even if the model
  // reference is later edited — the title does NOT auto-update (by design).
  $model = '';
  if ($device->hasField('field_material_backflow') && !$device->get('field_material_backflow')->isEmpty()) {
    $material = $device->get('field_material_backflow')->entity;
    if ($material) {
      $model = $material->hasField('field_name') && !$material->get('field_name')->isEmpty()
        ? trim((string) $material->get('field_name')->value)
        : trim((string) $material->label());
    }
  }
  // Fall back to the device TYPE (RP/PVB/DCVA/SVB) when no product model is
  // linked, so the title is never a bare code with no context
  // (e.g. "BF-000006 - Pressure Vacuum Breaker (PVB)").
  if ($model === '' && $device->hasField('field_device_type') && !$device->get('field_device_type')->isEmpty()) {
    $type_term = $device->get('field_device_type')->entity;
    if ($type_term) {
      $model = trim((string) $type_term->label());
    }
  }
  $expected_title = $model !== '' ? $device_code . ' - ' . $model : $device_code;
  $needs_title = $device->label() !== $expected_title;
  $needs_qr = $device->get('field_qr_code')->isEmpty();
  if (!$needs_title && !$needs_qr) {
    return;
  }

  // Re-entrancy guard (the follow-up save below triggers update hooks).
  static $running = [];
  $id = $device->id();
  if (!empty($running[$id])) {
    return;
  }
  $running[$id] = TRUE;

  try {
    if ($needs_title) {
      $device->set('title', $expected_title);
    }

    if ($needs_qr) {
      try {
        $file = _backflow_device_generate_qr($device, $device_code);
        if ($file) {
          $device->set('field_qr_code', [
            'target_id' => $file->id(),
            'alt' => 'QR code for ' . $device_code,
          ]);
        }
      }
      catch (\Throwable $e) {
        // Never block device creation on QR failure; log and continue.
        \Drupal::logger('backflow_device')->error('QR generation failed for device @id: @msg', [
          '@id' => $id,
          '@msg' => $e->getMessage(),
        ]);
      }
    }

    // Single follow-up save (the cabb8a6e safe double-save: title set directly,
    // no AEL sentinel token).
    $device->save();

    // Title is now set, so (re)generate the pathauto alias from it.
    if (\Drupal::moduleHandler()->moduleExists('pathauto')) {
      \Drupal::service('pathauto.generator')->updateEntityAlias($device, 'update', ['force' => TRUE]);
    }
  }
  finally {
    unset($running[$id]);
  }
}

/**
 * The device's absolute canonical URL — for the QR and the report PDF link.
 *
 * Canonical route (immutable) — NOT the pathauto alias. The 'alias' => TRUE
 * option suppresses alias substitution so we encode the raw
 * /property_backflow_device/{id} path (Redirect 301s it to the property-path
 * alias). setAbsolute() yields a full https URL scannable/clickable off-site;
 * toString(TRUE) avoids leaked-metadata exceptions in a non-render context.
 *
 * Hardened for non-web contexts (Drush / import / queue): with no HTTP request
 * to resolve the host, setAbsolute() falls back to "http://default/". Detect
 * that and rebuild against the canonical site base — $settings['base_url'] if
 * configured, else the production host constant.
 */
function _backflow_device_canonical_absolute_url(ContentEntityInterface $device): string {
  $url = $device->toUrl('canonical', ['alias' => TRUE])
    ->setAbsolute()
    ->toString(TRUE)
    ->getGeneratedUrl();

  $host = parse_url($url, PHP_URL_HOST);
  if ($host === FALSE || $host === NULL || $host === '' || $host === 'default') {
    $base = rtrim((string) (Settings::get('base_url') ?: BACKFLOW_DEVICE_CANONICAL_BASE_URL), '/');
    $path = $device->toUrl('canonical', ['alias' => TRUE])->toString(TRUE)->getGeneratedUrl();
    $url = $base . '/' . ltrim($path, '/');
  }
  return $url;
}

/**
 * Builds a PNG QR of the device's absolute canonical URL and saves it.
 *
 * @return \Drupal\file\FileInterface|null
 *   The managed file, or NULL on failure.
 */
function _backflow_device_generate_qr(ContentEntityInterface $device, string $title) {
  $url = _backflow_device_canonical_absolute_url($device);

  $result = (new Builder(
    writer: new PngWriter(),
    data: $url,
    encoding: new Encoding('UTF-8'),
    errorCorrectionLevel: ErrorCorrectionLevel::High,
    size: 300,
    margin: 10,
  ))->build();
  $png = $result->getString();

  $directory = 'public://property_backflow_device/device/qr';
  \Drupal::service('file_system')->prepareDirectory(
    $directory,
    FileSystemInterface::CREATE_DIRECTORY | FileSystemInterface::MODIFY_PERMISSIONS
  );
  $uri = $directory . '/qr-' . $title . '.png';

  return \Drupal::service('file.repository')->writeData($png, $uri, FileExists::Replace);
}

/**
 * Implements hook_entity_view().
 *
 * On the public "full" view mode, replace the field_property entity-reference
 * label (which is access-filtered for anonymous) with a pull-through street
 * address read directly from the referenced property by code. This exposes
 * ONLY street + city/zip + a maintained-by line — no owner, contact, gate
 * code, notes, or link — and does not change properties entity access.
 */
function backflow_device_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode) {
  // Material (backflow) product page: surface a link to the canonical type hub
  // page (the taxonomy_term for RP/PVB/DCVA/SVB), which is the SINGLE source of
  // the "how it's tested" content — no per-product procedure text (that would be
  // duplicate content). Rendered just under the product Description.
  if ($entity->getEntityTypeId() === 'material'
      && $entity->bundle() === 'backflow'
      && in_array($view_mode, ['default', 'full'], TRUE)
      && $entity->hasField('field_backflow_type')
      && !$entity->get('field_backflow_type')->isEmpty()
      && ($type_term = $entity->get('field_backflow_type')->entity)) {
    $desc_weight = $display->getComponent('field_description')['weight'] ?? 0;
    $build['backflow_type_hub'] = [
      '#type' => 'link',
      '#title' => $type_term->label() . ' — Testing & Certification',
      '#url' => $type_term->toUrl(),
      '#prefix' => '<div class="material-backflow-type-hub">',
      '#suffix' => '</div>',
      '#weight' => $desc_weight + 1,
      '#cache' => ['tags' => $type_term->getCacheTags()],
      '#attached' => ['library' => ['backflow_device/backflow_cards']],
    ];
    return;
  }

  // Backflow-testing WO page additions.
  if ($entity->getEntityTypeId() === 'work_order'
      && $entity->bundle() === 'backflow_testing'
      && in_array($view_mode, ['default', 'full'], TRUE)) {

    // Audience-aware link to the canonical type hub page, rendered ABOVE the
    // Backflow Tests field group (group weight 5; this sits at 4.5). The device
    // type is reached through the WO's child tests (one device type per WO).
    // Testers get the "testing procedure" framing (professional description);
    // clients/anon get the public "testing & certification" framing. One link,
    // not per-card — the per-card link was retired in favor of this.
    if ($type_term = _backflow_device_wo_type_term($entity)) {
      $internal_roles = ['teammates', 'supervisor', 'administration', 'site_assistant', 'site_admin', 'administrator'];
      $is_internal = (bool) array_intersect($internal_roles, \Drupal::currentUser()->getRoles());
      $build['backflow_procedure_link'] = [
        '#type' => 'link',
        '#title' => Markup::create(_backflow_device_type_hub_label($type_term, $is_internal) . ' &rarr;'),
        '#url' => $type_term->toUrl(),
        '#prefix' => '<div class="bf-card-typelink bf-wo-procedure-link">',
        '#suffix' => '</div>',
        '#weight' => 4.5,
        '#cache' => ['contexts' => ['user.roles'], 'tags' => $type_term->getCacheTags()],
        '#attached' => ['library' => ['backflow_device/backflow_cards']],
      ];
    }

    // "Enter Test Results" — creates ANOTHER backflow test on this WO (e.g. a
    // before- and after-repair test) and opens its readings form. Nested INTO
    // the Backflow Tests group (see backflow_device_entity_view_alter) so it
    // renders inside the group's bordered container; weight 100 places it below
    // the test cards. Per-test editing is the clickable cards in the EVA.
    if (\Drupal::currentUser()->hasPermission('create wo_tasks_list entities of bundle backflow_testing')) {
      $build['backflow_add_test'] = [
        '#type' => 'link',
        '#title' => 'Enter Test Results',
        '#url' => Url::fromRoute('backflow_device.add_test', ['work_order' => $entity->id()]),
        '#attributes' => [
          'style' => 'display:inline-block;background:#2E7D32;color:#fff;font-weight:bold;text-decoration:none;padding:8px 16px;border-radius:4px;font-family:Calibri,Arial,sans-serif;margin:0.75rem 0 0.25rem;',
        ],
        '#weight' => 100,
        '#cache' => ['contexts' => ['user.permissions']],
      ];
    }
    return;
  }

  if ($entity->getEntityTypeId() !== 'property_backflow_device' || $view_mode !== 'full') {
    return;
  }

  // Remove the property reference label render (kept on admin/default displays).
  unset($build['field_property']);

  $lines = [];
  $property = $entity->get('field_property')->entity;
  if ($property instanceof ContentEntityInterface) {
    $street = $property->hasField('field_street_address')
      ? trim((string) $property->get('field_street_address')->value) : '';
    if ($street !== '') {
      $lines[] = $street;
    }

    $city = '';
    $zip = '';
    if ($property->hasField('field_zipcode_reference') && !$property->get('field_zipcode_reference')->isEmpty()) {
      $zipcode = $property->get('field_zipcode_reference')->entity;
      if ($zipcode instanceof ContentEntityInterface) {
        if ($zipcode->hasField('field_zipcode')) {
          $zip = trim((string) $zipcode->get('field_zipcode')->value);
        }
        if ($zipcode->hasField('field_city') && !$zipcode->get('field_city')->isEmpty()) {
          $city_entity = $zipcode->get('field_city')->entity;
          if ($city_entity) {
            $city = (string) $city_entity->label();
          }
        }
      }
    }
    $city_zip = trim($city . (($city !== '' && $zip !== '') ? ', ' : ' ') . $zip);
    if ($city_zip !== '') {
      $lines[] = $city_zip;
    }
  }

  $address = [];
  foreach ($lines as $delta => $line) {
    $address['line_' . $delta] = [
      '#type' => 'html_tag',
      '#tag' => 'div',
      '#attributes' => ['class' => ['backflow-device-location__line']],
      '#value' => $line,
    ];
  }

  $build['backflow_public_address'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['backflow-device-location']],
    // Render above the configured device fields (Current Status is weight 0
    // on the full view display) so the location/address leads the page.
    '#weight' => -10,
    'heading' => [
      '#type' => 'html_tag',
      '#tag' => 'h3',
      '#value' => t('Device Location'),
    ],
    'address' => $address,
    'maintained_by' => [
      '#type' => 'html_tag',
      '#tag' => 'p',
      '#attributes' => ['class' => ['backflow-device-location__maintained-by']],
      '#value' => t('Maintained by Brookstone Outdoors'),
    ],
  ];

  // Pull-through: invalidate when the referenced property changes so a later
  // address correction shows the current value.
  if ($property instanceof ContentEntityInterface) {
    $build['backflow_public_address']['#cache']['tags'] = $property->getCacheTags();
  }

  // "+ Add Test Work Order" button below the test-history EVAs (weights 11/12).
  // Rendered as a render-array link, not a Views text area, so the CSRF-guarded
  // route gets a cache-safe token placeholder via RouteProcessorCsrf. The
  // device id is always available here, so the button works even when the
  // device has no tests yet. Shown only to users who can create both entities
  // (the route enforces the same), and only when the device has a property.
  $account = \Drupal::currentUser();
  if ($property instanceof ContentEntityInterface
      && $account->hasPermission('create work_order entities of bundle backflow_testing')
      && $account->hasPermission('create wo_tasks_list entities of bundle backflow_testing')) {
    $build['backflow_add_test_wo'] = [
      '#type' => 'link',
      '#title' => 'Enter Test Results',
      '#url' => Url::fromRoute('backflow_device.new_test_wo', ['property_backflow_device' => $entity->id()]),
      '#attributes' => [
        'style' => 'display:inline-block;background:#2E7D32;color:#fff;font-weight:bold;text-decoration:none;padding:8px 16px;border-radius:4px;font-family:Calibri,Arial,sans-serif;',
      ],
      '#weight' => 13,
      '#cache' => ['contexts' => ['user.permissions']],
    ];
  }
}

/**
 * Implements hook_preprocess_HOOK() for eck_entity.
 *
 * Nest the "Enter Test Results" button INTO the Backflow Tests field group so
 * it renders inside the group's bordered container (below the test cards),
 * instead of after the group. work_order is an ECK entity, so field_group does
 * its group nesting in a preprocess appended to the eck_entity theme (see
 * field_group_theme_registry_alter) that reads #group_children. This normal
 * preprocess runs BEFORE that appended one, so registering the button as a
 * child of group_backflow_tests here makes field_group move it into the group.
 */
function backflow_device_preprocess_eck_entity(array &$variables) {
  $entity = $variables['elements']['#eck_entity'] ?? NULL;
  if ($entity instanceof ContentEntityInterface
      && $entity->getEntityTypeId() === 'work_order'
      && $entity->bundle() === 'backflow_testing'
      && isset($variables['elements']['backflow_add_test'])
      && isset($variables['elements']['#fieldgroups']['group_backflow_tests'])) {
    $variables['elements']['#group_children']['backflow_add_test'] = 'group_backflow_tests';
  }
}

/**
 * Audience-aware label for the canonical type-hub link. Testers get the
 * professional "testing procedure" framing; everyone else the public framing.
 */
function _backflow_device_type_hub_label(ContentEntityInterface $type_term, bool $is_internal): string {
  return $is_internal
    ? 'View ' . $type_term->label() . ' testing procedure'
    : $type_term->label() . ' — backflow testing & certification';
}

/**
 * Finds the device type term for a backflow-testing WO via its child tests
 * (wo_tasks_list:backflow_testing -> field_backflow_device -> field_device_type).
 * Returns the first resolvable type term, or NULL. One device type per WO.
 */
function _backflow_device_wo_type_term(ContentEntityInterface $work_order) {
  $ids = \Drupal::entityQuery('wo_tasks_list')
    ->accessCheck(FALSE)
    ->condition('type', 'backflow_testing')
    ->condition('field_work_order', $work_order->id())
    ->sort('id', 'ASC')
    ->execute();
  if (!$ids) {
    return NULL;
  }
  $tests = \Drupal::entityTypeManager()->getStorage('wo_tasks_list')->loadMultiple($ids);
  foreach ($tests as $test) {
    if ($test->hasField('field_backflow_device')
        && !$test->get('field_backflow_device')->isEmpty()
        && ($device = $test->get('field_backflow_device')->entity)
        && $device->hasField('field_device_type')
        && !$device->get('field_device_type')->isEmpty()
        && ($term = $device->get('field_device_type')->entity)) {
      return $term;
    }
  }
  return NULL;
}

/**
 * Implements hook_views_pre_render().
 *
 * Attaches the status-card CSS to the Property Devices EVA (mirrors the way
 * bos_spray_route_ui attaches spray-route.css to its route views).
 */
function backflow_device_views_pre_render($view) {
  if ($view->id() === 'backflow_property_devices_eva'
      || ($view->id() === 'wo_tasks_list' && $view->current_display === 'entity_view_5')) {
    $view->element['#attached']['library'][] = 'backflow_device/backflow_cards';
  }
}

/**
 * Implements hook_preprocess_HOOK() for views_view_fields.
 *
 * Computes the status-card data for each Property Devices EVA row from the
 * device entity, so the row template (views-view-fields--backflow-property-
 * devices-eva.html.twig) can render a card. Status + Next-Due logic live
 * here (PHP), keyed on the status MACHINE value.
 */
function backflow_device_preprocess_views_view_fields(array &$variables) {
  $view = $variables['view'];
  // Backflow Tests EVA on the WO page: one clickable test card per child.
  if (($view->id() ?? '') === 'wo_tasks_list' && ($view->current_display ?? '') === 'entity_view_5') {
    _backflow_device_test_card($variables);
    return;
  }
  if (($view->id() ?? '') !== 'backflow_property_devices_eva') {
    return;
  }
  $device = $variables['row']->_entity ?? NULL;
  if (!$device instanceof ContentEntityInterface || $device->getEntityTypeId() !== 'property_backflow_device') {
    return;
  }

  $status = (string) ($device->get('field_current_status')->value ?? '');

  // Device type label.
  $device_type = '';
  if ($device->hasField('field_device_type') && !$device->get('field_device_type')->isEmpty()
      && ($term = $device->get('field_device_type')->entity)) {
    $device_type = (string) $term->label();
  }

  // Last test: stored UTC datetime -> site TZ, date only (BOS MM/DD/YYYY).
  $last_test = '';
  if ($device->hasField('field_last_test_date') && !$device->get('field_last_test_date')->isEmpty()) {
    try {
      $dt = new \DateTime((string) $device->get('field_last_test_date')->value, new \DateTimeZone('UTC'));
      $dt->setTimezone(new \DateTimeZone(date_default_timezone_get()));
      $last_test = $dt->format('m/d/Y');
    }
    catch (\Exception $e) {
      // Leave blank on a malformed stored value.
    }
  }

  $location = $device->hasField('field_physical_location')
    ? trim((string) $device->get('field_physical_location')->value) : '';

  $next_due = ($device->hasField('field_next_due_date') && !$device->get('field_next_due_date')->isEmpty())
    ? (string) $device->get('field_next_due_date')->value : '';

  $variables['bf_card'] = [
    'status' => $status,
    'status_label' => _backflow_device_status_label($status),
    'code' => _backflow_device_code($device),
    'url' => $device->toUrl()->toString(TRUE)->getGeneratedUrl(),
    'device_type' => $device_type,
    'last_test' => $last_test,
    'location' => $location,
  ] + _backflow_device_next_due_meta($next_due, $status);
}

/**
 * Human label for a field_current_status machine value (stable map).
 */
function _backflow_device_status_label(string $value): string {
  $map = [
    'active' => 'Active',
    'failed' => 'Failed',
    'repaired' => 'Repaired',
    'out_of_service' => 'Out of Service',
    'replaced' => 'Replaced',
  ];
  return $map[$value] ?? ucwords(str_replace('_', ' ', $value));
}

/**
 * Next-Due treatment for the card. Coloring applies ONLY when status is
 * active — a failed device reads via its red FAILED badge, never as an
 * "overdue date" (no double-signal). Returns nextdue_class/label/date.
 *
 * Date math: PHP DateTime in the site timezone, date-only comparison
 * (consistent with the date-only next-due field + the write-back).
 */
function _backflow_device_next_due_meta(string $next_due, string $status): array {
  // Non-active statuses: the badge is the signal. Show a muted date if any.
  if ($status !== 'active') {
    if ($next_due === '') {
      return ['nextdue_class' => 'muted', 'nextdue_label' => '', 'nextdue_date' => ''];
    }
    return ['nextdue_class' => 'muted', 'nextdue_label' => 'Next due', 'nextdue_date' => _backflow_device_fmt_due($next_due)];
  }

  // Active + no date on record -> amber "No test on record" (the BF-000002 case).
  if ($next_due === '') {
    return ['nextdue_class' => 'soon', 'nextdue_label' => 'No test on record', 'nextdue_date' => ''];
  }

  $tz = new \DateTimeZone(date_default_timezone_get());
  $today = new \DateTime('now', $tz);
  $today->setTime(0, 0, 0);
  $due = \DateTime::createFromFormat('Y-m-d', $next_due, $tz);
  if (!$due) {
    return ['nextdue_class' => 'soon', 'nextdue_label' => 'No test on record', 'nextdue_date' => ''];
  }
  $due->setTime(0, 0, 0);
  $days = (int) $today->diff($due)->format('%r%a');
  $date_str = $due->format('m/d/Y');

  if ($days < 0) {
    return ['nextdue_class' => 'overdue', 'nextdue_label' => 'Overdue', 'nextdue_date' => $date_str];
  }
  if ($days <= 60) {
    return ['nextdue_class' => 'soon', 'nextdue_label' => 'Due soon', 'nextdue_date' => $date_str];
  }
  return ['nextdue_class' => 'ok', 'nextdue_label' => 'Next due', 'nextdue_date' => $date_str];
}

/**
 * Format a date-only (Y-m-d) next-due value as MM/DD/YYYY.
 */
function _backflow_device_fmt_due(string $next_due): string {
  $tz = new \DateTimeZone(date_default_timezone_get());
  $d = \DateTime::createFromFormat('Y-m-d', $next_due, $tz);
  return $d ? $d->format('m/d/Y') : '';
}

/**
 * Human label for a field_pass_fail value.
 */
function _backflow_device_result_label(string $value): string {
  $map = ['pass' => 'Pass', 'fail' => 'Fail'];
  return $map[$value] ?? ($value !== '' ? ucfirst($value) : 'Pending');
}

/**
 * Builds the test-card data for one wo_tasks_list:backflow_testing row on the
 * WO's Backflow Tests EVA. The whole card links to the test's canonical view
 * page (the test-results display); editors reach the readings form via the Edit
 * tab there. Shows the result, test date, and tester + certification — not the
 * WO title or the creator. When a report PDF has been generated it is offered as
 * a view/download link below the card (for sending to a customer).
 */
function _backflow_device_test_card(array &$variables) {
  $test = $variables['row']->_entity ?? NULL;
  if (!$test instanceof ContentEntityInterface
      || $test->getEntityTypeId() !== 'wo_tasks_list'
      || $test->bundle() !== 'backflow_testing') {
    return;
  }

  $result = (string) ($test->get('field_pass_fail')->value ?? '');

  // Test date: stored UTC -> site TZ, MM/DD/YYYY h:i A.
  $test_date = '';
  if (!$test->get('field_test_date')->isEmpty()) {
    try {
      $dt = new \DateTime((string) $test->get('field_test_date')->value, new \DateTimeZone('UTC'));
      $dt->setTimezone(new \DateTimeZone(date_default_timezone_get()));
      $test_date = $dt->format('m/d/Y g:i A');
    }
    catch (\Exception $e) {
      // Leave blank on a malformed stored value.
    }
  }

  $tester = '';
  if (!$test->get('field_tester')->isEmpty() && ($u = $test->get('field_tester')->entity)) {
    $tester = (string) $u->getDisplayName();
  }
  $cert = trim((string) ($test->get('field_certification_number')->value ?? ''));
  $initial = !$test->get('field_is_initial_test')->isEmpty() && (bool) $test->get('field_is_initial_test')->value;

  // Readings entered (non-empty = applicable to the device type), with their
  // configured field labels — shown on the card even for a failed test.
  $defs = \Drupal::service('entity_field.manager')->getFieldDefinitions('wo_tasks_list', 'backflow_testing');
  $readings = [];
  foreach (['field_line_pressure_psi', 'field_check_valve_1_psid', 'field_check_valve_2_psid', 'field_relief_valve_psid', 'field_air_inlet_psid', 'field_check_valve_psid'] as $rf) {
    if ($test->hasField($rf) && !$test->get($rf)->isEmpty()) {
      $readings[] = [
        'label' => (string) $defs[$rf]->getLabel(),
        'value' => (string) $test->get($rf)->value,
      ];
    }
  }

  // Repairs recommended (plain text for the card).
  $repairs = '';
  if ($test->hasField('field_repairs_recommended') && !$test->get('field_repairs_recommended')->isEmpty()) {
    $repairs = trim(strip_tags((string) $test->get('field_repairs_recommended')->value));
  }

  // "Has data" drives the title fallback when no test date is set, so a
  // filled-but-undated test is not mislabeled "no readings yet".
  $has_data = $result !== '' || $tester !== '' || $cert !== '' || !empty($readings) || $repairs !== '';

  // Report PDF (generated + frozen on completion): offer view/download below the
  // card so a team member can pull it up or send it to a customer. Rendered as a
  // link OUTSIDE the card anchor (no nested <a>).
  $pdf_url = '';
  if ($test->hasField('field_report_pdf') && !$test->get('field_report_pdf')->isEmpty()
      && ($pdf = $test->get('field_report_pdf')->entity)) {
    $pdf_url = $pdf->createFileUrl(FALSE);
  }

  // The audience-aware type-hub link now renders ONCE above the Backflow Tests
  // group (backflow_device_entity_view), not per card.
  $variables['bf_test_card'] = [
    'result' => $result !== '' ? $result : 'pending',
    'result_label' => _backflow_device_result_label($result),
    'test_date' => $test_date,
    'tester' => $tester,
    'cert' => $cert,
    'initial' => $initial,
    'readings' => $readings,
    'repairs' => $repairs,
    'has_data' => $has_data,
    // Whole card -> the test-results view page (canonical); Edit tab there for editors.
    'url' => $test->toUrl('canonical')->toString(),
    'pdf_url' => $pdf_url,
  ];
}

/**
 * Implements hook_theme().
 *
 * Registers the Property Devices EVA row suggestion so this module's
 * templates/views-view-fields--backflow-property-devices-eva.html.twig is
 * discovered. A module template that overrides another module's theme hook
 * (views_view_fields) is not auto-scanned unless the suggestion hook is
 * registered with a base hook.
 */
function backflow_device_theme($existing, $type, $theme, $path) {
  return [
    'views_view_fields__backflow_property_devices_eva' => [
      'base hook' => 'views_view_fields',
    ],
    'views_view_fields__wo_tasks_list__entity_view_5' => [
      'base hook' => 'views_view_fields',
    ],
  ];
}

/**
 * Implements hook_token_info().
 *
 * Exposes [property_backflow_device:bf_number] — the stable zero-padded device
 * code (BF-NNNNNN) — so pathauto can build a clean URL segment from it without
 * the device model/description. Reuses _backflow_device_code() (single source of
 * truth for the padding format).
 */
function backflow_device_token_info() {
  return [
    'tokens' => [
      'property_backflow_device' => [
        'bf_number' => [
          'name' => t('BF number'),
          'description' => t('Stable zero-padded device code, e.g. BF-000027 (clean URL segment; pathauto lower-cases it to bf-000027).'),
        ],
      ],
    ],
  ];
}

/**
 * Implements hook_tokens().
 */
function backflow_device_tokens($type, $tokens, array $data, array $options, \Drupal\Core\Render\BubbleableMetadata $bubbleable_metadata) {
  $replacements = [];
  if ($type === 'property_backflow_device' && !empty($data['property_backflow_device'])) {
    $device = $data['property_backflow_device'];
    foreach ($tokens as $name => $original) {
      if ($name === 'bf_number' && $device instanceof \Drupal\Core\Entity\ContentEntityInterface) {
        $replacements[$original] = _backflow_device_code($device);
      }
    }
  }
  return $replacements;
}
