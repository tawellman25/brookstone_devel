{#
  A visitor who found an internal URL. No apology, no error language — just the
  work and the ways to reach us. Photos come from real published services, so
  this stays current without anyone maintaining it.
#}
<div class="bos-403 bos-403--public">
  <h2 class="bos-403__head">That one's behind the gate</h2>
  <p class="bos-403__lead">
    You've found a page our crews use to run the day's work. There's nothing for
    you back there — but there's plenty out front.
  </p>

  {% if services %}
    <ul class="bos-403__cards">
      {% for service in services %}
        <li class="bos-403__card">
          <a href="{{ service.url }}">
            <span class="bos-403__card-img">{{ service.image }}</span>
            <span class="bos-403__card-title">{{ service.title }}</span>
          </a>
        </li>
      {% endfor %}
    </ul>
  {% endif %}

  <p class="bos-403__actions">
    <a href="{{ services_url }}" class="bos-403__btn bos-403__btn--primary">See what we do</a>
    <a href="{{ home_url }}" class="bos-403__btn">Home</a>
  </p>

  <p class="bos-403__meta">
    Work here? <a href="{{ login_url }}">Sign in</a>.
  </p>
</div>
