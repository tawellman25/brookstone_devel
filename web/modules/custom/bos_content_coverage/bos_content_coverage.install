<?php

/**
 * @file
 * Install hooks for the content coverage report.
 */

declare(strict_types=1);

/**
 * Implements hook_install().
 *
 * Grants the report to the office/admin roles. Anonymous and client roles are
 * deliberately not granted — it is an internal tool.
 */
function bos_content_coverage_install(): void {
  $roles = ['administration', 'supervisor', 'site_assistant', 'site_admin', 'administrator'];
  foreach ($roles as $rid) {
    $role = \Drupal::entityTypeManager()->getStorage('user_role')->load($rid);
    if ($role) {
      $role->grantPermission('view content coverage report')->save();
    }
  }
}
