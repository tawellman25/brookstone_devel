<?php

/**
 * @file
 * Content coverage report — what public copy is actually live.
 */

declare(strict_types=1);

/**
 * Implements hook_views_data_alter().
 *
 * Registers the computed column and the question filter against the taxonomy
 * term base table. A handler plugin comes from views DATA, not from a plugin_id
 * in a view's config, so this is the only place it can be declared.
 */
function bos_content_coverage_views_data_alter(array &$data): void {
  $data['taxonomy_term_field_data']['bos_coverage_column'] = [
    'title' => t('Content coverage column'),
    'help' => t('Live URL alias, parent, boilerplate flag, or the state of one copy role.'),
    'field' => [
      'id' => 'bos_coverage_column',
      'click sortable' => FALSE,
    ],
  ];
  $data['taxonomy_term_field_data']['bos_coverage_question'] = [
    'title' => t('Content coverage question'),
    'help' => t('Carries boilerplate / missing public description / missing teaser.'),
    'filter' => [
      'id' => 'bos_coverage_question',
    ],
  ];
}

/**
 * Implements hook_ENTITY_TYPE_presave() for entity_view_display.
 *
 * THE RULE, ENFORCED RATHER THAN DOCUMENTED.
 *
 * field_short_description is the text a PARENT term's list or card shows about
 * this term. It is never part of the term's own rendered page. A term page shows
 * its public description; the teaser is what the level above says about it.
 *
 * This hook exists because the rule was broken twice in one day — once by the
 * original site build, and once by me, on 2026-10-03, when marketing's brief
 * said "unhide it" and I followed the brief instead of the model. A rule written
 * in a document does not survive that, because the brief is what gets read last.
 * So the model refuses the change instead: adding the teaser to any taxonomy
 * term view display is undone here, with a warning naming the display.
 *
 * Views are unaffected — a Views field is not an entity view display, and views
 * are the consumer this field exists for.
 *
 * To render body copy on a term page, use field_public_description. If a
 * vocabulary genuinely has no body, write one; do not promote the teaser.
 */
function bos_content_coverage_entity_view_display_presave(\Drupal\Core\Entity\EntityInterface $display): void {
  /** @var \Drupal\Core\Entity\Entity\EntityViewDisplay $display */
  if ($display->getTargetEntityTypeId() !== 'taxonomy_term') {
    return;
  }
  if (!$display->getComponent('field_short_description')) {
    return;
  }
  $display->removeComponent('field_short_description');
  \Drupal::logger('bos_content_coverage')->warning(
    'Removed field_short_description from the %display view display. That field is the text a PARENT term\'s list or card shows about this term, and it is never rendered on the term\'s own page — use field_public_description for body copy. See Governance/ui_patterns.md.',
    ['%display' => $display->id()]
  );
}
