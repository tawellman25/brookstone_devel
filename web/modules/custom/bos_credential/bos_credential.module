<?php

/**
 * @file
 * Credential entity behaviour — title, scope validation, field access.
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityStorageException;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;

/** Roles that may see every gated field. */
const BOS_CREDENTIAL_OFFICE_ROLES = [
  'administration',
  'supervisor',
  'site_assistant',
  'site_admin',
  'administrator',
];

/** Fields only office/admin may ever view. */
const BOS_CREDENTIAL_OFFICE_ONLY_FIELDS = [
  'field_credential_documents',
  'field_internal_notes',
  'field_renewal_contact',
  'field_renewal_url',
];

/**
 * Is this account in the office/admin tier?
 */
function _bos_credential_is_office(AccountInterface $account): bool {
  return (bool) array_intersect(BOS_CREDENTIAL_OFFICE_ROLES, $account->getRoles());
}

/**
 * Does the credential's TYPE permit its number to be shown outside the office?
 *
 * The disclosure rule lives on the type, not the record, so nobody can publish a
 * policy number by ticking the wrong box once: license numbers are public record,
 * insurance policy numbers are not.
 */
function _bos_credential_number_is_public(EntityInterface $credential): bool {
  if (!$credential->hasField('field_credential_type')) {
    return FALSE;
  }
  $term = $credential->get('field_credential_type')->entity;
  if (!$term || !$term->hasField('field_number_is_public')) {
    return FALSE;
  }
  return (bool) $term->get('field_number_is_public')->value;
}

/**
 * Implements hook_entity_field_access().
 *
 * VIEW op only — edit/forms are governed by the entity permissions. Field access
 * (not view-mode hiding) is the mechanism because it holds everywhere: Views,
 * search, and JSON:API, which is enabled on this site and exposes every content
 * entity type automatically. Mirrors material_entity_field_access().
 */
function bos_credential_entity_field_access($operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL) {
  if ($operation !== 'view' || $field_definition->getTargetEntityTypeId() !== 'credential') {
    return AccessResult::neutral();
  }

  $name = $field_definition->getName();
  $office = _bos_credential_is_office($account);

  // Office-only fields: flat deny for everyone else.
  if (in_array($name, BOS_CREDENTIAL_OFFICE_ONLY_FIELDS, TRUE)) {
    return AccessResult::forbiddenIf(!$office)->addCacheContexts(['user.roles']);
  }

  // The credential number is the conditional one.
  if ($name === 'field_credential_number') {
    if ($office) {
      return AccessResult::allowed()->addCacheContexts(['user.roles']);
    }
    // Without the entity in hand we cannot evaluate the type — fail CLOSED.
    $credential = $items ? $items->getEntity() : NULL;
    if (!$credential) {
      return AccessResult::forbidden()->addCacheContexts(['user.roles']);
    }

    $result = AccessResult::neutral()->addCacheContexts(['user.roles'])
      ->addCacheableDependency($credential);
    $term = $credential->hasField('field_credential_type') ? $credential->get('field_credential_type')->entity : NULL;
    if ($term) {
      $result->addCacheableDependency($term);
    }

    if (!_bos_credential_number_is_public($credential)) {
      // Insurance policy numbers and CDLs: office only.
      return $result->andIf(AccessResult::forbidden());
    }

    // A teammate may see a license/cert number — this is what lets a tech pull
    // up an applicator card at a customer's door.
    if (in_array('teammates', $account->getRoles(), TRUE)) {
      return $result->andIf(AccessResult::allowed());
    }

    // Everyone else (anonymous, clients) additionally needs the record flagged
    // publishable.
    $published = $credential->hasField('field_publish_publicly')
      && (bool) $credential->get('field_publish_publicly')->value;
    return $result->andIf(AccessResult::forbiddenIf(!$published));
  }

  return AccessResult::neutral();
}

/**
 * Implements hook_ENTITY_TYPE_presave() for credential.
 *
 * Sets the title and enforces the scope rule. The presave guard is the backstop
 * that holds on every path — REST, VBO, programmatic — not just the form.
 */
function bos_credential_credential_presave(EntityInterface $credential) {
  _bos_credential_assert_scope($credential);

  // Title: "{type} — {holder}". System-set, following the device-ID pattern
  // rather than leaving it to typing.
  $type = $credential->hasField('field_credential_type') ? $credential->get('field_credential_type')->entity : NULL;
  $typeLabel = $type ? $type->label() : 'Credential';

  $holder = NULL;
  $scope = $credential->hasField('field_scope') ? (string) $credential->get('field_scope')->value : '';
  if ($scope === 'teammate') {
    $user = $credential->hasField('field_teammate') ? $credential->get('field_teammate')->entity : NULL;
    $holder = $user ? $user->getDisplayName() : NULL;
  }
  else {
    $authority = $credential->hasField('field_issuing_authority')
      ? trim((string) $credential->get('field_issuing_authority')->value)
      : '';
    $holder = $authority !== '' ? $authority : 'Company';
  }

  $title = $holder ? ($typeLabel . ' — ' . $holder) : $typeLabel;
  if (trim((string) $credential->label()) === '' || $credential->isNew() || $credential->get('title')->value !== $title) {
    $credential->set('title', $title);
  }
}

/**
 * The scope rule: stated, never inferred. Validate BOTH directions and fail the
 * save — do not silently correct.
 */
function _bos_credential_assert_scope(EntityInterface $credential): void {
  if (!$credential->hasField('field_scope') || !$credential->hasField('field_teammate')) {
    return;
  }
  $scope = (string) $credential->get('field_scope')->value;
  $hasTeammate = !$credential->get('field_teammate')->isEmpty();

  if ($scope === 'teammate' && !$hasTeammate) {
    throw new EntityStorageException('Scope is "Individual teammate" but no teammate is set. Choose the teammate, or set scope to Company-wide.');
  }
  if ($scope === 'company' && $hasTeammate) {
    throw new EntityStorageException('Scope is "Company-wide" but a teammate is set. Clear the teammate, or set scope to Individual teammate.');
  }
  if ($scope === '') {
    throw new EntityStorageException('Scope is required — choose Company-wide or Individual teammate.');
  }
}

/**
 * Implements hook_form_alter().
 *
 * Surfaces the scope rule as a clean inline error instead of the presave
 * exception's WSOD. The presave guard stays as the non-form backstop.
 */
function bos_credential_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  if (!str_starts_with($form_id, 'credential_') || !str_contains($form_id, '_form')) {
    return;
  }
  $form['#validate'][] = '_bos_credential_form_validate_scope';
}

/**
 * Form-layer mirror of the scope rule.
 */
function _bos_credential_form_validate_scope(array &$form, FormStateInterface $form_state) {
  $scope = $form_state->getValue(['field_scope', 0, 'value']);
  $teammate = $form_state->getValue(['field_teammate', 0, 'target_id']);

  if ($scope === 'teammate' && empty($teammate)) {
    $form_state->setErrorByName('field_teammate', t('Scope is "Individual teammate" — choose the teammate who holds this credential, or set scope to Company-wide.'));
  }
  if ($scope === 'company' && !empty($teammate)) {
    $form_state->setErrorByName('field_teammate', t('Scope is "Company-wide" — clear the teammate, or set scope to Individual teammate.'));
  }
}
