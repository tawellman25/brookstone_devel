<?php

/**
 * @file
 * BOS Homepage — front page bands, sitewide phone, LocalBusiness JSON-LD.
 */

/**
 * Implements hook_theme().
 */
function bos_homepage_theme($existing, $type, $theme, $path): array {
  return [
    'bos_homepage' => [
      'variables' => ['data' => []],
      'template' => 'bos-homepage',
    ],
  ];
}

/**
 * TRUE on the front page route.
 */
function _bos_homepage_is_front(): bool {
  return \Drupal::routeMatch()->getRouteName() === 'bos_homepage.front';
}

/**
 * Builds the homepage bands render array (theme bos_homepage). Used by both the
 * controller and hook_preprocess_page so the page--front template can render the
 * bands directly, outside Olivero's constrained content region.
 */
function _bos_homepage_render_array(): array {
  $cfg = \Drupal::config('bos_homepage.settings');
  $base = '/' . \Drupal::service('extension.list.module')->getPath('bos_homepage');

  // Portfolio (Proof band): {fid, town, alt}. Hidden until >= 4 distinct photos.
  $portfolio = [];
  foreach ((array) $cfg->get('portfolio') as $item) {
    if (empty($item['fid'])) {
      continue;
    }
    $file = \Drupal\file\Entity\File::load($item['fid']);
    if (!$file) {
      continue;
    }
    $portfolio[] = [
      'url' => \Drupal::service('file_url_generator')->generateString($file->getFileUri()),
      'town' => $item['town'] ?? '',
      'alt' => $item['alt'] ?? '',
    ];
  }

  $data = $cfg->get();
  $data['hero_image'] = $base . '/assets/home-hero.jpg';
  $data['portfolio'] = (count($portfolio) >= 4) ? $portfolio : [];
  $data['phone'] = (string) \Drupal::config('bos_service_request.settings')->get('office_phone');

  return [
    '#theme' => 'bos_homepage',
    '#data' => $data,
    '#attached' => ['library' => ['bos_homepage/homepage']],
    '#cache' => [
      'tags' => ['config:bos_homepage.settings'],
      'contexts' => ['url'],
    ],
  ];
}

/**
 * Implements hook_preprocess_page().
 *
 * On the front page, hand the bands render array to page--front.html.twig as
 * `bos_home` so it can print them full-width, outside the content region.
 */
function bos_homepage_preprocess_page(array &$variables): void {
  if (_bos_homepage_is_front()) {
    $variables['bos_home'] = _bos_homepage_render_array();
  }
}

/**
 * Implements hook_block_access().
 *
 * Hide the page-title block on the front page so the hero's H1 is the only H1
 * (the route title would otherwise render a second "Home" heading).
 */
function bos_homepage_block_access(\Drupal\block\Entity\Block $block, $operation, \Drupal\Core\Session\AccountInterface $account) {
  // On the front page: hide the page-title block only (the hero H1 is the only
  // H1). The account menu ("Log in") stays so the homepage header matches every
  // other page. Front-page-only; other pages are unchanged.
  $hidden = ['page_title_block'];
  if ($operation === 'view' && in_array($block->getPluginId(), $hidden, TRUE) && _bos_homepage_is_front()) {
    return \Drupal\Core\Access\AccessResult::forbidden()->addCacheContexts(['route.name']);
  }
  return \Drupal\Core\Access\AccessResult::neutral();
}

/**
 * Implements hook_page_attachments().
 *
 * LocalBusiness JSON-LD on the front page only (no schema module in play, so no
 * conflict). Business facts are static; the phone comes from config.
 */
function bos_homepage_page_attachments(array &$attachments) {
  // The /about trust page: Organization JSON-LD (single block) + meta
  // description. Kept here beside the front-page LocalBusiness so the site's
  // structured data lives in one module (see ROADMAP: SEO standardization will
  // later migrate BOTH into schema_metatag). Neither block is emitted on the
  // other's page, so a domain never carries two competing blocks on one page.
  if (_bos_homepage_is_about()) {
    _bos_homepage_about_attachments($attachments);
    return;
  }
  if (!_bos_homepage_is_front()) {
    return;
  }
  $phone = (string) \Drupal::config('bos_service_request.settings')->get('office_phone');
  $ld = [
    '@context' => 'https://schema.org',
    '@type' => 'LocalBusiness',
    'name' => 'Brookstone Outdoors LLC',
    'image' => \Drupal::request()->getSchemeAndHttpHost() . '/' . \Drupal::service('extension.list.module')->getPath('bos_homepage') . '/assets/home-hero.jpg',
    'telephone' => $phone,
    'url' => \Drupal::request()->getSchemeAndHttpHost() . '/',
    'address' => [
      '@type' => 'PostalAddress',
      'streetAddress' => '20143 Austin Rd.',
      'addressLocality' => 'Austin',
      'addressRegion' => 'CO',
      'postalCode' => '81410',
      'addressCountry' => 'US',
    ],
    'areaServed' => ['Cedaredge', 'Delta', 'Montrose', 'Olathe', 'Eckert', 'Paonia', 'Hotchkiss', 'Crawford'],
  ];
  $attachments['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'script',
      '#attributes' => ['type' => 'application/ld+json'],
      '#value' => json_encode($ld, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE),
    ],
    'bos_homepage_localbusiness',
  ];
}

/**
 * TRUE when viewing the /about node (the public trust page).
 *
 * Identifies the page by its path alias rather than a stored nid, so it needs no
 * config coupling and survives a rebuild of the node in any environment.
 */
function _bos_homepage_is_about(): bool {
  if (\Drupal::routeMatch()->getRouteName() !== 'entity.node.canonical') {
    return FALSE;
  }
  $node = \Drupal::routeMatch()->getParameter('node');
  if (!$node || !is_object($node) || $node->bundle() !== 'page') {
    return FALSE;
  }
  try {
    return \Drupal::service('path_alias.manager')
      ->getAliasByPath('/node/' . $node->id()) === '/about';
  }
  catch (\Throwable $e) {
    return FALSE;
  }
}

/**
 * Meta description + Organization JSON-LD for /about. One Organization block,
 * only on this page. foundingDate 1995 is confirmed (same entity changed hands
 * and name the same day); alternateName is the owned S&E Ward's trade name.
 */
function _bos_homepage_about_attachments(array &$attachments): void {
  $host = \Drupal::request()->getSchemeAndHttpHost();
  $phone = (string) \Drupal::config('bos_service_request.settings')->get('office_phone');

  $attachments['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'meta',
      '#attributes' => [
        'name' => 'description',
        'content' => "Founded in 1995 as S&E Ward's. Now owned by two of the people who worked the crews. Landscaping, irrigation and snow across Delta and Montrose counties.",
      ],
    ],
    'bos_homepage_about_description',
  ];

  $ld = [
    '@context' => 'https://schema.org',
    '@type' => 'Organization',
    'name' => 'Brookstone Outdoors',
    'alternateName' => "S&E Ward's",
    'foundingDate' => '1995',
    'founder' => [
      ['@type' => 'Person', 'name' => 'Steve Ward'],
      ['@type' => 'Person', 'name' => 'Eunice Ward'],
    ],
    'telephone' => $phone !== '' ? $phone : '+1-970-835-9661',
    'url' => $host . '/about',
    'logo' => $host . '/' . \Drupal::service('extension.list.module')->getPath('bos_homepage') . '/assets/home-hero.jpg',
    'areaServed' => [
      ['@type' => 'AdministrativeArea', 'name' => 'Delta County, CO'],
      ['@type' => 'AdministrativeArea', 'name' => 'Montrose County, CO'],
    ],
    // 'sameAs' (Facebook Page URL) intentionally omitted until the real URL is
    // supplied — shipping a guessed profile link is worse than none.
  ];
  $attachments['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'script',
      '#attributes' => ['type' => 'application/ld+json'],
      // HEX flags escape & < > ' " as \uXXXX — valid JSON that a parser reads
      // back correctly, and immune to the render layer HTML-escaping the "&" in
      // "S&E Ward's" (which would otherwise emit &amp; into the JSON-LD).
      '#value' => json_encode($ld, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_HEX_AMP | JSON_HEX_TAG | JSON_HEX_QUOT | JSON_HEX_APOS),
    ],
    'bos_homepage_about_organization',
  ];
}

/**
 * Implements hook_preprocess_html().
 *
 * Sets the exact SEO <title> on /about (default would append the site name).
 */
function bos_homepage_preprocess_html(array &$variables): void {
  if (_bos_homepage_is_about()) {
    $variables['head_title'] = ['title' => 'About Brookstone Outdoors | Serving the Valley Since 1995'];
  }
}

/**
 * Implements hook_system_breadcrumb_alter().
 *
 * Core's path-based breadcrumb yields only "Home" on every page (this site adds
 * no current-page crumb). Give the /about subtree a real trail — Home > About
 * ( > child ) — so the page reads correctly and a future /about/credentials
 * child shows its parent instead of skipping it. SCOPED to the /about subtree;
 * every other page keeps the site's existing "Home"-only breadcrumb untouched.
 */
function bos_homepage_system_breadcrumb_alter(\Drupal\Core\Breadcrumb\Breadcrumb &$breadcrumb, \Drupal\Core\Routing\RouteMatchInterface $route_match, array $context) {
  if ($route_match->getRouteName() !== 'entity.node.canonical') {
    return;
  }
  $node = $route_match->getParameter('node');
  if (!$node || !is_object($node) || $node->bundle() !== 'page') {
    return;
  }
  try {
    $alias = \Drupal::service('path_alias.manager')->getAliasByPath('/node/' . $node->id());
  }
  catch (\Throwable $e) {
    return;
  }
  if ($alias !== '/about' && strpos($alias, '/about/') !== 0) {
    return;
  }

  $links = [\Drupal\Core\Link::createFromRoute(t('Home'), '<front>')];
  if ($alias === '/about') {
    // Parent page: Home > About (current, unlinked).
    $links[] = \Drupal\Core\Link::createFromRoute(t('About'), '<none>');
  }
  else {
    // Child of /about (e.g. /about/credentials): Home > About > {title}.
    $links[] = \Drupal\Core\Link::fromTextAndUrl(t('About'), \Drupal\Core\Url::fromUri('internal:/about'));
    $links[] = \Drupal\Core\Link::createFromRoute($node->label(), '<none>');
  }

  $new = new \Drupal\Core\Breadcrumb\Breadcrumb();
  $new->setLinks($links);
  $new->addCacheContexts(['route']);
  $new->addCacheableDependency($node);
  $breadcrumb = $new;
}
