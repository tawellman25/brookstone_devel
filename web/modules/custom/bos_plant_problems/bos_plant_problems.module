<?php

/**
 * @file
 * One URL per plant problem, body by the viewer's role.
 *
 * A plant problem term carries three audiences on one record: the public
 * article (`field_public_description`), the crew training
 * (`field_teammate_description`) and, for office, both. Taxonomy canonical
 * pages render in the `full` view mode for everybody, so without this module
 * the `teammate_view` display exists, holds the training, and is unreachable —
 * which is exactly the state Spruce Needle Drop launched in on 2026-11-03:
 * the crew copy was written, stored, and readable by nobody but an admin.
 *
 * So: office gets admin_view, crew get teammate_view, everyone else gets full.
 * Same shape as bos_services, bos_seasons, bos_spray_types and
 * bos_backflow_types.
 *
 * ⚠ THE CACHE CONTEXT IS NOT OPTIONAL. Routing the view mode is only half the
 * job. Without `user.roles` on the build, the render cache serves whichever
 * audience's body was built first to everyone who follows — so an anonymous
 * visitor who happens to arrive after a logged-in crew member is served the
 * crew training. The routing can be perfectly correct and the page still leak.
 * This is the failure found across all six spray vocabularies on 2026-09-27.
 *
 * ⚠ This is the SIXTH module implementing this identical routing, which
 * `bos_seasons` already flags as worth consolidating into one
 * vocabulary-keyed router. Built as a separate module at Todd's direction
 * (2026-11-03) so the vocabulary's behaviour lives with the vocabulary;
 * consolidating all six remains a separate, behaviour-neutral job.
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\image\Entity\ImageStyle;

/**
 * Vocabularies this module routes.
 */
const BOS_PLANT_PROBLEMS_VIDS = ['plant_problems'];

/**
 * Office roles see everything; checked first.
 */
const BOS_PLANT_PROBLEMS_OFFICE_ROLES = [
  'supervisor',
  'administration',
  'site_assistant',
  'site_admin',
  'administrator',
];

/**
 * Crew roles see the training rather than the public article.
 */
const BOS_PLANT_PROBLEMS_CREW_ROLES = ['teammates'];

/**
 * Roles that do NOT get the hero. EMPTY — everybody gets it.
 *
 * ⚠ DELIBERATE DIVERGENCE from bos_seasons / bos_services / bos_backflow_types
 * (2026-11-03, Todd's call: "Office and crew please"). Those three exclude
 * office AND crew, making the hero public-only. Copying that here carried a
 * cost nobody had named: **the office are the people who review whether the
 * marketing page looks right, and they could only see it by logging out.** You
 * cannot review a page you are never shown.
 *
 * An office-only version was written first and would have failed anyway, for a
 * reason worth recording: **Todd's own account holds `teammates`** alongside
 * administrator and supervisor, so any rule excluding crew would have hidden
 * the hero from him. Role lists in BOS are not tidy tiers — accounts hold
 * several at once, which is why the office-vs-crew checks elsewhere in this
 * file test office FIRST.
 *
 * (bos_geo already shows its hero to everyone, so the rule this departs from
 * was three modules out of four, never universal.) Whether the other three
 * follow is a separate decision Todd is weighing — do NOT sync them to this
 * one without it.
 *
 * Kept as an empty constant rather than deleting the check, so the mechanism
 * and the reasoning stay visible and re-enabling is one edit.
 */
const BOS_PLANT_PROBLEMS_HERO_EXCLUDED_ROLES = [];

/**
 * Implements hook_entity_view_mode_alter().
 */
function bos_plant_problems_entity_view_mode_alter(string &$view_mode, EntityInterface $entity): void {
  if ($entity->getEntityTypeId() !== 'taxonomy_term'
    || !in_array($entity->bundle(), BOS_PLANT_PROBLEMS_VIDS, TRUE)) {
    return;
  }
  // Only the canonical page. A term rendered inside a view or a teaser keeps
  // whatever mode that context asked for.
  if ($view_mode !== 'full' && $view_mode !== 'default') {
    return;
  }
  $roles = \Drupal::currentUser()->getRoles();
  // Office is checked FIRST: an administrator who also holds the teammates
  // role should get the admin view, not the crew one.
  if (array_intersect(BOS_PLANT_PROBLEMS_OFFICE_ROLES, $roles)) {
    $view_mode = 'admin_view';
  }
  elseif (array_intersect(BOS_PLANT_PROBLEMS_CREW_ROLES, $roles)) {
    $view_mode = 'teammate_view';
  }
  else {
    $view_mode = 'full';
  }
}

/**
 * Implements hook_ENTITY_TYPE_view_alter() for taxonomy_term.
 *
 * See the file header: without this the render cache leaks one audience's body
 * to another, and the leak is invisible until somebody checks as the wrong user.
 */
function bos_plant_problems_taxonomy_term_view_alter(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display): void {
  if (!in_array($entity->bundle(), BOS_PLANT_PROBLEMS_VIDS, TRUE)) {
    return;
  }
  $build['#cache']['contexts'][] = 'user.roles';
}

/**
 * The term whose hero should render, or NULL.
 *
 * Every viewer — public, office and crew. See
 * BOS_PLANT_PROBLEMS_HERO_EXCLUDED_ROLES for why this is not the rule the
 * other three hero modules use.
 */
function _bos_plant_problems_hero_term(): ?EntityInterface {
  $term = \Drupal::routeMatch()->getParameter('taxonomy_term');
  if (!$term instanceof EntityInterface || !in_array($term->bundle(), BOS_PLANT_PROBLEMS_VIDS, TRUE)) {
    return NULL;
  }
  if (array_intersect(BOS_PLANT_PROBLEMS_HERO_EXCLUDED_ROLES, \Drupal::currentUser()->getRoles())) {
    return NULL;
  }
  return _bos_plant_problems_banner_images($term) ? $term : NULL;
}

/**
 * The banner images, at the size the hero wants.
 *
 * Two sub-fields doing two different jobs, which is the whole point:
 *
 *   `alt`     -> the <img> attribute, what a screen reader announces. Falls
 *                back to the term name so an image is never undescribed.
 *   `caption` -> the visible rotating line under the title. The image item's
 *                TITLE sub-field and nothing else.
 *
 * ⚠ There is deliberately NO fallback from caption to alt. bos_seasons shipped
 * that fallback once and it recreated the exact bug it was meant to avoid — a
 * photo with proper alt and no caption printed its technical description at the
 * customer, and a screen reader then read the same sentence twice. Empty
 * caption means NO line for that slide, which is what "optional" has to mean to
 * be useful. On Spruce Needle Drop exactly one of the five photos carries a
 * caption: the mid-canopy frame where the diagnosis is visible.
 *
 * ⚠ The template reads `caption`. Omitting the key renders an empty, hidden
 * subtitle and blank data-bo-caption attributes — a real bug the seasons
 * builder shipped once.
 */
function _bos_plant_problems_banner_images(EntityInterface $term): array {
  if (!$term->hasField('field_banner_images') || $term->get('field_banner_images')->isEmpty()) {
    return [];
  }
  $style = ImageStyle::load('max_2600x2600');
  $images = [];
  foreach ($term->get('field_banner_images') as $item) {
    $file = $item->entity;
    if (!$file) {
      continue;
    }
    $uri = $file->getFileUri();
    $alt = trim((string) $item->alt);
    $title = trim((string) $item->title);
    $images[] = [
      'src' => $style ? $style->buildUrl($uri) : \Drupal::service('file_url_generator')->generateAbsoluteString($uri),
      'alt' => $alt !== '' ? $alt : $term->label(),
      'caption' => $title,
    ];
  }
  return $images;
}

/**
 * Implements hook_preprocess_page().
 *
 * Renders the banner as a full-bleed rotating hero in the theme's `hero`
 * region, reusing the `bo_hero_banner` theme hook and the
 * `brookstone_olivero/bo_hero` library that seasons, backflow device types and
 * equipment types already use. `alt_subtitle` makes the caption per-photo and
 * rotate with the slides.
 *
 * ⚠ Not field_short_description: the house rule is that the teaser is
 * VIEWS-ONLY — the card text on a parent listing, never rendered on the term's
 * own page. Putting it under the title would show it directly above the body it
 * summarises, which is the thing that rule exists to prevent.
 */
function bos_plant_problems_preprocess_page(array &$variables): void {
  $term = _bos_plant_problems_hero_term();
  if (!$term) {
    return;
  }
  $variables['page']['hero']['bo_hero_banner'] = [
    '#theme' => 'bo_hero_banner',
    '#images' => _bos_plant_problems_banner_images($term),
    '#title' => $term->label(),
    '#alt_subtitle' => TRUE,
  ];
  $variables['#attached']['library'][] = 'brookstone_olivero/bo_hero';
  $variables['#cache']['contexts'][] = 'user.roles';
}

/**
 * Implements hook_preprocess_html().
 */
function bos_plant_problems_preprocess_html(array &$variables): void {
  if (_bos_plant_problems_hero_term()) {
    $variables['attributes']['class'][] = 'has-bo-hero';
  }
}

/**
 * Implements hook_block_access().
 *
 * With a hero up, the hero carries the H1 — so the page-title block would be a
 * second one. Hidden only for viewers who actually get the hero, and only when
 * there is a banner, so a problem with no photo keeps its ordinary title.
 *
 * ⚠ This MUST use the same exclusion list as _hero_term(). When office was
 * added to the hero, a block_access still keyed on the old merged list would
 * have left them with the hero's H1 *and* the page-title block — two H1s on
 * the same page.
 */
function bos_plant_problems_block_access($block, $operation, AccountInterface $account) {
  if ($operation !== 'view' || $block->getPluginId() !== 'page_title_block') {
    return AccessResult::neutral();
  }
  $term = \Drupal::routeMatch()->getParameter('taxonomy_term');
  $hide = $term instanceof EntityInterface
    && in_array($term->bundle(), BOS_PLANT_PROBLEMS_VIDS, TRUE)
    && !array_intersect(BOS_PLANT_PROBLEMS_HERO_EXCLUDED_ROLES, $account->getRoles())
    && _bos_plant_problems_banner_images($term);
  return AccessResult::forbiddenIf((bool) $hide)
    ->addCacheContexts(['user.roles', 'route'])
    ->addCacheableDependency($term instanceof EntityInterface ? $term : $block);
}

/**
 * Implements hook_preprocess_taxonomy_term().
 *
 * Belt-and-braces: the banner field IS on this bundle's view displays (it was
 * added so the photos rendered at all before this hero existed). Without this,
 * a public viewer would get the hero AND the same five photos stacked raw
 * underneath it.
 */
function bos_plant_problems_preprocess_taxonomy_term(array &$variables): void {
  $term = $variables['term'] ?? NULL;
  if (!$term instanceof EntityInterface || !in_array($term->bundle(), BOS_PLANT_PROBLEMS_VIDS, TRUE)) {
    return;
  }
  if (_bos_plant_problems_hero_term() && isset($variables['content']['field_banner_images'])) {
    $variables['content']['field_banner_images']['#access'] = FALSE;
  }
}
