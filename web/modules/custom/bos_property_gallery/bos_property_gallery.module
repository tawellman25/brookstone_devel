<?php

/**
 * @file
 * Public property-page photo gallery.
 *
 * The staff "Gallery" tab (all photos + review flag) is a controller/local task
 * — see PropertyGalleryController. This file adds the PUBLIC gallery embedded on
 * the property's canonical page: only photos flagged field_public_ok = on (and
 * published), rendered as a Colorbox grid with SEO alt/captions.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;

/**
 * Bundles shown in a property gallery.
 */
const BOS_PROPERTY_GALLERY_BUNDLES = ['property_photo', 'property_video', 'wo_images', 'wo_videos'];

/**
 * Implements hook_ENTITY_TYPE_view() for properties.
 *
 * Appends the public gallery to the full property page.
 */
function bos_property_gallery_properties_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode) {
  if ($view_mode !== 'full') {
    return;
  }

  $storage = \Drupal::entityTypeManager()->getStorage('media');
  // Public gate: published AND flagged for the public gallery. accessCheck TRUE
  // so media access is still honored for anonymous visitors.
  $mids = $storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('field_property', $entity->id())
    ->condition('field_public_ok', 1)
    ->condition('status', 1)
    ->condition('bundle', BOS_PROPERTY_GALLERY_BUNDLES, 'IN')
    ->sort('created', 'DESC')
    ->execute();

  if (empty($mids)) {
    return;
  }

  $viewBuilder = \Drupal::entityTypeManager()->getViewBuilder('media');
  $items = [];
  foreach ($storage->loadMultiple($mids) as $media) {
    $items[] = [
      '#type' => 'container',
      '#attributes' => ['class' => ['bos-gallery__item']],
      'media' => $viewBuilder->view($media, 'gallery'),
    ];
  }

  $build['bos_property_gallery'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['bos-gallery-public']],
    '#weight' => 50,
    '#attached' => ['library' => ['bos_property_gallery/gallery']],
    // Cache: rebuild when the property or any media changes.
    '#cache' => [
      'tags' => ['media_list', 'properties:' . $entity->id()],
      'contexts' => ['user.permissions'],
    ],
    'title' => ['#markup' => '<h2 class="bos-gallery__section-title">' . t('Photo Gallery') . '</h2>'],
    'grid' => [
      '#type' => 'container',
      '#attributes' => ['class' => ['bos-gallery']],
      'items' => $items,
    ],
  ];
}
