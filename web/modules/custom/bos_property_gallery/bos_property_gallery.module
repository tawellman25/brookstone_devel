<?php

/**
 * @file
 * Property photo gallery — presentation is now Views (property_photos staff tab
 * + property_photos_public EVA). This module only attaches the gallery grid CSS
 * to those views. (The earlier controller/hook implementation was replaced by
 * Views so filters are adjustable in the UI.)
 */

/**
 * Implements hook_views_pre_render().
 */
function bos_property_gallery_views_pre_render(\Drupal\views\ViewExecutable $view) {
  if (in_array($view->id(), ['property_photos', 'property_photos_public'], TRUE)) {
    $view->element['#attached']['library'][] = 'bos_property_gallery/gallery';
  }
}
