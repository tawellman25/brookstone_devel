<?php

/**
 * @file
 * BOS Scheduling module.
 *
 * Provides teammate and supervisor scheduling views:
 * - /teammates/calendar/my-schedule    — crew daily schedule
 * - /teammates/calendar/dispatch       — supervisor dispatch board
 * - /admin/office/work-orders/sprinkler/scheduling — sprinkler bulk scheduler
 */

/**
 * Implements hook_theme().
 */
function bos_scheduling_theme(): array {
  return [
    'bos_scheduling_route_editor' => [
      'variables' => [
        'start' => NULL,
        'end' => NULL,
        'range' => '7',
        'prev' => NULL,
        'next' => NULL,
        // Toolbar day-jump: ISO 'today' for the link, the US-format window
        // label for display, and whether the window already holds today.
        // (An undeclared variable silently never reaches the template — see
        // the note on bos_scheduling_hub below.)
        'today' => NULL,
        'dates_label' => '',
        'is_today' => FALSE,
        'has_map_key' => FALSE,
      ],
      'template' => 'bos-scheduling-route-editor',
    ],
    'bos_scheduling_my_schedule' => [
      'variables' => [
        'date'       => NULL,
        'date_label' => NULL,
        'prev_date'  => NULL,
        'next_date'  => NULL,
        'items'      => [],
        'empty'      => FALSE,
      ],
      'template' => 'bos-scheduling-my-schedule',
    ],
    'bos_scheduling_dispatch' => [
      'variables' => [
        'date'        => NULL,
        'date_label'  => NULL,
        'prev_date'   => NULL,
        'next_date'   => NULL,
        'dept_filter' => '',
        'departments' => [],
        'teammates'   => [],
        'unassigned'  => [],
        'stats'       => [],
      ],
      'template' => 'bos-scheduling-dispatch',
    ],
    'bos_scheduling_sprinkler' => [
      'variables' => [
        'filter_type'   => '',
        'filter_zip'    => '',
        'filter_status' => 'unscheduled',
        'filter_street' => '',
        'filter_sort'   => 'city',
        'bundles'       => [],
        'zips'          => [],
        'teammates'     => [],
        'grouped'       => [],
        'stats'         => [],
      ],
      'template' => 'bos-scheduling-sprinkler',
    ],
    'bos_scheduling_hub' => [
      'variables' => [
        'active_tools'  => [],
        'planned_tools' => [],
        'stats'         => [],
        // A theme hook only receives variables declared here — an undeclared
        // '#route_editor_url' silently never reaches the template.
        'route_editor_url' => '',
      ],
      'template' => 'bos-scheduling-hub',
    ],
  ];
}
