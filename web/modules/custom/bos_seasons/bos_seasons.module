<?php

/**
 * @file
 * One URL per season, body by the viewer's role.
 *
 * The season pages carry crew notes as well as public copy, and the vocabulary
 * had exactly ONE view display when this was written — so there was nowhere for
 * crew copy to go that was not also public. Putting it on that single display
 * is the leak found across all six spray vocabularies on 2026-09-27, where
 * field_teammate_description was rendering to anonymous visitors.
 *
 * So: office gets admin_view, crew get teammate_view, everyone else gets full.
 * Same shape as bos_services, bos_spray_types and bos_backflow_types.
 *
 * ⚠ This is the fifth module implementing the identical routing. Worth
 * consolidating into one vocabulary-keyed router rather than a sixth copy; not
 * done here because it would touch four working modules for no behaviour change.
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\image\Entity\ImageStyle;

/**
 * Vocabularies this module routes.
 */
const BOS_SEASONS_VIDS = ['season'];

const BOS_SEASONS_OFFICE_ROLES = ['supervisor', 'administration', 'site_assistant', 'site_admin', 'administrator'];
const BOS_SEASONS_CREW_ROLES = ['teammates'];

/**
 * Implements hook_entity_view_mode_alter().
 */
function bos_seasons_entity_view_mode_alter(string &$view_mode, EntityInterface $entity): void {
  if ($entity->getEntityTypeId() !== 'taxonomy_term'
    || !in_array($entity->bundle(), BOS_SEASONS_VIDS, TRUE)) {
    return;
  }
  // Only the canonical page. A term rendered inside a view keeps its own mode.
  if ($view_mode !== 'full' && $view_mode !== 'default') {
    return;
  }
  $roles = \Drupal::currentUser()->getRoles();
  // Office is checked FIRST: an administrator who also holds the teammates
  // role should see the admin view, not the crew one.
  if (array_intersect(BOS_SEASONS_OFFICE_ROLES, $roles)) {
    $view_mode = 'admin_view';
  }
  elseif (array_intersect(BOS_SEASONS_CREW_ROLES, $roles)) {
    $view_mode = 'teammate_view';
  }
  else {
    $view_mode = 'full';
  }
}

/**
 * Implements hook_ENTITY_TYPE_view_alter() for taxonomy_term.
 *
 * The cache context is NOT optional. Without it the render cache serves
 * whichever audience's body was built first to everybody who follows — which
 * is how crew copy reaches the public even when the routing above is correct.
 */
function bos_seasons_taxonomy_term_view_alter(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display): void {
  if (!in_array($entity->bundle(), BOS_SEASONS_VIDS, TRUE)) {
    return;
  }
  $build['#cache']['contexts'][] = 'user.roles';
}

/**
 * The term whose hero should render, or NULL.
 *
 * Public viewers only: staff get admin_view / teammate_view, which are working
 * pages rather than marketing ones, and the full-bleed photo just pushes the
 * content they came for below the fold.
 */
function _bos_seasons_hero_term(): ?EntityInterface {
  $term = \Drupal::routeMatch()->getParameter('taxonomy_term');
  if (!$term instanceof EntityInterface || !in_array($term->bundle(), BOS_SEASONS_VIDS, TRUE)) {
    return NULL;
  }
  if (array_intersect(array_merge(BOS_SEASONS_OFFICE_ROLES, BOS_SEASONS_CREW_ROLES), \Drupal::currentUser()->getRoles())) {
    return NULL;
  }
  return _bos_seasons_banner_images($term) ? $term : NULL;
}

/**
 * The banner images, at the size the hero wants.
 */
function _bos_seasons_banner_images(EntityInterface $term): array {
  if (!$term->hasField('field_banner_images') || $term->get('field_banner_images')->isEmpty()) {
    return [];
  }
  $style = ImageStyle::load('max_2600x2600');
  $images = [];
  foreach ($term->get('field_banner_images') as $item) {
    $file = $item->entity;
    if (!$file) {
      continue;
    }
    $uri = $file->getFileUri();
    $alt = trim((string) $item->alt);
    $title = trim((string) $item->title);
    $images[] = [
      'src' => $style ? $style->buildUrl($uri) : \Drupal::service('file_url_generator')->generateAbsoluteString($uri),
      // Two sub-fields doing two different jobs, which is the point:
      //
      // `alt`     -> the <img> attribute. What a screen reader announces for
      //              the photo. Falls back to the season name so an image is
      //              never undescribed.
      // `caption` -> the visible rotating line under the title. The image's
      //              TITLE sub-field and nothing else.
      //
      // ⚠ There is deliberately NO fallback to alt. An earlier version had one,
      // to stop photos uploaded before this field existed losing their line —
      // and it recreated the exact bug being fixed: a photo with a proper
      // description and no caption printed "Sprinkler backflow valve wrapped
      // for winter" as the customer-facing line. Empty caption now means NO
      // line for that slide, which is what "optional" has to mean to be useful.
      // The migration (setup_season_hero_title.php) copies the old alt copy
      // into title, so nothing regresses — RUN IT BEFORE DEPLOYING THIS.
      //
      // The template reads `caption` -- omitting that key (as the backflow
      // builder does, since it passes a static subtitle) renders an empty,
      // hidden subtitle and blank data-bo-caption attributes. That is a real
      // bug this builder shipped once.
      'alt' => $alt !== '' ? $alt : $term->label(),
      'caption' => $title,
    ];
  }
  return $images;
}

/**
 * Implements hook_preprocess_page().
 *
 * Renders the banner as a full-bleed rotating hero in the theme's `hero`
 * region, reusing the bo_hero_banner theme hook and the brookstone_olivero
 * bo_hero library that backflow_device_types and equipment_types already use.
 *
 * The subtitle is per-photo and rotates with the slides (`alt_subtitle`), the
 * mode bos_geo already uses on the state, county and city pages.
 *
 * It reads the image's **title** sub-field, not its alt. Alt text was the first
 * implementation and Todd's follow-up question — should this be a title instead
 * — is the better design: one field cannot do both jobs. Good alt text ("a bench
 * on a gravel path beside a maple in full colour") reads badly as a caption,
 * good caption copy ("A bench placed on a path we maintain") is weak alt text,
 * and rendering alt as visible text made a screen reader meet the same sentence
 * twice. Split, each field does its own job and the double-read is gone.
 *
 * Caption is OPTIONAL, alt stays REQUIRED: a photo that needs no line should
 * show none, but an undescribed image is an accessibility hole.
 *
 * ⚠ This diverges from bos_geo, which still reads alt. Deliberate — geo is a
 * live surface with its own copy and changing it is a separate decision, not a
 * side effect of this one.
 *
 * ⚠ Not field_short_description, which the backflow hero does pass: the house
 * rule is that the teaser is VIEWS-ONLY, the card text on the PARENT page,
 * never rendered on the term's own page. Putting it under the title would show
 * it directly above the body it summarises — the thing that rule prevents.
 */
function bos_seasons_preprocess_page(array &$variables): void {
  $term = _bos_seasons_hero_term();
  if (!$term) {
    return;
  }
  $variables['page']['hero']['bo_hero_banner'] = [
    '#theme' => 'bo_hero_banner',
    '#images' => _bos_seasons_banner_images($term),
    '#title' => $term->label(),
    '#alt_subtitle' => TRUE,
  ];
  $variables['#attached']['library'][] = 'brookstone_olivero/bo_hero';
  $variables['#cache']['contexts'][] = 'user.roles';
}

/**
 * Implements hook_preprocess_html().
 */
function bos_seasons_preprocess_html(array &$variables): void {
  if (_bos_seasons_hero_term()) {
    $variables['attributes']['class'][] = 'has-bo-hero';
  }
}

/**
 * Implements hook_block_access().
 *
 * With a hero up, the hero carries the H1 — so the page-title block would be a
 * second one. Hidden for public viewers only, and only when there is actually a
 * banner, so a season with no photo keeps its ordinary title.
 */
function bos_seasons_block_access($block, $operation, AccountInterface $account) {
  if ($operation !== 'view' || $block->getPluginId() !== 'page_title_block') {
    return AccessResult::neutral();
  }
  $term = \Drupal::routeMatch()->getParameter('taxonomy_term');
  $hide = $term instanceof EntityInterface
    && in_array($term->bundle(), BOS_SEASONS_VIDS, TRUE)
    && !array_intersect(array_merge(BOS_SEASONS_OFFICE_ROLES, BOS_SEASONS_CREW_ROLES), $account->getRoles())
    && _bos_seasons_banner_images($term);
  return AccessResult::forbiddenIf((bool) $hide)
    ->addCacheContexts(['user.roles', 'route'])
    ->addCacheableDependency($term instanceof EntityInterface ? $term : $block);
}

/**
 * Implements hook_preprocess_taxonomy_term().
 *
 * Belt-and-braces: if the banner field ever gets put back on a view display,
 * the raw stacked images must not render underneath the hero that is already
 * showing them.
 */
function bos_seasons_preprocess_taxonomy_term(array &$variables): void {
  $term = $variables['term'] ?? NULL;
  if (!$term instanceof EntityInterface || !in_array($term->bundle(), BOS_SEASONS_VIDS, TRUE)) {
    return;
  }
  if (_bos_seasons_hero_term() && isset($variables['content']['field_banner_images'])) {
    $variables['content']['field_banner_images']['#access'] = FALSE;
  }
}

/**
 * Implements hook_field_widget_single_element_form_alter().
 *
 * Relabels the hero photo's alt/title boxes.
 *
 * Without this the office sees Drupal's generic "Alternative text" and "Title"
 * and has no way to know that Title is the line customers read under the
 * heading — so the caption would go in the wrong box, or nowhere. The labels
 * are the only place that distinction is visible at the moment of typing.
 *
 * Scoped to field_banner_images on season; the other vocabularies using this
 * shared field do not render a caption and are left alone.
 */
function bos_seasons_field_widget_single_element_form_alter(array &$element, FormStateInterface $form_state, array $context): void {
  $items = $context['items'] ?? NULL;
  if (!$items || $items->getFieldDefinition()->getName() !== 'field_banner_images') {
    return;
  }
  $entity = $items->getEntity();
  if (!$entity instanceof EntityInterface || !in_array($entity->bundle(), BOS_SEASONS_VIDS, TRUE)) {
    return;
  }
  // The alt/title inputs are built by ImageWidget::process(), which runs after
  // this hook, so relabel in #after_build rather than here.
  $element['#after_build'][] = '_bos_seasons_label_hero_photo_boxes';
}

/**
 * Relabels the alt and title inputs on a hero photo widget.
 */
function _bos_seasons_label_hero_photo_boxes(array $element, FormStateInterface $form_state): array {
  if (isset($element['alt'])) {
    $element['alt']['#title'] = t('Describe the photo (for screen readers and search)');
    $element['alt']['#description'] = t('What is in the picture, for someone who cannot see it. Not shown on the page.');
  }
  if (isset($element['title'])) {
    $element['title']['#title'] = t('Caption shown under the heading');
    $element['title']['#description'] = t('The line a customer reads while this photo is on screen. Leave empty for no caption.');
  }
  return $element;
}
