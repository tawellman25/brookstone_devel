<?php

/**
 * @file
 * Install/update hooks for bos_service_request.
 *
 * permissions.yml only DEFINES the permission; it does not assign it. Roles are
 * granted here on install, and again in a hook_update_N so an already-enabled
 * live install picks up the grant (config/install does not re-import on an
 * already-enabled module — documented BOS gotcha).
 *
 * NOTE: the service_request ECK entity type, its bundle, fields and displays are
 * created by web/scripts/setup_service_request_entity.php (run per environment),
 * and the service_request_status vocabulary by
 * web/scripts/seed_service_request_status.php — not by this install hook. ECK
 * field instances silently skip on cim, so the entity-API setup script is the
 * reliable, idempotent landing path (BOS standard).
 */

use Drupal\user\Entity\Role;

/**
 * Office roles that administer service requests.
 * (administrator is a superuser role and receives the permission implicitly.)
 */
const BOS_SERVICE_REQUEST_ADMIN_ROLES = ['administration', 'supervisor', 'site_admin'];

/**
 * Implements hook_install().
 */
function bos_service_request_install() {
  _bos_service_request_grant_admin_permission();
}

/**
 * Grant "administer service requests" to office roles (idempotent).
 */
function bos_service_request_update_10001() {
  _bos_service_request_grant_admin_permission();
  return (string) t('Granted "administer service requests" to office roles.');
}

/**
 * P0.1 + P0.5: campaign variants (pc26a/pc26b) + freeze disclaimer.
 *
 * config/install does not re-import on an already-enabled module, so push the
 * new values onto active config here. Idempotent: campaign codes are merged
 * (never dropping office-added ones, and keeping legacy pc26); the disclaimer is
 * only seeded when empty (never clobbers an office edit).
 */
function bos_service_request_update_10002() {
  $cfg = \Drupal::configFactory()->getEditable('bos_service_request.settings');
  $changed = [];

  $campaigns = $cfg->get('campaigns') ?? [];
  foreach (['website', 'pc26a', 'pc26b', 'pc26'] as $code) {
    if (!in_array($code, $campaigns, TRUE)) {
      $campaigns[] = $code;
    }
  }
  $cfg->set('campaigns', array_values($campaigns));
  $changed[] = 'campaigns=' . implode(',', $campaigns);

  $bundles = $cfg->get('bundles') ?? [];
  $default = 'Sprinkler winterization (blow-out) greatly reduces but cannot eliminate the risk of freeze damage. Systems can still be damaged by an early hard freeze before your scheduled service, by water in components we are unable to reach, or by pre-existing conditions. By submitting this request you acknowledge that Brookstone is not responsible for freeze damage occurring before your winterization is performed.';
  foreach ($bundles as $name => $b) {
    if (empty($b['freeze_disclaimer'])) {
      $bundles[$name]['freeze_disclaimer'] = $default;
      $changed[] = "freeze_disclaimer[$name] seeded";
    }
  }
  $cfg->set('bundles', $bundles);

  $cfg->save();
  return (string) t('Updated service-request settings: @c', ['@c' => implode('; ', $changed)]);
}

/**
 * Phase 2 §5: seasonal customer-facing strings (canonical copy).
 *
 * Sets scheduling_notice + freeze_disclaimer to the approved copy and adds the
 * new specific_date_notice + closed_notice keys. Initial content load (not
 * office-authored yet); the office can edit afterward. Idempotent one-time.
 */
function bos_service_request_update_10003() {
  $cfg = \Drupal::configFactory()->getEditable('bos_service_request.settings');
  $bundles = $cfg->get('bundles') ?? [];
  $copy = [
    'scheduling_notice' => 'We start winterizing in early October and work through the month by geographic route. Space is limited — get on the list early.',
    'specific_date_notice' => 'Need a specific date? Call the office at 970-835-9661 by September 21st.',
    'freeze_disclaimer' => 'If a hard freeze is possible before your scheduled date, please cover your backflow or pump. We are not responsible for freeze damage that occurs before we winterize your system.',
    'closed_notice' => 'Winterization signup for 2026 is closed. Call the office at 970-835-9661 and we will tell you what is still possible.',
  ];
  if (isset($bundles['sprinkler_winterizing'])) {
    foreach ($copy as $k => $v) {
      $bundles['sprinkler_winterizing'][$k] = $v;
    }
    $cfg->set('bundles', $bundles)->save();
    return (string) t('Set seasonal winterizing strings (scheduling/specific-date/freeze/closed).');
  }
  return (string) t('sprinkler_winterizing bundle not found — no change.');
}

/**
 * Add the Bear Creek + Online promotion campaign codes to the allowlist.
 * Idempotent merge (keeps existing/office-added codes).
 */
function bos_service_request_update_10004() {
  $cfg = \Drupal::configFactory()->getEditable('bos_service_request.settings');
  $campaigns = $cfg->get('campaigns') ?? [];
  foreach (['bearcreek26', 'online26'] as $code) {
    if (!in_array($code, $campaigns, TRUE)) {
      $campaigns[] = $code;
    }
  }
  $cfg->set('campaigns', array_values($campaigns))->save();
  return (string) t('Campaign allowlist: @c', ['@c' => implode(', ', $campaigns)]);
}

/**
 * Idempotently grant the admin permission to the office roles.
 */
function _bos_service_request_grant_admin_permission() {
  foreach (BOS_SERVICE_REQUEST_ADMIN_ROLES as $rid) {
    $role = Role::load($rid);
    if ($role && !$role->hasPermission('administer service requests')) {
      $role->grantPermission('administer service requests');
      $role->save();
    }
  }
}
