<?php

/**
 * @file
 * BOS Service Request — public intake layer.
 *
 * ARCHITECTURE / SECURITY NOTE (do not "fix" by granting anonymous create):
 * service_request entities are created PROGRAMMATICALLY in a submit handler on
 * the public route (Gate 3), never through a granted anonymous ECK permission.
 * The route + captcha + flood control are the access boundary. Anonymous users
 * have NO create/view/edit permission on this entity and no route to reach one.
 *
 * This .module holds hook glue only (title + opaque reference assignment on
 * create). All business logic lives in services (Gate 2+).
 */

use Drupal\Core\Url;

/**
 * Bundle → public-reference prefix. Winterizing = "W" (matches the postcard).
 */
const BOS_SERVICE_REQUEST_REF_PREFIXES = [
  'sprinkler_winterizing' => 'W',
  'fall_cleanup' => 'F',
];

/**
 * WO status Complete-and-beyond guard is handled elsewhere; here we only guard
 * the service_request "Converted" invariant (see the presave guard below).
 */

/**
 * Implements hook_entity_operation() for the admin queue's Operations column.
 *
 * Adds Approve & Create WO + the three secondary actions to a service_request's
 * operations dropbutton (permission-gated; hidden once converted). The admin
 * View renders these via its Operations field — no VBO.
 */
function bos_service_request_entity_operation(\Drupal\Core\Entity\EntityInterface $entity): array {
  if ($entity->getEntityTypeId() !== 'service_request') {
    return [];
  }
  if (!\Drupal::currentUser()->hasPermission('administer service requests')) {
    return [];
  }
  $ops = [];
  $id = $entity->id();
  $converted = $entity->hasField('field_work_order') && !$entity->get('field_work_order')->isEmpty();
  $has_property = $entity->hasField('field_property') && !$entity->get('field_property')->isEmpty();
  if (!$converted) {
    // New customer (no matched property) → guided create-customer flow first.
    if (!$has_property) {
      $ops['sr_create_customer'] = [
        'title' => t('Create Customer & Property'),
        'weight' => 0,
        'url' => Url::fromRoute('bos_service_request.create_customer', ['service_request' => $id]),
      ];
    }
    $ops['sr_convert'] = [
      'title' => t('Approve & Create WO'),
      'weight' => 1,
      'url' => Url::fromRoute('bos_service_request.convert', ['service_request' => $id]),
    ];
    $ops['sr_already_covered'] = [
      'title' => t('Mark Already Covered'),
      'weight' => 2,
      'url' => Url::fromRoute('bos_service_request.action', ['service_request' => $id, 'op' => 'already-covered']),
    ];
    $ops['sr_duplicate'] = [
      'title' => t('Mark Duplicate'),
      'weight' => 3,
      'url' => Url::fromRoute('bos_service_request.action', ['service_request' => $id, 'op' => 'duplicate']),
    ];
    $ops['sr_reject'] = [
      'title' => t('Reject'),
      'weight' => 4,
      'url' => Url::fromRoute('bos_service_request.action', ['service_request' => $id, 'op' => 'reject']),
    ];
  }
  return $ops;
}

/**
 * Implements hook_ENTITY_TYPE_presave() for service_request.
 *
 * Assign an opaque, customer-facing reference before the first save (no entity
 * id needed). Never expose the entity id publicly — this is what the customer
 * sees. Generated once; never overwritten.
 */
function bos_service_request_service_request_presave(\Drupal\Core\Entity\EntityInterface $entity) {
  if ($entity->hasField('field_public_ref') && $entity->get('field_public_ref')->isEmpty()) {
    $entity->set('field_public_ref', _bos_service_request_generate_ref($entity->bundle()));
  }

  // Defense-in-depth (the form-layer convert action is the primary path; this is
  // the presave backstop): a request may NOT be marked Converted without a
  // linked work order. The converter sets both in one save, so it passes; a
  // manual status flip to Converted with no WO is blocked.
  if (!$entity->isNew()
    && $entity->hasField('field_request_status') && !$entity->get('field_request_status')->isEmpty()
    && $entity->hasField('field_work_order') && $entity->get('field_work_order')->isEmpty()) {
    try {
      $convertedTid = \Drupal::service('bos_service_request.status_resolver')
        ->tid(\Drupal\bos_service_request\Service\ServiceRequestStatusResolver::CONVERTED);
    }
    catch (\Throwable $e) {
      return;
    }
    if ((int) $entity->get('field_request_status')->target_id === $convertedTid) {
      throw new \Drupal\Core\Entity\EntityStorageException(
        'A service request cannot be marked Converted without a linked work order. Use "Approve & Create Work Order".'
      );
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert() for service_request.
 *
 * Set the title to "Service Request #{id}" now that the id exists. Deliberately
 * NOT an auto_entitylabel [entity:id] pattern — that leaves a stuck
 * %AutoEntityLabel:uuid% sentinel on a single programmatic save, and nothing
 * heals service_request the way wo_shared heals work_order. The re-save fires
 * hook_update (which has no title logic), so there is no recursion.
 */
function bos_service_request_service_request_insert(\Drupal\Core\Entity\EntityInterface $entity) {
  if ($entity->label() === NULL || $entity->label() === '' || str_contains((string) $entity->label(), 'AutoEntityLabel')) {
    $entity->set('title', 'Service Request #' . $entity->id());
    $entity->save();
  }
}

/**
 * Generate a unique opaque public reference, e.g. "W-7K3P2Q".
 *
 * Crockford-style alphabet (no I/L/O/U, no 0/1 ambiguity issues) so it reads
 * cleanly over the phone. Retries on the vanishingly rare collision.
 */
function _bos_service_request_generate_ref(string $bundle): string {
  $prefix = BOS_SERVICE_REQUEST_REF_PREFIXES[$bundle] ?? 'SR';
  $alphabet = '23456789ABCDEFGHJKMNPQRSTVWXYZ';
  $storage = \Drupal::entityTypeManager()->getStorage('service_request');
  for ($try = 0; $try < 25; $try++) {
    $ref = $prefix . '-';
    for ($i = 0; $i < 6; $i++) {
      $ref .= $alphabet[random_int(0, strlen($alphabet) - 1)];
    }
    $exists = $storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('field_public_ref', $ref)
      ->range(0, 1)
      ->sort('id', 'ASC')
      ->execute();
    if (!$exists) {
      return $ref;
    }
  }
  // Practically unreachable fallback.
  return $prefix . '-' . strtoupper(substr(bin2hex(random_bytes(4)), 0, 6));
}

/**
 * The public marketing-chrome routes (signup + check-your-week).
 */
const BOS_SERVICE_REQUEST_WINTERIZE_ROUTE = 'bos_service_request.winterize';
const BOS_SERVICE_REQUEST_CHECK_ROUTE = 'bos_service_request.check_week';
const BOS_SERVICE_REQUEST_BEAR_CREEK_ROUTE = 'bos_service_request.bear_creek';

/**
 * TRUE on any public winterize page (all use the marketing template).
 */
function _bos_service_request_is_winterize(): bool {
  return in_array(\Drupal::routeMatch()->getRouteName(), [
    BOS_SERVICE_REQUEST_WINTERIZE_ROUTE,
    BOS_SERVICE_REQUEST_CHECK_ROUTE,
    BOS_SERVICE_REQUEST_BEAR_CREEK_ROUTE,
  ], TRUE);
}

/**
 * Implements hook_page_attachments().
 *
 * Publish the BOS brand palette (--bo-* tokens, css/bo-tokens.css) site-wide as
 * the single source of truth for the brand colors, so any theme/module CSS can
 * reference them instead of hardcoding hexes. Purely additive — defining CSS
 * custom properties changes nothing until something uses them.
 */
function bos_service_request_page_attachments(array &$attachments) {
  $attachments['#attached']['library'][] = 'bos_service_request/brand_tokens';

  // SEO meta description on the Fall Cleanup landing page (winterize emits none,
  // so this stays a page-scoped tag, not a new site-wide pattern).
  if (_bos_service_request_is_fall_cleanup_page()) {
    $attachments['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => [
          'name' => 'description',
          'content' => 'Leaf removal, bed cleanup, and final mow across Delta and Montrose counties. Book it the same week we winterize your sprinklers. 30+ years on the Western Slope.',
        ],
      ],
      'bos_fall_cleanup_description',
    ];
    $attachments['#cache']['contexts'][] = 'user.roles';
  }
}

/**
 * Implements hook_theme_suggestions_page_alter().
 *
 * /winterize uses a dedicated marketing template (logo, hero, footer — NO site
 * navigation). If the active theme lacks page--winterize.html.twig this falls
 * back to the normal page template (degrades safely — the form still works).
 */
function bos_service_request_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  if (_bos_service_request_is_winterize()) {
    $suggestions[] = 'page__winterize';
  }
  elseif (_bos_service_request_is_fall_cleanup_page()) {
    $suggestions[] = 'page__fall_cleanup';
  }
}

/**
 * The Fall Cleanup services term id (from config), or 0.
 */
function _bos_service_request_fall_cleanup_term_id(): int {
  return (int) (\Drupal::config('bos_service_request.settings')->get('bundles.fall_cleanup.service_term_id') ?? 0);
}

/**
 * TRUE on the PUBLIC Fall Cleanup landing page. It is the services term's
 * canonical page, but only for public/client viewers — internal roles keep the
 * normal services term render (bos_services teammate_view crew training).
 */
function _bos_service_request_is_fall_cleanup_page(): bool {
  if (\Drupal::routeMatch()->getRouteName() !== 'entity.taxonomy_term.canonical') {
    return FALSE;
  }
  $term = \Drupal::routeMatch()->getParameter('taxonomy_term');
  $tid = is_object($term) ? (int) $term->id() : (int) $term;
  if (!$tid || $tid !== _bos_service_request_fall_cleanup_term_id()) {
    return FALSE;
  }
  // Internal roles → let bos_services render the crew training view instead.
  $internal = ['teammates', 'supervisor', 'administration', 'site_assistant', 'site_admin', 'administrator'];
  return !array_intersect($internal, \Drupal::currentUser()->getRoles());
}

/**
 * Implements hook_preprocess_page().
 *
 * Attach the winterize library and pass brand assets + copy to the template.
 */
function bos_service_request_preprocess_page(array &$variables) {
  if (_bos_service_request_is_fall_cleanup_page()) {
    _bos_service_request_preprocess_fall_cleanup($variables);
    return;
  }
  if (!_bos_service_request_is_winterize()) {
    return;
  }
  $variables['#attached']['library'][] = 'bos_service_request/winterize';
  $base = '/' . \Drupal::service('extension.list.module')->getPath('bos_service_request');
  $cfg = \Drupal::config('bos_service_request.settings');
  $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')
    ->load((int) $cfg->get('bundles.sprinkler_winterizing.service_term_id'));

  $variables['bo_logo'] = $base . '/assets/bo-logo-round.png';
  $variables['bo_hero'] = $base . '/assets/winterize-hero.jpg';
  $variables['bo_phone'] = (string) $cfg->get('office_phone');
  $variables['bo_tagline'] = 'Creating and Maintaining Your Outdoor Spaces';
  $variables['bo_year'] = (int) ($cfg->get('bundles.sprinkler_winterizing.service_year') ?: date('Y'));
  $variables['bo_address'] = '20143 Austin Rd., Austin, CO 81410';

  $route = \Drupal::routeMatch()->getRouteName();
  $variables['bo_offer'] = NULL;
  $accordions = ($term && $term->hasField('field_service_public_desc') && !$term->get('field_service_public_desc')->isEmpty())
    ? _bos_service_request_accordions((string) $term->get('field_service_public_desc')->value) : NULL;

  if ($route === BOS_SERVICE_REQUEST_CHECK_ROUTE) {
    // pc26a "already on our list" → Check-your-week page.
    $variables['bo_eyebrow'] = 'Sprinkler Winterization · ' . $variables['bo_year'];
    $variables['bo_headline'] = "You're on the list.";
    $variables['bo_subhead'] = 'Check the week we plan to be in your area — we confirm it against the phone or email on your account.';
    $variables['bo_cta_text'] = 'Check my week';
    $variables['bo_formband_h2'] = 'Check your service week';
    $variables['bo_formband_intro'] = 'We schedule winterizations by geographic route through October. Enter your details to see your week.';
    $variables['bo_show_detail'] = FALSE;
    $variables['bo_accordions'] = NULL;
  }
  elseif ($route === BOS_SERVICE_REQUEST_BEAR_CREEK_ROUTE) {
    // Bear Creek subdivision promotion — $60 offer.
    $variables['bo_eyebrow'] = 'Bear Creek Residents · Winterization ' . $variables['bo_year'];
    $variables['bo_headline'] = 'Get your sprinklers ready for winter.';
    $variables['bo_subhead'] = "As Bear Creek HOA's maintenance provider, we're offering residents an exclusive winterization rate this fall.";
    $variables['bo_offer'] = [
      'price' => '$60',
      'regular' => 'Regularly $90',
      'note' => 'Exclusive Bear Creek resident rate. Includes professional winterization of residential systems with up to 5 zones.',
      'deadline' => 'Sign up by September 30th, ' . $variables['bo_year'] . '.',
    ];
    $variables['bo_cta_text'] = 'Get on the list';
    $variables['bo_formband_h2'] = 'Reserve your Bear Creek winterization';
    $variables['bo_formband_intro'] = "We schedule by geographic route through October and will contact you with the week we plan to be in your area. Takes about a minute.";
    $variables['bo_show_detail'] = TRUE;
    $variables['bo_accordions'] = $accordions;
  }
  else {
    // Default / pc26b / other codes — signup.
    $variables['bo_eyebrow'] = 'Sprinkler Winterization · ' . $variables['bo_year'];
    $variables['bo_headline'] = 'Fall is on its way.';
    $variables['bo_subhead'] = 'Water left in your lines splits pipe, valves and backflows when it freezes — and underground breaks stay hidden until spring.';
    $variables['bo_cta_text'] = 'Get on the list';
    $variables['bo_formband_h2'] = 'Request your winterization';
    $variables['bo_formband_intro'] = "We start in early October and work through the month, organized by location and water supply. We'll contact you with the week we plan to be in your area. Takes about a minute.";
    $variables['bo_show_detail'] = TRUE;
    $variables['bo_accordions'] = $accordions;
  }
}

/**
 * Build the public body into JS-free <details> accordions (split by <h3>).
 * Returns a processed_text render array (full_html preserves details/summary).
 */
function _bos_service_request_accordions(string $html): array {
  $parts = preg_split('#<h3>(.*?)</h3>#is', $html, -1, PREG_SPLIT_DELIM_CAPTURE);
  $blocks = '';
  $intro = trim($parts[0] ?? '');
  if ($intro !== '') {
    $blocks .= '<div class="winterize-detail-intro">' . $intro . '</div>';
  }
  for ($i = 1; $i < count($parts); $i += 2) {
    $heading = trim($parts[$i] ?? '');
    $content = trim($parts[$i + 1] ?? '');
    if ($heading === '' && $content === '') {
      continue;
    }
    $blocks .= '<details class="winterize-detail-section"><summary>' . $heading . '</summary>' . $content . '</details>';
  }
  return ['#type' => 'processed_text', '#text' => $blocks, '#format' => 'full_html'];
}

/**
 * Implements hook_theme().
 *
 * Registers the admin-queue row suggestion so the service_request_admin view
 * renders each request as a BOS status card (UI-patterns status-card;
 * templates/views-view-fields--service-request-admin.html.twig).
 */
function bos_service_request_theme($existing, $type, $theme, $path): array {
  return [
    'views_view_fields__service_request_admin' => [
      'base hook' => 'views_view_fields',
    ],
  ];
}

/**
 * Implements hook_views_pre_render().
 *
 * Attach the service-request card CSS to the admin queue.
 */
function bos_service_request_views_pre_render($view): void {
  if ($view->id() === 'service_request_admin') {
    $view->element['#attached']['library'][] = 'bos_service_request/request_cards';
  }
}

/**
 * Implements hook_preprocess_HOOK() for views_view_fields.
 *
 * Computes the card data for each service_request row on the admin queue. The
 * Operations dropbutton stays a rendered view field ({{ fields.operations }}).
 */
function bos_service_request_preprocess_views_view_fields(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!$view || $view->id() !== 'service_request_admin') {
    return;
  }
  $entity = $variables['row']->_entity ?? NULL;
  if (!$entity instanceof \Drupal\Core\Entity\EntityInterface || $entity->getEntityTypeId() !== 'service_request') {
    return;
  }
  $variables['sr_card'] = _bos_service_request_build_card($entity);
}

/**
 * Status label → card accent class.
 */
function _bos_service_request_status_class(string $label): string {
  $map = [
    'New' => 'new',
    'Needs Review' => 'review',
    'Verified' => 'verified',
    'Already Covered' => 'covered',
    'Duplicate' => 'dup',
    'Rejected' => 'rejected',
    'Converted' => 'converted',
  ];
  return $map[$label] ?? 'new';
}

/**
 * Builds the card data array for one service_request row.
 */
function _bos_service_request_build_card(\Drupal\Core\Entity\EntityInterface $sr): array {
  $get = function (string $f) use ($sr): string {
    return ($sr->hasField($f) && !$sr->get($f)->isEmpty()) ? trim((string) $sr->get($f)->value) : '';
  };
  $ref_entity = function (string $f) use ($sr) {
    return ($sr->hasField($f) && !$sr->get($f)->isEmpty()) ? $sr->get($f)->entity : NULL;
  };

  try {
    $view_url = $sr->toUrl()->toString();
  }
  catch (\Throwable $e) {
    $view_url = '/service_request/' . $sr->id();
  }

  // Status.
  $status_term = $ref_entity('field_request_status');
  $status = $status_term ? (string) $status_term->label() : 'New';

  // Matched property.
  $property = $ref_entity('field_property');
  $prop_label = '';
  $prop_url = '';
  if ($property) {
    $prop_label = trim((string) ($property->get('field_nickname')->value ?? '')) ?: (string) $property->label();
    try {
      $prop_url = $property->toUrl()->toString();
    }
    catch (\Throwable $e) {
      $prop_url = '';
    }
  }

  // Created work order.
  $wo = $ref_entity('field_work_order');
  $wo_id = '';
  $wo_url = '';
  if ($wo) {
    $wo_id = (string) $wo->id();
    try {
      $wo_url = $wo->toUrl()->toString();
    }
    catch (\Throwable $e) {
      $wo_url = '';
    }
  }

  // Submitted date (US format per BOS convention).
  $submitted = '';
  if (!$sr->get('created')->isEmpty()) {
    $submitted = \Drupal::service('date.formatter')->format((int) $sr->get('created')->value, 'custom', 'm/d/Y g:i A');
  }

  // Interest badges — per bundle.
  $wants = [];
  // Winterize bundle wants.
  if ($sr->hasField('field_wants_recurring') && (bool) $sr->get('field_wants_recurring')->value) {
    $wants[] = 'Auto each fall';
  }
  if ($sr->hasField('field_wants_startup') && (bool) $sr->get('field_wants_startup')->value) {
    $wants[] = 'Spring start-up';
  }
  if ($sr->hasField('field_wants_specific_date') && (bool) $sr->get('field_wants_specific_date')->value) {
    $wants[] = 'Wants a date — call back';
  }
  // Fall cleanup bundle wants + the selected needs.
  if ($sr->hasField('field_fc_wants_winterize') && (bool) $sr->get('field_fc_wants_winterize')->value) {
    $wants[] = 'Winterize too';
  }
  if ($sr->hasField('field_fc_wants_snow') && (bool) $sr->get('field_fc_wants_snow')->value) {
    $wants[] = 'Snow contract';
  }
  if ($sr->hasField('field_fc_wants_landscape') && (bool) $sr->get('field_fc_wants_landscape')->value) {
    $wants[] = 'Spring landscape';
  }
  $needs = [];
  if ($sr->hasField('field_fc_needs') && !$sr->get('field_fc_needs')->isEmpty()) {
    $allowed = $sr->get('field_fc_needs')->getFieldDefinition()->getSetting('allowed_values') ?? [];
    foreach ($sr->get('field_fc_needs')->getValue() as $item) {
      $needs[] = $allowed[$item['value']] ?? $item['value'];
    }
  }

  $bundleLabel = ['sprinkler_winterizing' => 'Winterize', 'fall_cleanup' => 'Fall Cleanup'][$sr->bundle()] ?? $sr->bundle();

  $phone = $get('field_submitted_phone');

  return [
    'id' => $sr->id(),
    'ref' => $get('field_public_ref'),
    'bundle' => $sr->bundle(),
    'bundle_label' => $bundleLabel,
    'view_url' => $view_url,
    'submitted' => $submitted,
    'name' => $get('field_submitted_name'),
    'phone' => $phone,
    'phone_tel' => preg_replace('/[^0-9+]/', '', $phone),
    'email' => $get('field_submitted_email'),
    'address' => $get('field_submitted_address'),
    'zip' => $get('field_submitted_zip'),
    'property_label' => $prop_label,
    'property_url' => $prop_url,
    'status' => $status,
    'status_class' => _bos_service_request_status_class($status),
    'campaign' => $get('field_campaign'),
    'flags' => $get('field_review_flags'),
    'wants' => $wants,
    'needs' => $needs,
    'wo_id' => $wo_id,
    'wo_url' => $wo_url,
  ];
}

/**
 * Fall Cleanup public landing page — variables for page--fall-cleanup.html.twig.
 *
 * Mirrors the winterize marketing chrome (hero / steps / accordions), but keeps
 * the site's normal header + breadcrumb + footer (this is a services term page,
 * not a bare route). Body copy ("How we do it") comes from the term's editable
 * field_service_public_desc; the short chrome lives here (as with winterize).
 */
function _bos_service_request_preprocess_fall_cleanup(array &$variables): void {
  $variables['#attached']['library'][] = 'bos_service_request/fall_cleanup';
  // Role-varying (public vs internal) + campaign query param.
  $variables['#cache']['contexts'][] = 'user.roles';
  $variables['#cache']['contexts'][] = 'url.query_args';

  $base = '/' . \Drupal::service('extension.list.module')->getPath('bos_service_request');
  $cfg = \Drupal::config('bos_service_request.settings');
  $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')
    ->load(_bos_service_request_fall_cleanup_term_id());

  $variables['bo_logo'] = $base . '/assets/bo-logo-round.png';
  // Reuse the autumn aspen-leaf/river-rock hero — it matches the fall copy.
  $variables['bo_hero'] = $base . '/assets/winterize-hero.jpg';
  $variables['bo_phone'] = (string) $cfg->get('office_phone');
  $variables['bo_tagline'] = 'Creating and Maintaining Your Outdoor Spaces';
  $variables['bo_address'] = '20143 Austin Rd., Austin, CO 81410';

  // The intake form.
  $variables['bo_form'] = \Drupal::formBuilder()->getForm(\Drupal\bos_service_request\Form\FallCleanupForm::class);

  // Editable body → accordions (same renderer as winterize).
  $variables['bo_accordions'] = ($term && $term->hasField('field_service_public_desc') && !$term->get('field_service_public_desc')->isEmpty())
    ? _bos_service_request_accordions((string) $term->get('field_service_public_desc')->value)
    : NULL;

  // Breadcrumb (real menu trail — Home › Landscape and Lawn Care › Yard Cleanup › Fall Cleanup).
  $crumbs = [];
  $breadcrumb = \Drupal::service('breadcrumb')->build(\Drupal::routeMatch());
  foreach ($breadcrumb->getLinks() as $link) {
    try {
      $crumbs[] = ['title' => $link->getText(), 'url' => $link->getUrl()->toString()];
    }
    catch (\Throwable $e) {
      // Skip an unroutable crumb.
    }
  }
  $variables['bo_breadcrumb'] = $crumbs;

  // Marketing chrome (approved copy; matches winterize's in-template pattern).
  $variables['bo_h1'] = 'Fall Cleanup';
  $variables['bo_hook'] = 'Leaves do not blow away over the winter. They mat down under the snow, and what comes out in April is not lawn.';
  $variables['bo_cta_text'] = 'Request your fall cleanup';
  $variables['bo_trust'] = [
    '30+ years on the Western Slope',
    'One trip — cleanup and sprinkler winterization the same week',
  ];
  $variables['bo_formband_h2'] = 'Request your fall cleanup';
  $variables['bo_formband_intro'] = 'We start once leaf drop is mostly finished and work until the ground freezes, organized by location. We will contact you with the week we plan to be in your area. Takes about a minute.';
  $variables['bo_form_disclaimer'] = 'Fall cleanup is priced by the property, not by a flat rate. We will look at it and give you a number before we start any work.';
  $variables['bo_scarcity'] = 'Routes fill from late October through the first snow.';
  $variables['bo_steps'] = [
