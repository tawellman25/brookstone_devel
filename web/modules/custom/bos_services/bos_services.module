<?php

/**
 * @file
 * BOS Services — role-based rendering of the services taxonomy.
 *
 * Follows the BOS audience view-mode tier pattern (see
 * __BOS_AI/Governance/ui_patterns.md): one /services/{name} URL, different body
 * by audience — office/admin -> admin_view, crew -> teammate_view, public/clients
 * -> full.
 */

use Drupal\Component\Utility\Html;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\image\Entity\ImageStyle;
use Drupal\taxonomy\Entity\Term;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_views_pre_render().
 *
 * The "Our {Category} Services" child-service cards EVA (service_children):
 * attach the compact-grid styling and rewrite the header to name the current
 * term. The view lists a term's direct children (arg = current term id); the
 * header only renders when there ARE children, so a leaf service shows nothing.
 */
function bos_services_views_pre_render(ViewExecutable $view) {
  if ($view->id() !== 'service_children') {
    return;
  }
  $view->element['#attached']['library'][] = 'bos_services/service_children';

  if (!empty($view->args[0]) && isset($view->header['area'])
    && ($term = Term::load($view->args[0]))) {
    $view->header['area']->options['content']['value'] =
      '<h2 class="service-children__title">Our ' . Html::escape($term->label()) . ' Services</h2>';
  }
}

/**
 * Implements hook_preprocess_HOOK() for views_view_field.
 *
 * Child-service cards use the public-description field's SUMMARY as the blurb
 * (office writes a short, card-specific line there; the full description is the
 * in-depth copy on the service page itself). Show the summary ONLY — blank when
 * there is none — so a card never dumps trimmed body HTML (headings, etc.).
 */
function bos_services_preprocess_views_view_field(array &$variables) {
  if ($variables['view']->id() !== 'service_children'
    || ($variables['field']->field ?? '') !== 'field_service_public_desc') {
    return;
  }
  $term = $variables['row']->_entity ?? NULL;
  $summary = '';
  if ($term instanceof EntityInterface && $term->hasField('field_service_public_desc')
    && ($item = $term->get('field_service_public_desc')->first())) {
    $summary = trim(strip_tags((string) ($item->summary ?? '')));
  }
  // Plain string — the views-view-field template escapes it once. (Escaping it
  // here too double-encoded apostrophes into a literal &#039;.)
  $variables['output'] = $summary;
}

/**
 * Office/admin roles that see the admin_view services display (top tier).
 */
const BOS_SERVICES_OFFICE_ROLES = [
  'supervisor',
  'administration',
  'site_assistant',
  'site_admin',
  'administrator',
];

/**
 * Crew role that sees the teammate_view services display (middle tier).
 */
const BOS_SERVICES_CREW_ROLES = [
  'teammates',
];

/**
 * Implements hook_entity_view_mode_alter().
 *
 * Same /services/{name} URL, three displays by audience:
 *   - office / admin roles  -> admin_view    (top tier)
 *   - crew (teammates)      -> teammate_view (middle tier)
 *   - public / clients      -> full          (Public page, default)
 * Office is checked first, so a supervisor who is also a teammate gets the office
 * display. Only the canonical full-page render is rewritten — token/admin/embedded
 * renders keep their own view mode.
 */
function bos_services_entity_view_mode_alter(&$view_mode, EntityInterface $entity) {
  if ($view_mode !== 'full'
    || $entity->getEntityTypeId() !== 'taxonomy_term'
    || $entity->bundle() !== 'services') {
    return;
  }
  $roles = \Drupal::currentUser()->getRoles();
  if (array_intersect(BOS_SERVICES_OFFICE_ROLES, $roles)) {
    $view_mode = 'admin_view';
  }
  elseif (array_intersect(BOS_SERVICES_CREW_ROLES, $roles)) {
    $view_mode = 'teammate_view';
  }
}

/**
 * Implements hook_preprocess_HOOK() for taxonomy_term.
 *
 * On the services admin_view page, add the shared audience-admin wrapper class +
 * section-heading CSS so field_group sections read as clear headers. Scoped to
 * admin_view so public/teammate pages are untouched.
 */
function bos_services_preprocess_taxonomy_term(array &$variables) {
  $term = $variables['term'] ?? NULL;
  if (!$term || $term->bundle() !== 'services') {
    return;
  }
  $view_mode = $variables['view_mode'] ?? '';

  // The role-based view-mode switch (full -> admin_view/teammate_view) makes the
  // taxonomy-term template treat this as NOT the canonical page (core keys the
  // `page` flag to the 'full' view mode), so it renders the linked term-name
  // <h2> — a SECOND title (the lower orange "Snow Removal") under the page-title
  // block. These renders ARE the canonical page, so mark them as such to
  // suppress that duplicate heading (public 'full' already has page = TRUE).
  if (in_array($view_mode, ['admin_view', 'teammate_view'], TRUE)) {
    $variables['page'] = TRUE;
  }

  if ($view_mode === 'admin_view') {
    $variables['attributes']['class'][] = 'bos-admin-view';
    $variables['#attached']['library'][] = 'brookstone_olivero/audience_admin';
    return;
  }

  // Public page: the banner renders as a full-bleed hero in the theme's top
  // "hero" region (see bos_services_preprocess_page) — here just hide the raw
  // stacked field so it doesn't also render inside the content.
  if ($view_mode === 'full') {
    if (!$term->get('field_banner_image')->isEmpty() && isset($variables['content']['field_banner_image'])) {
      $variables['content']['field_banner_image']['#access'] = FALSE;
    }
    // Services with a public intake/sales page get a prominent CTA button so the
    // evergreen educational page funnels readers to the conversion page (the
    // sales page is noindex, so the service page is the organic entry point).
    $bundle = $term->hasField('field_service_bundle') ? $term->get('field_service_bundle')->value : '';
    if (isset(BOS_SERVICES_INTAKE_CTA[$bundle])) {
      [$path, $label] = BOS_SERVICES_INTAKE_CTA[$bundle];
      $variables['content']['bo_service_cta'] = [
        '#type' => 'link',
        '#title' => $label,
        '#url' => \Drupal\Core\Url::fromUserInput($path),
        '#attributes' => ['class' => ['button', 'button--primary', 'bo-service-cta']],
        '#weight' => -50,
      ];
    }
  }
}

/**
 * Service bundle => [intake/sales page path, CTA label].
 *
 * The service's evergreen public page shows this button linking to its (noindex)
 * conversion page. Add rows as more public intakes ship.
 */
const BOS_SERVICES_INTAKE_CTA = [
  'sprinkler_winterizing' => ['/winterize', 'Get on the winterizing list'],
];

/**
 * Implements hook_preprocess_HOOK() for page.
 *
 * Render a services term's banner as a full-bleed rotating hero in the top
 * "hero" region (above the breadcrumb) for public viewers — internal viewers get
 * admin_view/teammate_view with no banner, so no hero.
 */
function bos_services_preprocess_page(array &$variables) {
  $term = _bos_services_hero_term();
  if (!$term) {
    return;
  }
  $variables['page']['hero']['bo_hero_banner'] = [
    '#theme' => 'bo_hero_banner',
    '#images' => _bos_services_banner_images($term),
    '#title' => $term->label(),
    '#subtitle' => $term->hasField('field_subtitle') ? (string) $term->get('field_subtitle')->value : '',
  ];
  $variables['#attached']['library'][] = 'brookstone_olivero/bo_hero';
  $variables['#cache']['contexts'][] = 'user.roles';
}

/**
 * Implements hook_preprocess_HOOK() for html.
 *
 * Tag the page when the banner hero is showing so CSS can collapse Olivero's
 * large top padding above the breadcrumb (the hero already provides the top
 * separation).
 */
function bos_services_preprocess_html(array &$variables) {
  if (_bos_services_hero_term()) {
    $variables['attributes']['class'][] = 'has-bo-hero';
  }
}

/**
 * The services term whose public banner hero should render, or NULL.
 *
 * Services term + public viewer (no office/crew role) + has banner image(s).
 */
function _bos_services_hero_term(): ?EntityInterface {
  $term = \Drupal::routeMatch()->getParameter('taxonomy_term');
  if (!$term instanceof EntityInterface || $term->bundle() !== 'services') {
    return NULL;
  }
  if (array_intersect(array_merge(BOS_SERVICES_OFFICE_ROLES, BOS_SERVICES_CREW_ROLES), \Drupal::currentUser()->getRoles())) {
    return NULL;
  }
  return _bos_services_banner_images($term) ? $term : NULL;
}

/**
 * Implements hook_block_access().
 *
 * The banner hero carries the service name as the page's H1, so hide the core
 * page-title block for public viewers on a services term that has a banner
 * (internal viewers get admin_view/teammate_view with no hero, so they keep the
 * normal title).
 */
function bos_services_block_access($block, $operation, AccountInterface $account) {
  if ($operation !== 'view' || $block->getPluginId() !== 'page_title_block') {
    return AccessResult::neutral();
  }
  $term = \Drupal::routeMatch()->getParameter('taxonomy_term');
  $hide = $term instanceof EntityInterface
    && $term->bundle() === 'services'
    && !array_intersect(array_merge(BOS_SERVICES_OFFICE_ROLES, BOS_SERVICES_CREW_ROLES), $account->getRoles())
    && _bos_services_banner_images($term);
  return AccessResult::forbiddenIf((bool) $hide)
    ->addCacheContexts(['user.roles', 'route'])
    ->addCacheableDependency($term instanceof EntityInterface ? $term : $block);
}

/**
 * Build the banner image list [{src, alt}] for a services term, or [] if none.
 */
function _bos_services_banner_images(EntityInterface $term): array {
  if (!$term->hasField('field_banner_image') || $term->get('field_banner_image')->isEmpty()) {
    return [];
  }
  $style = ImageStyle::load('max_2600x2600');
  $images = [];
  foreach ($term->get('field_banner_image') as $item) {
    $file = $item->entity;
    if (!$file) {
      continue;
    }
    $uri = $file->getFileUri();
    $images[] = [
      'src' => $style ? $style->buildUrl($uri) : \Drupal::service('file_url_generator')->generateAbsoluteString($uri),
      'alt' => (string) ($item->alt ?: $term->label()),
    ];
  }
  return $images;
}

/**
 * Implements hook_metatags_attachments_alter().
 *
 * Serve a service's og:image (Facebook share image) through an image style
 * derivative of its Home Page Slide instead of the raw original — a phone-shot
 * slide can be 9+ MB, over Facebook's 8 MB og:image limit, so FB refuses it.
 * The max_1300x1300 derivative is a few hundred KB and well within limits.
 */
function bos_services_metatags_attachments_alter(array &$metatag_attachments) {
  $term = \Drupal::routeMatch()->getParameter('taxonomy_term');
  if (!$term instanceof EntityInterface || $term->bundle() !== 'services'
    || !$term->hasField('field_home_page_slide') || $term->get('field_home_page_slide')->isEmpty()) {
    return;
  }
  $file = $term->get('field_home_page_slide')->entity;
  $style = ImageStyle::load('max_1300x1300');
  if (!$file || !$style) {
    return;
  }
  $url = $style->buildUrl($file->getFileUri());

  // Pass 1: read this page's meta description (to mirror into og:description).
  $desc = '';
  foreach ($metatag_attachments['#attached']['html_head'] ?? [] as $item) {
    if (preg_replace('/_\d+$/', '', $item[1] ?? '') === 'description') {
      $desc = $item[0]['#attributes']['content'] ?? '';
      break;
    }
  }

  // Pass 2: override og:image (styled) + og:description (page-specific) in place;
  // add either if absent. Metatag suffixes og:image as og_image_0.
  $seenImage = FALSE;
  $seenOgDesc = FALSE;
  foreach ($metatag_attachments['#attached']['html_head'] as &$item) {
    $norm = preg_replace('/_\d+$/', '', $item[1] ?? '');
    if ($norm === 'og_image') {
      $item[0]['#attributes']['content'] = $url;
      $seenImage = TRUE;
    }
    elseif ($norm === 'og_description' && $desc !== '') {
      $item[0]['#attributes']['content'] = $desc;
      $seenOgDesc = TRUE;
    }
  }
  unset($item);

  if (!$seenImage) {
    $metatag_attachments['#attached']['html_head'][] = [
      ['#tag' => 'meta', '#attributes' => ['property' => 'og:image', 'content' => $url]],
      'og_image_0',
    ];
  }
  if (!$seenOgDesc && $desc !== '') {
    $metatag_attachments['#attached']['html_head'][] = [
      ['#tag' => 'meta', '#attributes' => ['property' => 'og:description', 'content' => $desc]],
      'og_description',
    ];
  }
}

/**
 * Implements hook_ENTITY_TYPE_view_alter() for taxonomy_term.
 *
 * The view mode above is chosen by the viewer's role, so the render MUST vary by
 * user.roles — otherwise Dynamic Page Cache / render cache can serve one
 * audience's view mode (e.g. the crew training body) to another (the public).
 * hook_entity_view_mode_alter has no render array to tag, so the cache context
 * is added here.
 */
function bos_services_taxonomy_term_view_alter(array &$build, EntityInterface $entity, $display) {
  if ($entity->bundle() === 'services') {
    $build['#cache']['contexts'][] = 'user.roles';
  }
}
