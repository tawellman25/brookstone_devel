<?php

/**
 * @file
 * BOS State — render a state's Top Banner as a full-bleed hero.
 *
 * Mirrors the services banner hero (bos_services): the field_banner_image images
 * render as a full-bleed rotating hero in the theme's top "hero" region (above
 * the breadcrumb) with the state name overlaid, instead of stacked in content.
 * Reuses the shared theme piece brookstone_olivero/bo_hero + bo_hero_banner.
 */

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\image\Entity\ImageStyle;

/**
 * Office/admin roles that see the `admin` state display (top tier).
 */
const BOS_STATE_OFFICE_ROLES = [
  'supervisor',
  'administration',
  'site_assistant',
  'site_admin',
  'administrator',
];

/**
 * Crew role that sees the `teammate` state display (middle tier).
 */
const BOS_STATE_CREW_ROLES = [
  'teammates',
];

/**
 * Implements hook_entity_view_mode_alter().
 *
 * Same /state/{state} URL, three displays by audience (state's view modes are
 * named public / teammate / admin): office -> admin, crew -> teammate, else
 * public. Office is checked first. Only the canonical page render is switched.
 */
function bos_state_entity_view_mode_alter(&$view_mode, EntityInterface $entity) {
  if ($entity->getEntityTypeId() !== 'state'
    || \Drupal::routeMatch()->getRouteName() !== 'entity.state.canonical') {
    return;
  }
  $roles = \Drupal::currentUser()->getRoles();
  if (array_intersect(BOS_STATE_OFFICE_ROLES, $roles)) {
    $view_mode = 'admin';
  }
  elseif (array_intersect(BOS_STATE_CREW_ROLES, $roles)) {
    $view_mode = 'teammate';
  }
  else {
    $view_mode = 'public';
  }
}

/**
 * Implements hook_ENTITY_TYPE_view_alter() for state.
 *
 * The display is chosen by role, so the render MUST vary by user.roles or the
 * render cache could serve one audience's display to another.
 */
function bos_state_state_view_alter(array &$build, EntityInterface $entity, $display) {
  $build['#cache']['contexts'][] = 'user.roles';
}

/**
 * Implements hook_preprocess_HOOK() for page.
 *
 * Put the state's banner hero in the top "hero" region on its canonical page.
 */
function bos_state_preprocess_page(array &$variables) {
  if ($state = _bos_state_banner_entity()) {
    $variables['page']['hero']['bo_hero_banner'] = [
      '#theme' => 'bo_hero_banner',
      '#images' => _bos_state_banner_images($state),
      '#title' => $state->label(),
      '#subtitle' => '',
    ];
    $variables['#attached']['library'][] = 'brookstone_olivero/bo_hero';
  }
}

/**
 * Implements hook_metatags_alter().
 *
 * Give the state page a real meta description + og:description from its own
 * field_state_description (it had none — only the generic global default), and
 * use its banner as the og:image (image-style derivative, FB-safe). This alters
 * the entity's tag VALUES during generation, which sticks on entity pages where
 * editing the rendered attachments does not.
 */
function bos_state_metatags_alter(array &$metatags, array $context) {
  $entity = $context['entity'] ?? NULL;
  if (!$entity instanceof EntityInterface || $entity->getEntityTypeId() !== 'state') {
    return;
  }
  if ($entity->hasField('field_state_description') && !$entity->get('field_state_description')->isEmpty()) {
    // Replace tags with a space (not strip) so block breaks don't glue words.
    $desc = trim(preg_replace('/\s+/', ' ', preg_replace('/<[^>]+>/', ' ', (string) $entity->get('field_state_description')->value)));
    if (mb_strlen($desc) > 300) {
      $desc = rtrim(mb_substr($desc, 0, 297)) . '…';
    }
    if ($desc !== '') {
      $metatags['description'] = $desc;
      $metatags['og_description'] = $desc;
    }
  }
  if ($entity->hasField('field_banner_image') && !$entity->get('field_banner_image')->isEmpty()) {
    $file = $entity->get('field_banner_image')->entity;
    $style = ImageStyle::load('max_1300x1300');
    if ($file && $style) {
      $metatags['og_image'] = $style->buildUrl($file->getFileUri());
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for html.
 *
 * Tag state hero pages so the shared hero CSS collapses Olivero's large top
 * padding above the breadcrumb (same as the services hero pages).
 */
function bos_state_preprocess_html(array &$variables) {
  if (_bos_state_banner_entity()) {
    $variables['attributes']['class'][] = 'has-bo-hero';
  }
}

/**
 * Implements hook_preprocess_HOOK() for eck_entity.
 *
 * Hide the raw stacked banner field on the state render — it shows as the hero.
 */
function bos_state_preprocess_eck_entity(array &$variables) {
  $entity = $variables['entity'] ?? ($variables['elements']['#eck_entity'] ?? NULL);
  if ($entity instanceof EntityInterface && $entity->getEntityTypeId() === 'state'
    && isset($variables['content']['field_banner_image'])) {
    $variables['content']['field_banner_image']['#access'] = FALSE;
  }
}

/**
 * Implements hook_block_access().
 *
 * The hero carries the state name as the page's H1, so hide the core page-title
 * block on a state page that has a banner (avoids a duplicate title).
 */
function bos_state_block_access($block, $operation, AccountInterface $account) {
  if ($operation !== 'view' || $block->getPluginId() !== 'page_title_block') {
    return AccessResult::neutral();
  }
  $state = _bos_state_banner_entity();
  return AccessResult::forbiddenIf((bool) $state)
    ->addCacheContexts(['route'])
    ->addCacheableDependency($state ?: $block);
}

/**
 * The state entity on the current canonical page that has a banner, or NULL.
 */
function _bos_state_banner_entity(): ?EntityInterface {
  if (\Drupal::routeMatch()->getRouteName() !== 'entity.state.canonical') {
    return NULL;
  }
  $state = \Drupal::routeMatch()->getParameter('state');
  if ($state instanceof EntityInterface && $state->hasField('field_banner_image')
    && !$state->get('field_banner_image')->isEmpty()) {
    return $state;
  }
  return NULL;
}

/**
 * Build the banner image list [{src, alt}] for a state, or [].
 */
function _bos_state_banner_images(EntityInterface $state): array {
  $style = ImageStyle::load('max_2600x2600');
  $images = [];
  foreach ($state->get('field_banner_image') as $item) {
    $file = $item->entity;
    if (!$file) {
      continue;
    }
    $uri = $file->getFileUri();
    $images[] = [
      'src' => $style ? $style->buildUrl($uri) : \Drupal::service('file_url_generator')->generateAbsoluteString($uri),
      'alt' => (string) ($item->alt ?: $state->label()),
    ];
  }
  return $images;
}
