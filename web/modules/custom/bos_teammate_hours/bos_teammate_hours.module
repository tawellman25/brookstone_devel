<?php

/**
 * @file
 * BOS Teammate Hours — "Time on Jobs" self-service hours widget.
 */

/**
 * Implements hook_theme().
 */
function bos_teammate_hours_theme($existing, $type, $theme, $path) {
  return [
    'teammate_time_on_jobs' => [
      'variables' => [
        'days' => [],
        'week_total' => '0',
        'week_label' => '',
        'is_current_week' => TRUE,
        'prev_url' => NULL,
        'next_url' => NULL,
        'today_url' => NULL,
      ],
    ],
  ];
}
