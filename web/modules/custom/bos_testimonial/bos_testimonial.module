<?php

/**
 * @file
 * Testimonial moderation + title composition.
 */

declare(strict_types=1);

use Drupal\Core\Entity\EntityInterface;

/** Roles allowed to create an already-approved testimonial. */
const BOS_TESTIMONIAL_OFFICE_ROLES = [
  'administration', 'supervisor', 'site_assistant', 'site_admin', 'administrator',
];

/**
 * Fields nobody outside the office may READ.
 *
 * field_testimonial_scan — the photo of the original handwritten card. It
 *   carries a signature, and often a name, address or phone number the customer
 *   never agreed to publish. The typed quote in field_testimony is the public
 *   artifact; this is only the record of where it came from.
 * field_submitter_email — how we reach someone about their own review, not
 *   something to hand to whoever reads the page.
 *
 * Keeping these off the public displays is presentation, not access: Views,
 * JSON:API and REST each render fields by their own rules. This is the guard
 * that holds whatever the render path.
 */
const BOS_TESTIMONIAL_OFFICE_ONLY_FIELDS = [
  'field_testimonial_scan',
  'field_submitter_email',
];

/**
 * Implements hook_entity_field_access().
 *
 * VIEW only — editing is already behind the entity permissions, and the office
 * form must keep working.
 */
function bos_testimonial_entity_field_access($operation, \Drupal\Core\Field\FieldDefinitionInterface $field_definition, \Drupal\Core\Session\AccountInterface $account, ?\Drupal\Core\Field\FieldItemListInterface $items = NULL) {
  if ($operation !== 'view'
    || $field_definition->getTargetEntityTypeId() !== 'testimonial'
    || !in_array($field_definition->getName(), BOS_TESTIMONIAL_OFFICE_ONLY_FIELDS, TRUE)) {
    return \Drupal\Core\Access\AccessResult::neutral();
  }

  $office = (bool) array_intersect(BOS_TESTIMONIAL_OFFICE_ROLES, $account->getRoles());

  return \Drupal\Core\Access\AccessResult::forbiddenIf(!$office)
    ->addCacheContexts(['user.roles']);
}

/**
 * Implements hook_ENTITY_TYPE_presave() for testimonial.
 *
 * Two jobs:
 *  - Compose the title, so a public submission is identifiable in the admin list
 *    without anybody typing one.
 *  - FORCE `pending` on any record created by a non-office user. The public form
 *    already sets pending, but this is the backstop that holds on every path — a
 *    crafted POST cannot arrive pre-approved.
 */
function bos_testimonial_testimonial_presave(EntityInterface $testimonial) {
  if ($testimonial->isNew() && $testimonial->hasField('field_status')) {
    $account = \Drupal::currentUser();
    $office = (bool) array_intersect(BOS_TESTIMONIAL_OFFICE_ROLES, $account->getRoles());
    if (!$office) {
      $testimonial->set('field_status', 'pending');
    }
    elseif (trim((string) $testimonial->get('field_status')->value) === '') {
      $testimonial->set('field_status', 'pending');
    }
  }

  if (!$testimonial->hasField('title')) {
    return;
  }
  $by = $testimonial->hasField('field_testimonial_by')
    ? trim((string) $testimonial->get('field_testimonial_by')->value) : '';
  $service = NULL;
  if ($testimonial->hasField('field_testimony_service') && !$testimonial->get('field_testimony_service')->isEmpty()) {
    $term = $testimonial->get('field_testimony_service')->entity;
    $service = $term ? $term->label() : NULL;
  }
  $parts = array_filter([$by !== '' ? $by : 'Anonymous', $service]);
  $title = implode(' — ', $parts);
  if (trim((string) $testimonial->label()) === '' || $testimonial->isNew()) {
    $testimonial->set('title', $title);
  }
}

/**
 * Implements hook_entity_operation().
 *
 * Offers "Read the note" on a testimonial that actually has a scan, and only
 * when a vision provider is configured — a dead button is worse than none.
 */
function bos_testimonial_entity_operation(EntityInterface $entity): array {
  if ($entity->getEntityTypeId() !== 'testimonial'
    || !$entity->hasField('field_testimonial_scan')
    || $entity->get('field_testimonial_scan')->isEmpty()
    || !$entity->access('update')) {
    return [];
  }
  if (!\Drupal::service('bos_testimonial.note_vision')->isAvailable()) {
    return [];
  }
  return [
    'read_note' => [
      'title' => t('Read the note'),
      'weight' => 20,
      'url' => \Drupal\Core\Url::fromRoute('bos_testimonial.read_note', ['testimonial' => $entity->id()]),
    ],
  ];
}

/**
 * The public-facing reference for a testimonial: ID0002.
 *
 * Same idea as the backflow device's bf_number — a short, stable, padded
 * handle that reads as an identifier rather than a database row, and sorts
 * properly. It is what the URL and the image filename are built from, so it
 * must never change for a given record: it is derived from the entity id,
 * which does not change.
 */
function _bos_testimonial_ref(int $id): string {
  return 'ID' . str_pad((string) $id, 4, '0', STR_PAD_LEFT);
}

/**
 * Implements hook_token_info().
 */
function bos_testimonial_token_info(): array {
  return [
    'tokens' => [
      'testimonial' => [
        'ref' => [
          'name' => t('Reference'),
          'description' => t('The padded public reference, e.g. ID0002.'),
        ],
      ],
    ],
  ];
}

/**
 * Implements hook_tokens().
 */
function bos_testimonial_tokens($type, $tokens, array $data, array $options, \Drupal\Core\Render\BubbleableMetadata $bubbleable_metadata): array {
  $replacements = [];
  if ($type !== 'testimonial' || empty($data['testimonial'])) {
    return $replacements;
  }
  foreach ($tokens as $name => $original) {
    if ($name === 'ref') {
      $replacements[$original] = _bos_testimonial_ref((int) $data['testimonial']->id());
    }
  }
  return $replacements;
}

/**
 * Implements hook_views_pre_render().
 *
 * Two jobs:
 *
 *  - Attach the review card stylesheet. It was only ever attached by the
 *    /review controller, so the public reviews page has been rendering the
 *    card classes with no CSS behind them.
 *  - On a service page, name the block after the service, and say nothing at
 *    all when that service has no approved reviews yet — an empty "What
 *    customers say" heading reads worse than no heading.
 */
function bos_testimonial_views_pre_render(\Drupal\views\ViewExecutable $view): void {
  if (!in_array($view->id(), ['testimonials', 'service_testimonials'], TRUE)) {
    return;
  }
  $view->element['#attached']['library'][] = 'bos_testimonial/review';

  if ($view->id() !== 'service_testimonials') {
    return;
  }

  if (empty($view->result)) {
    // Drop the heading rather than render it over nothing.
    unset($view->header['area_text_custom']);
    return;
  }

  $tid = $view->args[0] ?? NULL;
  if (!$tid || empty($view->header['area_text_custom'])) {
    return;
  }
  $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($tid);
  if (!$term) {
    return;
  }
  $view->header['area_text_custom']->options['content'] = (string) t('What customers say about @service', [
    '@service' => $term->label(),
  ]);
}
