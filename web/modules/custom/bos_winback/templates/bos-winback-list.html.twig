{#
/**
 * @file
 * Winterize win-back call list. Cards with click-to-call + action buttons.
 * A customer drops off when they get a current-year winterizing WO (recomputed
 * each load) or when a caller marks them "Not interested".
 *
 * Available: rows, target_year, stats.
 */
#}
{% set labels = {
  'left_message': 'Left message',
  'no_answer': 'No answer',
  'reached': 'Reached',
  'declined': 'Not interested'
} %}
<div class="wb">

  <div class="wb__intro">
    <p>{{ stats.total }} customers winterized
      {% if lookback == 1 %}in {{ target_year - 1 }}{% else %}between {{ earliest_year }} and {{ target_year - 1 }}{% endif %}
      have no {{ target_year }} work order yet.
      They drop off this list the moment you create a winterizing work order for them, or when you mark them <em>Not&nbsp;interested</em>.</p>

    <div class="wb__lookback">
      <span class="wb__lookback-label">Look back:</span>
      {% for n in 1..5 %}
        <a class="wb__lookback-opt{{ n == lookback ? ' is-active' : '' }}" href="?years={{ n }}">{{ n }} {{ n == 1 ? 'year' : 'years' }}</a>
      {% endfor %}
    </div>

    <div class="wb__stats">
      <span class="wb__stat wb__stat--won"><strong>{{ stats.won_back }}</strong> won back (no contract)</span>
      <span class="wb__stat"><strong>{{ stats.contracted }}</strong> renewed on contract</span>
      <span class="wb__stat"><strong>{{ stats.came_back }}</strong> of {{ stats.source_total }} came back ({{ stats.pct }}% won back)</span>
      <span class="wb__stat"><strong>{{ stats.total }}</strong> to call</span>
      <span class="wb__stat"><strong>{{ stats.worked }}</strong> worked</span>
      <span class="wb__stat"><strong>{{ stats.no_phone }}</strong> no phone</span>
      <span class="wb__stat"><strong>{{ stats.canceled }}</strong> canceled last yr</span>
    </div>
  </div>

  {% if rows is empty %}
    <p class="wb__empty">Nothing to call right now — everyone from last season either has a work order this year or has been handled.</p>
  {% endif %}

  <div class="wb__list">
    {% for row in rows %}
      {% set name = row.contact_name ?: (row.owner_name ?: row.nickname) %}
      <div class="wb-card{{ row.state ? ' is-worked' : '' }}" data-pid="{{ row.property_id }}">
        <div class="wb-card__main">
          <div class="wb-card__head">
            <a class="wb-card__name" href="/properties/{{ row.property_id }}" target="_blank" rel="noopener">{{ name }}</a>
            {% if row.was_canceled %}<span class="wb-badge wb-badge--cancel">Canceled last yr</span>{% endif %}
            <span class="wb-card__state" data-role="state">{% if row.state %}{{ labels[row.state.outcome] }} · {{ row.state.by }} · {{ row.state.time_ts|date('m/d/Y') }}{% endif %}</span>
          </div>
          <div class="wb-card__meta">
            {{ row.street }}{% if row.city %}, {{ row.city }}{% endif %}{% if row.zones %} · {{ row.zones }} zones{% endif %}{% if row.last_date %} · last {{ row.last_date }}{% endif %}{% if row.last_total %} · ${{ row.last_total }}{% endif %}
          </div>
          <div class="wb-card__contact">
            {% if row.phone %}
              <a class="wb-phone" href="tel:{{ row.phone|replace({' ': '', '-': '', '(': '', ')': '', '.': ''}) }}">📞 {{ row.phone }}</a>
            {% else %}
              <span class="wb-nophone">No phone on file</span>
            {% endif %}
            {% if row.email %}<a class="wb-email" href="mailto:{{ row.email }}">✉ {{ row.email }}</a>{% endif %}
          </div>
        </div>
        <div class="wb-card__actions">
          <a class="button button--primary button--small" target="_blank" rel="noopener"
             href="/admin/content/work_order/add/sprinkler_winterizing?edit[field_property][widget][0][target_id]={{ row.property_id }}">Create WO</a>
          <a class="button button--small" target="_blank" rel="noopener" href="/properties/{{ row.property_id }}/edit">Edit</a>
          <button type="button" class="button button--small wb-mark" data-outcome="left_message">Left msg</button>
          <button type="button" class="button button--small wb-mark" data-outcome="no_answer">No answer</button>
          <button type="button" class="button button--small wb-decline-open wb-mark--decline">Not interested</button>
          <button type="button" class="button button--small wb-reset" data-outcome="clear"{{ row.state ? '' : ' hidden' }}>Reset</button>
        </div>

        {# Inline reason picker — revealed when "Not interested" is clicked. #}
        <div class="wb-decline" hidden>
          <label class="wb-decline__label">Why not interested?
            <select class="wb-decline__reason">
              {% for key, label in reasons %}
                <option value="{{ key }}">{{ label }}</option>
              {% endfor %}
            </select>
          </label>
          <input type="text" class="wb-decline__note" maxlength="500" placeholder="Optional note (e.g. moved to Grand Junction)" />
          <div class="wb-decline__actions">
            <button type="button" class="button button--primary button--small wb-decline-confirm" data-outcome="declined">Remove &amp; save reason</button>
            <button type="button" class="button button--small wb-decline-cancel">Cancel</button>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  {% if declined is not empty %}
    <details class="wb-declined">
      <summary>Declined this season ({{ declined|length }})</summary>
      <div class="wb-declined__list">
        {% for d in declined %}
          <div class="wb-declined__row" data-pid="{{ d.property_id }}">
            <span class="wb-declined__name"><a href="/properties/{{ d.property_id }}" target="_blank" rel="noopener">{{ d.name }}</a></span>
            <span class="wb-declined__where">{{ d.street }}{% if d.city %}, {{ d.city }}{% endif %}</span>
            <span class="wb-declined__reason">{{ d.reason_label }}{% if d.note %} — {{ d.note }}{% endif %}</span>
            <span class="wb-declined__by">{{ d.by }} · {{ d.time }}</span>
            <button type="button" class="button button--small wb-declined-undo" data-pid="{{ d.property_id }}">Undo</button>
          </div>
        {% endfor %}
      </div>
    </details>
  {% endif %}

</div>
