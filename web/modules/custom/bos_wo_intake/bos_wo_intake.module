<?php

/**
 * @file
 * BOS WO Intake (Cowork Connect / Voice-to-WO) — module hooks.
 *
 * Gate 1: REST endpoint (config-driven). Gate 2A: createFromText resolution.
 * Gate 2B: the /wo-intake page + top-level toolbar icon (this file's concern).
 */

use Drupal\Component\Serialization\Json;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;

/**
 * Implements hook_toolbar().
 *
 * A real top-level toolbar tab (icon) that links straight to /wo-intake — the
 * two-tap mobile goal. A menu link under menu_name:admin does NOT render as a
 * standalone toolbar icon (it lands inside the "Manage" flyout); hook_toolbar()
 * is the correct mechanism. Gated by the page permission.
 */
function bos_wo_intake_toolbar(): array {
  $items = [];
  if (!\Drupal::currentUser()->hasPermission('use work order intake')) {
    return $items;
  }
  $items['bos_wo_intake'] = [
    '#type' => 'toolbar_item',
    '#weight' => -15,
    'tab' => [
      '#type' => 'link',
      '#title' => t('New WO'),
      '#url' => Url::fromRoute('bos_wo_intake.intake_page'),
      '#attributes' => [
        'title' => t('Create a Work Order from a spoken or typed command'),
        'class' => ['toolbar-icon', 'toolbar-icon-bos-wo-intake', 'use-ajax'],
        // Open the form in a modal overlay — no full page load.
        'data-dialog-type' => 'modal',
        'data-dialog-options' => Json::encode([
          'width' => 620,
          'dialogClass' => 'wo-intake-dialog',
          'title' => (string) t('New Work Order'),
        ]),
      ],
    ],
    '#attached' => ['library' => ['bos_wo_intake/toolbar_icon', 'core/drupal.dialog.ajax']],
  ];
  return $items;
}

/**
 * Implements hook_help().
 */
function bos_wo_intake_help($route_name, RouteMatchInterface $route_match): string {
  if ($route_name === 'help.page.bos_wo_intake') {
    return '<p>' . t('Create Work Orders from a spoken or typed command at <a href=":u">/wo-intake</a>. Say or type the service, who it is for, and the problem — e.g. "Repair WO for Smith, John on Brookdale — broken sprinkler".', [':u' => '/wo-intake']) . '</p>';
  }
  return '';
}
