<?php

/**
 * @file
 * Contract — Snow Removal.
 *
 * Phase 1: assign a stable Snow Contract number (SNOW-{year}-{id}) and default
 * the template version. Later phases add the print/PDF template + QR (modeled
 * on wo_backflow_testing) and the workflow actions.
 */

use Drupal\Core\Entity\EntityInterface;

/**
 * Implements hook_form_alter().
 *
 * On the snow contract form, show the "Other trigger — specify" text field only
 * when Snow Trigger = the "Other" term (the online form's conditional too).
 */
function contract_snow_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $fo = $form_state->getFormObject();
  if (!$fo instanceof \Drupal\Core\Entity\EntityFormInterface) {
    return;
  }
  $entity = $fo->getEntity();
  if ($entity->getEntityTypeId() !== 'contracts' || $entity->bundle() !== 'snow_removal') {
    return;
  }
  if (!isset($form['field_snow_trigger']) || !isset($form['field_snow_trigger_other'])) {
    return;
  }
  $other = \Drupal::entityTypeManager()->getStorage('taxonomy_term')
    ->loadByProperties(['vid' => 'snow_trigger', 'name' => 'Other']);
  if (!$other) {
    return;
  }
  $tid = (string) reset($other)->id();
  $form['field_snow_trigger_other']['#states'] = [
    'visible' => [
      ':input[name="field_snow_trigger"]' => ['value' => $tid],
    ],
  ];
}

/**
 * Implements hook_ENTITY_TYPE_prepare_form() for contracts.
 *
 * On a NEW snow contract, prefill the per-customer Salt/Mag rates from the
 * Business Settings defaults (Default Salt Rate per lb; Mag Chloride Rate per
 * gal) so the office sees them and can override per customer.
 */
function contract_snow_contracts_prepare_form(\Drupal\Core\Entity\EntityInterface $entity, $operation, \Drupal\Core\Form\FormStateInterface $form_state) {
  if ($entity->bundle() !== 'snow_removal' || !$entity->isNew()) {
    return;
  }
  $bs = \Drupal::service('config_pages.loader')->load('business_setting');
  if (!$bs) {
    return;
  }
  if ($entity->hasField('field_salt_rate') && $entity->get('field_salt_rate')->isEmpty()
      && $bs->hasField('field_default_salt_per_lb') && !$bs->get('field_default_salt_per_lb')->isEmpty()) {
    $entity->set('field_salt_rate', $bs->get('field_default_salt_per_lb')->value);
  }
  if ($entity->hasField('field_mag_rate') && $entity->get('field_mag_rate')->isEmpty()
      && $bs->hasField('field_mag_chloride_rate') && !$bs->get('field_mag_chloride_rate')->isEmpty()) {
    $entity->set('field_mag_rate', $bs->get('field_mag_chloride_rate')->value);
  }
}

/**
 * Implements hook_theme().
 */
function contract_snow_theme($existing, $type, $theme, $path) {
  return [
    'snow_agreement' => [
      'variables' => ['data' => []],
      'template' => 'snow-agreement',
    ],
  ];
}

/**
 * Current Snow Removal Service Agreement template version. Bump when the
 * agreement layout/terms change so executed copies stay tied to their version.
 */
const CONTRACT_SNOW_TEMPLATE_VERSION = 'v1.0';

/**
 * Implements hook_ENTITY_TYPE_presave() for contracts.
 *
 * Default the template version on snow contracts that don't have one yet.
 */
function contract_snow_contracts_presave(EntityInterface $contract) {
  if ($contract->bundle() !== 'snow_removal') {
    return;
  }
  if ($contract->hasField('field_snow_template_version')
      && $contract->get('field_snow_template_version')->isEmpty()) {
    $contract->set('field_snow_template_version', CONTRACT_SNOW_TEMPLATE_VERSION);
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert() for contracts.
 *
 * Assign the contract number once the id exists: SNOW-{year}-{id}. Uses a
 * second save (the id isn't available during presave on insert — same pattern
 * as the AEL sentinel heal in wo_shared).
 */
function contract_snow_contracts_insert(EntityInterface $contract) {
  if ($contract->bundle() !== 'snow_removal') {
    return;
  }
  if (!$contract->hasField('field_snow_contract_number')
      || !$contract->get('field_snow_contract_number')->isEmpty()) {
    return;
  }
  $year = date('Y');
  if ($contract->hasField('field_contract_year') && !$contract->get('field_contract_year')->isEmpty()) {
    $raw = (string) $contract->get('field_contract_year')->value;
    if (preg_match('/(\d{4})/', $raw, $m)) {
      $year = $m[1];
    }
  }
  $contract->set('field_snow_contract_number', 'SNOW-' . $year . '-' . $contract->id());
  $contract->save();
}
