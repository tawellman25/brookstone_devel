<?php

use Drupal\Component\Utility\Html;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\taxonomy\Entity\Term;
use Drupal\views\ViewExecutable;
use Symfony\Component\Validator\ConstraintViolation;
use Symfony\Component\Validator\ConstraintViolationListInterface;

/**
 * Audience view-mode tiers for the material entity (all bundles).
 *
 * One canonical /material/{bundle}/{name} URL, body swapped by the viewer's
 * role — the BOS audience pattern (see __BOS_AI/Governance/ui_patterns.md;
 * reference impls bos_services, bos_backflow_types). Office/admin -> `admin`,
 * crew -> `teammate`, client -> `client`, everyone else -> `full` (Public).
 * A `user.roles` cache context is added on the material render so the page
 * cache can't leak one audience's body to another.
 *
 * View modes are entity-level, so this routing covers every material bundle
 * automatically. A bundle with no display configured for the chosen mode falls
 * back to its `default` display (core behaviour) — harmless, and it lights up
 * as soon as that bundle's admin/teammate/client display is built.
 *
 * Access is NOT touched here (it is per-bundle and deliberately set elsewhere);
 * this only chooses the view mode for whoever is already allowed to view.
 */
const MATERIAL_OFFICE_ROLES = [
  'supervisor',
  'administration',
  'site_assistant',
  'site_admin',
  'administrator',
];
const MATERIAL_CREW_ROLES = ['teammates'];
const MATERIAL_CLIENT_ROLES = ['client'];

/**
 * Field-level VIEW access on the material entity (all bundles).
 *
 * The audience view-mode displays only HIDE cost/supplier fields from the
 * client/public tiers — that is presentation, not security: JSON:API (enabled,
 * read-only), REST, Views and tokens all ignore display config and would return
 * these fields to anyone with entity-view access, since the fields carry no
 * access control of their own. This is the real guard, honoured by every render
 * path, so the catalog can be opened to clients/anon without leaking cost or
 * sourcing data. Matches the display tiers:
 *   OFFICE-ONLY  — cost, pack internals, marketing hero images: office roles only.
 *   OFFICE+CREW  — supplier/manufacturer sourcing, stock, lifecycle, docs.
 * Everything not listed (image, description, specs, price, UOM…) stays public.
 */
const MATERIAL_FIELD_OFFICE_ONLY = [
  'field_cost_integer',
  'field_cost_unit_of_measure',
  'field_supplier_unit_cost',
  'field_banner_images',
  'field_slideshow_image',
  'field_front_promoted',
  'field_pack_qty_mid',
  'field_pack_qty_case',
  'field_pack_qty_mid_label',
  'field_pack_family',
  'field_pack_data_source',
];
const MATERIAL_FIELD_OFFICE_CREW = [
  'field_supplier',
  'field_suppliers',
  'field_supplier_item_number',
  'field_supplier_website_item_link',
  'field_manufacturer_item_number',
  'field_manufacturer_website_item',
  'field_quantity_in_stock',
  'field_lead_time',
  'field_last_restocked_date',
  'field_discontinued',
  'field_replaced_by',
  'field_price_updated',
  'field_material_tags',
  'field_carton_quantity',
  'field_documentation',
  'field_safety_data_sheet',
  'field_instructional_video',
];

/**
 * Implements hook_entity_field_access().
 *
 * Enforce the cost/supplier field protection above on the `material` entity for
 * the VIEW operation only (edit/forms are untouched, so office editing is
 * unaffected). Denies at the field level for the wrong audience, which JSON:API,
 * REST, Views and the render pipeline all honour.
 */
function material_entity_field_access($operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL) {
  if ($operation !== 'view' || $field_definition->getTargetEntityTypeId() !== 'material') {
    return AccessResult::neutral();
  }
  $field = $field_definition->getName();
  $roles = $account->getRoles();
  $is_office = (bool) array_intersect(MATERIAL_OFFICE_ROLES, $roles);
  $is_crew = (bool) array_intersect(MATERIAL_CREW_ROLES, $roles);

  if (in_array($field, MATERIAL_FIELD_OFFICE_ONLY, TRUE)) {
    return AccessResult::forbiddenIf(!$is_office)->addCacheContexts(['user.roles']);
  }
  if (in_array($field, MATERIAL_FIELD_OFFICE_CREW, TRUE)) {
    return AccessResult::forbiddenIf(!($is_office || $is_crew))->addCacheContexts(['user.roles']);
  }
  return AccessResult::neutral();
}

/**
 * Implements hook_entity_view_mode_alter().
 *
 * Route the canonical material page to the audience view mode by role. Only the
 * full-page (`full`) render is rewritten — teaser/token/embedded renders keep
 * their own view mode. Office is checked first (most privileged), then crew,
 * then client; anyone else keeps `full` (Public).
 */
function material_entity_view_mode_alter(string &$view_mode, EntityInterface $entity): void {
  if ($view_mode !== 'full') {
    return;
  }
  $type = $entity->getEntityTypeId();
  $roles = \Drupal::currentUser()->getRoles();

  // Material catalog items (the ECK entity): admin / teammate / client / public.
  if ($type === 'material') {
    if (array_intersect(MATERIAL_OFFICE_ROLES, $roles)) {
      $view_mode = 'admin';
    }
    elseif (array_intersect(MATERIAL_CREW_ROLES, $roles)) {
      $view_mode = 'teammate';
    }
    elseif (array_intersect(MATERIAL_CLIENT_ROLES, $roles)) {
      $view_mode = 'client';
    }
    else {
      // The material entity's public view mode is named `public`, NOT `full`.
      // Leaving $view_mode as 'full' here meant anonymous visitors requested a
      // view mode that is not registered for this entity type at all, so Drupal
      // fell back to `default` — the everything display — and an item page
      // served the internal panel to the public.
      $view_mode = 'public';
    }
    return;
  }

  // Plant characteristics (categories and leaves alike): the full four-tier
  // audience set — office -> admin_view, crew -> teammate_view, signed-in
  // customers -> client_view, everyone else -> full (Public).
  //
  // Clients get their own tier rather than falling through to Public, because
  // an authenticated customer can be shown more than an anonymous visitor.
  if ($type === 'taxonomy_term'
    && in_array($entity->bundle(), ['plant_characteristics', 'plant_character_categories'], TRUE)) {
    if (array_intersect(MATERIAL_OFFICE_ROLES, $roles)) {
      $view_mode = 'admin_view';
    }
    elseif (array_intersect(MATERIAL_CREW_ROLES, $roles)) {
      $view_mode = 'teammate_view';
    }
    elseif (array_intersect(MATERIAL_CLIENT_ROLES, $roles)) {
      $view_mode = 'client_view';
    }
    return;
  }

  // Material category pages (material_types taxonomy vocab): the same four
  // tiers. The client_view display existed and was enabled here long before
  // anything routed to it, so a signed-in customer was served the anonymous
  // Public page; that is fixed below.
  if ($type === 'taxonomy_term' && $entity->bundle() === 'material_types') {
    if (array_intersect(MATERIAL_OFFICE_ROLES, $roles)) {
      $view_mode = 'admin_view';
    }
    elseif (array_intersect(MATERIAL_CREW_ROLES, $roles)) {
      $view_mode = 'teammate_view';
    }
    elseif (array_intersect(MATERIAL_CLIENT_ROLES, $roles)) {
      $view_mode = 'client_view';
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_view_alter() for material.
 *
 * The view mode is chosen by role, so the render MUST vary by user.roles or the
 * page/render cache can serve one audience's body to another.
 */
function material_material_view_alter(array &$build, EntityInterface $entity, $display): void {
  $build['#cache']['contexts'][] = 'user.roles';
}

/**
 * Implements hook_ENTITY_TYPE_view_alter() for taxonomy_term.
 *
 * material_types and plant_characteristics pages are routed by role (above), so
 * their render MUST vary by user.roles or the cache can leak one audience's
 * body to another.
 */
function material_taxonomy_term_view_alter(array &$build, EntityInterface $entity, $display): void {
  if (in_array($entity->bundle(), ['material_types', 'plant_characteristics', 'plant_character_categories'], TRUE)) {
    $build['#cache']['contexts'][] = 'user.roles';
  }
}

/**
 * Implements hook_preprocess_HOOK() for eck_entity.
 *
 * Give the office `admin` render the shared audience-admin wrapper + library so
 * its section headings match the other audience-tiered pages.
 */
function material_preprocess_eck_entity(array &$variables): void {
  if (($variables['entity_type'] ?? '') !== 'material' || ($variables['view_mode'] ?? '') !== 'admin') {
    return;
  }
  $variables['attributes']['class'][] = 'bos-admin-view';
  $variables['#attached']['library'][] = 'brookstone_olivero/audience_admin';
}

/**
 * Implements hook_views_pre_render().
 *
 * The "{Category} Categories" child-category cards EVA (material_children) on a
 * material_types term page: attach the card-grid styling and name the current
 * term in the header. The view lists the term's direct children (arg = current
 * term id); the header only renders when there ARE children, so a leaf category
 * shows nothing.
 */
function material_views_pre_render(ViewExecutable $view): void {
  // The botanical block takes its argument from the route, and the
  // `views_url_path` default plugin declares NO cache context of its own. Left
  // alone, Drupal caches the block once and serves the first plant's botanical
  // name on every material page — correct on a cold cache, wrong an hour later.
  if ($view->id() === 'material_botanical_name') {
    $view->element['#cache']['contexts'][] = 'route';
    $view->element['#attached']['library'][] = 'material/botanical_title';
    return;
  }

  if ($view->id() !== 'material_children') {
    return;
  }
  $view->element['#attached']['library'][] = 'material/material_children';

  if (!empty($view->args[0]) && isset($view->header['area'])
    && ($term = Term::load($view->args[0]))) {
    $view->header['area']->options['content']['value'] =
      '<h2 class="material-children__title">' . Html::escape($term->label()) . ' Categories</h2>';
  }
}

/**
 * Plain-text card text from a rich-text field value.
 *
 * Drops any <style>/<script> block (content included) BEFORE stripping tags, so
 * a stray pasted stylesheet can never dump raw CSS text into a card — 14 of
 * these terms arrived that way on 2026-09-27.
 */
function _material_card_text(string $raw, int $cap): string {
  $raw = preg_replace('#<(style|script)\b[^>]*>.*?</\1>#is', '', $raw);
  // Decode AFTER stripping tags (so an encoded tag cannot become a real one),
  // because the card output is a plain string the template escapes exactly
  // once. Without this a stored &nbsp; — present in 4 of these descriptions —
  // survives strip_tags as literal text and the card prints "&nbsp;" at the
  // reader. \s does not match a decoded non-breaking space, so replace it
  // explicitly before collapsing.
  $text = html_entity_decode(strip_tags($raw), ENT_QUOTES | ENT_HTML5, 'UTF-8');
  $text = str_replace("\xC2\xA0", ' ', $text);
  $text = trim(preg_replace('/\s+/u', ' ', $text));
  if (mb_strlen($text) > $cap) {
    $text = rtrim(mb_substr($text, 0, $cap)) . '…';
  }
  return $text;
}

/**
 * Implements hook_preprocess_HOOK() for views_view_field.
 *
 * The material_children card blurb. field_short_description is the line written
 * FOR this card — the same field that is already the list teaser on five other
 * BOS vocabularies (backflow device types and uses, spraying locations, plant
 * characteristic categories, hardiness zones). Material categories were the odd
 * one out: the blurb was derived from the BODY copy cut at 160 characters, so a
 * card opened with the first sentence of the essay, truncated mid-sentence, and
 * frequently never said what the category was — "A shade tree is the
 * highest-value plant decision anybody makes on a property, and it is the one
 * with the longest tail. Everything else in a yard can be changed …" where the
 * written teaser reads "The big ones — forty to seventy feet at maturity…".
 *
 * The teaser is rendered WHOLE. Several legitimate ones run past 160 characters
 * (155–191 across this branch), and clipping a purpose-written one-liner is the
 * bug this replaces; the 300 cap is a guard against a pasted essay, not a
 * trim of intended copy. A category with no teaser yet keeps the old behaviour,
 * so nothing regresses while the catalogue is filled in.
 *
 * Plain string — the template escapes it once.
 */
function material_preprocess_views_view_field(array &$variables): void {
  if (($variables['view']->id() ?? '') !== 'material_children'
    || ($variables['field']->field ?? '') !== 'field_public_description') {
    return;
  }
  $term = $variables['row']->_entity ?? NULL;
  $blurb = '';
  if ($term instanceof EntityInterface) {
    if ($term->hasField('field_short_description') && ($teaser = $term->get('field_short_description')->first())) {
      $blurb = _material_card_text((string) $teaser->value, 300);
    }
    if ($blurb === '' && $term->hasField('field_public_description')
      && ($item = $term->get('field_public_description')->first())) {
      $blurb = _material_card_text((string) $item->value, 160);
    }
  }
  $variables['output'] = $blurb;
}

/**
 * Implements hook_form_alter().
 *
 * material.pavers only: show field_setback (Setback / Batter) exclusively when
 * Hardscape Type = "Wall Block". Core #states (NOT conditional_fields, which
 * strips values on edit). The Wall Block term id is resolved DYNAMICALLY by
 * name — never hardcoded. If the term or fields aren't present, leave setback
 * always-visible (fail open).
 */
function material_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $object = $form_state->getFormObject();
  if (!$object instanceof EntityFormInterface) {
    return;
  }
  $entity = $object->getEntity();
  if (!$entity instanceof EntityInterface || $entity->getEntityTypeId() !== 'material' || $entity->bundle() !== 'pavers') {
    return;
  }
  if (!isset($form['field_setback'], $form['field_hardscape_type'])) {
    return;
  }
  $terms = \Drupal::entityTypeManager()->getStorage('taxonomy_term')
    ->loadByProperties(['vid' => 'hardscape_types', 'name' => 'Wall Block']);
  if (!$terms) {
    return;
  }
  $tid = (string) reset($terms)->id();
  $form['field_setback']['#states'] = [
    'visible' => [
      ':input[name="field_hardscape_type"]' => ['value' => $tid],
    ],
  ];
}

/**
 * Implements hook_theme().
 */
function material_theme($existing, $type, $theme, $path) {
  return [
    'views_view_fields__material_botanical_name' => [
      'base hook' => 'views_view_fields',
    ],
  ];
}

/**
 * Normalise one cultivar list into roman, single-straight-quoted names.
 *
 * Stored values are a comma list already wrapped in typographic quotes —
 * "'Compacta', 'Tovar'" — so re-quoting blindly would double them. Each name is
 * stripped of any surrounding quote (straight or typographic) and re-quoted
 * once. An apostrophe INSIDE a name survives, because only the outermost pair is
 * removed.
 */
function _material_format_cultivars(string $raw): string {
  $out = [];
  foreach (explode(',', $raw) as $name) {
    $name = trim($name);
    // Strip one leading and one trailing quote of any flavour.
    $name = preg_replace('/^[\'"\x{2018}\x{2019}\x{201C}\x{201D}]+/u', '', $name);
    $name = preg_replace('/[\'"\x{2018}\x{2019}\x{201C}\x{201D}]+$/u', '', $name);
    $name = trim($name);
    if ($name === '') {
      continue;
    }
    $out[] = "'" . \Drupal\Component\Utility\Html::escape($name) . "'";
  }
  return implode(', ', $out);
}

/**
 * Compose the botanical name: italic, with the hybrid mark left roman.
 *
 * `field_plant_species` already holds the FULL binomial on this catalogue
 * ("Pinus edulis"), so genus is only used when species is missing. Per ICNCP the
 * multiplication sign is not part of the italicised name, so the string is split
 * on it and each side italicised separately. A literal " x " used as a hybrid
 * mark is promoted to U+00D7.
 */
function _material_format_botanical(string $species, string $genus): string {
  $raw = trim($species) !== '' ? trim($species) : trim($genus);
  if ($raw === '') {
    return '';
  }

  // Several records list more than one species ("Thuja occidentalis, Thuja
  // plicata"). Each is italicised on its own so the separating comma stays
  // roman.
  $names = [];
  foreach (explode(',', $raw) as $one) {
    $one = trim($one);
    if ($one === '') {
      continue;
    }
    $names[] = _material_italicise_name($one);
  }
  return implode(', ', array_filter($names));
}

/**
 * Italicise one botanical name, leaving what convention keeps roman.
 *
 * Rank abbreviations (spp., var., subsp., f., cv.) and the hybrid × are NOT part
 * of the italicised name, so "Acer spp." is *Acer* spp., not *Acer spp.*
 */
function _material_italicise_name(string $name): string {
  // A lone "x" between words is a hybrid mark typed the easy way.
  $name = preg_replace('/\\s+[xX]\\s+/u', ' × ', $name);

  $roman = ['spp.', 'sp.', 'var.', 'subsp.', 'ssp.', 'cv.', 'f.', '×'];
  $out = [];
  $italic = [];
  $flush = static function () use (&$italic, &$out): void {
    if ($italic) {
      $out[] = '<em>' . \Drupal\Component\Utility\Html::escape(implode(' ', $italic)) . '</em>';
      $italic = [];
    }
  };
  foreach (preg_split('/\\s+/u', $name) as $word) {
    if ($word === '') {
      continue;
    }
    if (in_array(mb_strtolower($word), $roman, TRUE)) {
      $flush();
      $out[] = \Drupal\Component\Utility\Html::escape($word);
      continue;
    }
    $italic[] = $word;
  }
  $flush();

  return implode(' ', $out);
}

/**
 * Implements hook_preprocess_HOOK() for the botanical title block.
 */
function material_preprocess_views_view_fields__material_botanical_name(array &$variables) {
  $row = $variables['row'] ?? NULL;
  $view = $variables['view'] ?? NULL;
  if (!$row || !$view) {
    return;
  }
  $value = static function (string $field) use ($view, $row): string {
    if (empty($view->field[$field])) {
      return '';
    }
    return trim(strip_tags((string) $view->field[$field]->advancedRender($row)));
  };

  $variables['bo_common'] = $value('title');
  $variables['bo_botanical'] = \Drupal\Core\Render\Markup::create(
    _material_format_botanical($value('field_plant_species'), $value('field_plant_genus'))
  );
  $cultivars = _material_format_cultivars($value('field_cultivar'));
  $variables['bo_cultivars'] = $cultivars === '' ? '' : \Drupal\Core\Render\Markup::create($cultivars);
}

/**
 * Implements hook_pathauto_alias_alter().
 *
 * Keeps every material URL under /material/, whatever its pattern does.
 *
 * Bundles whose pathauto pattern builds the path from a category reference —
 * `[material:field_material_category:entity:url:path]/[material:title]` — have
 * no hardcoded prefix to fall back on. With the category unset the token clears
 * and the alias collapses to /{title} at the site root, which was measured, not
 * assumed. decorative_rock does not have this problem because its pattern
 * hardcodes `material/rock/` in front of its token.
 *
 * Rather than give that up and hardcode the hierarchy into the pattern (which
 * is what made Trees and Shrubs need hand-edited patterns when they moved under
 * Plants), the floor lives here: an alias that escaped /material/ is rebuilt
 * from the bundle's OWN category term — the material_types term whose
 * field_material_bundle names this bundle. That term is also the page the item
 * belongs on, and it is resolved at run time, so the fallback follows the
 * taxonomy instead of restating it.
 *
 * The practical effect is that the category field can ship before the data
 * entry: an item with no category keeps exactly the URL it has today, and moves
 * to its nested URL — old one redirecting — when the office assigns one.
 */
function material_pathauto_alias_alter(&$alias, array $context): void {
  $entity = $context['data']['material'] ?? NULL;
  if (!$entity instanceof EntityInterface || $entity->getEntityTypeId() !== 'material') {
    return;
  }
  // The normal case: the pattern produced a path under /material/.
  if (str_starts_with((string) $alias, '/material/')) {
    return;
  }

  $prefix = _material_bundle_category_path($entity->bundle());
  if ($prefix === NULL) {
    // No category term claims this bundle, so there is nothing to rebuild from.
    // Leave the alias alone rather than invent a prefix.
    return;
  }

  $alias = rtrim($prefix, '/') . '/' . ltrim((string) $alias, '/');
}

/**
 * The URL path of the material_types term that represents a material bundle.
 *
 * @param string $bundle
 *   A material bundle machine name.
 *
 * @return string|null
 *   The term's alias (e.g. /material/plants/trees), or NULL if no term claims
 *   the bundle.
 */
function _material_bundle_category_path(string $bundle): ?string {
  $cache = &drupal_static(__FUNCTION__, []);
  if (array_key_exists($bundle, $cache)) {
    return $cache[$bundle];
  }

  $cache[$bundle] = NULL;
  $ids = \Drupal::entityQuery('taxonomy_term')
    ->accessCheck(FALSE)
    ->condition('vid', 'material_types')
    ->condition('field_material_bundle', $bundle)
    ->range(0, 1)
    ->execute();
  if ($ids) {
    $path = \Drupal::service('path_alias.manager')
      ->getAliasByPath('/taxonomy/term/' . reset($ids));
    // getAliasByPath returns the system path unchanged when there is no alias;
    // that is not a category path, so treat it as no answer.
    if (!str_starts_with($path, '/taxonomy/term/')) {
      $cache[$bundle] = $path;
    }
  }

  return $cache[$bundle];
}

/**
 * Implements hook_entity_validate().
 *
 * BOS invariants for material_suppliers:
 * - Exactly one row per (field_material, field_supplier) pair.
 * - If order unit != cost unit, pack quantity must be > 0.
 * - Minimum order quantity (if set) must be > 0.
 * - Supplier unit cost (if set) must be > 0.
 * - Supplier override do_not_use blocks save (effective status).
 *
 * No UI-only enforcement. No Work Order mutations.
 */
function material_entity_validate(EntityInterface $entity, ConstraintViolationListInterface $violations): void {
  if ($entity->getEntityTypeId() !== 'material_suppliers') {
    return;
  }

  // Required relationships.
  if (!$entity->hasField('field_material') || $entity->get('field_material')->isEmpty()) {
    $violations->add(new ConstraintViolation(
      'Material is required.',
      'Material is required.',
      [],
      $entity,
      'field_material',
      NULL
    ));
    return;
  }

  if (!$entity->hasField('field_supplier') || $entity->get('field_supplier')->isEmpty()) {
    $violations->add(new ConstraintViolation(
      'Supplier is required.',
      'Supplier is required.',
      [],
      $entity,
      'field_supplier',
      NULL
    ));
    return;
  }

  $material_id = (int) $entity->get('field_material')->target_id;
  $supplier_id = (int) $entity->get('field_supplier')->target_id;

  // Uniqueness: one record per (material, supplier).
  $storage = \Drupal::entityTypeManager()->getStorage('material_suppliers');

  $query = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('field_material', $material_id)
    ->condition('field_supplier', $supplier_id);

  if (!$entity->isNew()) {
    $query->condition('id', (int) $entity->id(), '<>');
  }

  $existing = $query->range(0, 1)->execute();
  if (!empty($existing)) {
    $violations->add(new ConstraintViolation(
      'This Material ↔ Supplier link already exists. Only one record is allowed per (Material, Supplier) pair.',
      'This Material ↔ Supplier link already exists. Only one record is allowed per (Material, Supplier) pair.',
      [],
      $entity,
      'field_supplier',
      NULL
    ));
  }

  // UOM governance: if order unit != cost UOM then pack qty required (>0).
  $order_uom = NULL;
  $cost_uom = NULL;

  if ($entity->hasField('field_order_unit') && !$entity->get('field_order_unit')->isEmpty()) {
    $order_uom = (string) $entity->get('field_order_unit')->value;
  }
  if ($entity->hasField('field_cost_unit_of_measure') && !$entity->get('field_cost_unit_of_measure')->isEmpty()) {
    $cost_uom = (string) $entity->get('field_cost_unit_of_measure')->value;
  }

  if ($order_uom && $cost_uom && $order_uom !== $cost_uom) {
    $pack_qty = NULL;
    if ($entity->hasField('field_pack_quantity') && !$entity->get('field_pack_quantity')->isEmpty()) {
      $pack_qty = (int) $entity->get('field_pack_quantity')->value;
    }
    if (empty($pack_qty) || $pack_qty <= 0) {
      $violations->add(new ConstraintViolation(
        'Pack Quantity is required when Order Unit differs from Cost Unit of Measure.',
        'Pack Quantity is required when Order Unit differs from Cost Unit of Measure.',
        [],
        $entity,
        'field_pack_quantity',
        NULL
      ));
    }
  }

  // Minimum order quantity sanity (if set).
  if ($entity->hasField('field_minimum_order_quantity') && !$entity->get('field_minimum_order_quantity')->isEmpty()) {
    $min_qty = (int) $entity->get('field_minimum_order_quantity')->value;
    if ($min_qty <= 0) {
      $violations->add(new ConstraintViolation(
        'Minimum Order Quantity must be greater than 0 if provided.',
        'Minimum Order Quantity must be greater than 0 if provided.',
        [],
        $entity,
        'field_minimum_order_quantity',
        NULL
      ));
    }
  }

  // Supplier unit cost sanity (if set).
  if ($entity->hasField('field_supplier_unit_cost') && !$entity->get('field_supplier_unit_cost')->isEmpty()) {
    $cost_raw = $entity->get('field_supplier_unit_cost')->value;
    $cost = is_numeric($cost_raw) ? (float) $cost_raw : NULL;

    if ($cost === NULL) {
      $violations->add(new ConstraintViolation(
        'Supplier Unit Cost must be a valid number.',
        'Supplier Unit Cost must be a valid number.',
        [],
        $entity,
        'field_supplier_unit_cost',
        NULL
      ));
    }
    elseif ($cost <= 0) {
      $violations->add(new ConstraintViolation(
        'Supplier Unit Cost must be greater than 0 if provided.',
        'Supplier Unit Cost must be greater than 0 if provided.',
        [],
        $entity,
        'field_supplier_unit_cost',
        NULL
      ));
    }
  }

  // Supplier effective status enforcement (do_not_use blocks).
  /** @var \Drupal\material\Service\MaterialSourcing $sourcing */
  $sourcing = \Drupal::service('material.sourcing');
  $effective_status = $sourcing->getEffectiveSupplierStatus($entity);

  if ($effective_status === 'do_not_use') {
    $violations->add(new ConstraintViolation(
      'This supplier is marked Do Not Use for this material (effective status).',
      'This supplier is marked Do Not Use for this material (effective status).',
      [],
      $entity,
      'field_supplier_status_override',
      NULL
    ));
  }
}

/**
 * Implements hook_entity_insert().
 */
function material_entity_insert(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() === 'material_suppliers') {
    material_sync_material_pricing_from_supplier_links($entity);
  }
}

/**
 * Implements hook_entity_update().
 */
function material_entity_update(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() === 'material_suppliers') {
    material_sync_material_pricing_from_supplier_links($entity);
  }
}

/**
 * Implements hook_entity_delete().
 */
function material_entity_delete(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() === 'material_suppliers') {
    material_sync_material_pricing_from_supplier_links($entity);
  }
}

/**
 * Recomputes:
 * - Material.field_cost_integer as max(field_supplier_unit_cost) across eligible links.
 * - Material.field_installed_price as (field_cost_integer * business_setting.field_markup) when possible.
 *
 * Eligibility:
 * - link has numeric supplier unit cost > 0
 * - effective status != do_not_use
 *
 * Notes:
 * - Updates ONLY Material current/default fields.
 * - Never touches any Work Order snapshot data.
 * - If no eligible supplier costs exist, does nothing (does NOT zero out fields).
 */
function material_sync_material_pricing_from_supplier_links(EntityInterface $material_supplier_link): void {
  if ($material_supplier_link->getEntityTypeId() !== 'material_suppliers') {
    return;
  }
  if (!$material_supplier_link->hasField('field_material') || $material_supplier_link->get('field_material')->isEmpty()) {
    return;
  }

  $material_id = (int) $material_supplier_link->get('field_material')->target_id;
  if ($material_id <= 0) {
    return;
  }

  // Load the material entity.
  $material = \Drupal::entityTypeManager()->getStorage('material')->load($material_id);
  if (!$material) {
    return;
  }

  // Cost field is expected on most bundles (BOS default cost source of truth).
  if (!$material->hasField('field_cost_integer')) {
    return;
  }

  // Load all supplier link rows for this material.
  $link_ids = \Drupal::entityTypeManager()->getStorage('material_suppliers')
    ->getQuery()
    ->accessCheck(FALSE)
    ->condition('field_material', $material_id)
    ->execute();

  if (empty($link_ids)) {
    return;
  }

  $links = \Drupal::entityTypeManager()->getStorage('material_suppliers')->loadMultiple($link_ids);

  /** @var \Drupal\material\Service\MaterialSourcing $sourcing */
  $sourcing = \Drupal::service('material.sourcing');

  $max_cost = NULL;

  foreach ($links as $link) {
    if (!$link->hasField('field_supplier_unit_cost') || $link->get('field_supplier_unit_cost')->isEmpty()) {
      continue;
    }

    // Skip do_not_use effective status.
    $effective_status = $sourcing->getEffectiveSupplierStatus($link);
    if ($effective_status === 'do_not_use') {
      continue;
    }

    $raw = $link->get('field_supplier_unit_cost')->value;
    if (!is_numeric($raw)) {
      continue;
    }

    $cost = (float) $raw;
    if ($cost <= 0) {
      continue;
    }

    if ($max_cost === NULL || $cost > $max_cost) {
      $max_cost = $cost;
    }
  }

  // If there were no eligible supplier costs, do not change the material.
  if ($max_cost === NULL) {
    return;
  }

  // Normalize to 2 decimals since supplier unit cost is scale 2.
  $max_cost = round($max_cost, 2);

  // Track whether we need to save at all.
  $dirty = FALSE;

  // Update field_cost_integer if changed.
  $current_cost = NULL;
  if (!$material->get('field_cost_integer')->isEmpty() && is_numeric($material->get('field_cost_integer')->value)) {
    $current_cost = round((float) $material->get('field_cost_integer')->value, 2);
  }
  if ($current_cost === NULL || $current_cost !== $max_cost) {
    $material->set('field_cost_integer', $max_cost);
    $dirty = TRUE;
  }

  // Update field_installed_price if possible:
  // installed_price = max_cost * business_setting.field_markup
  if ($material->hasField('field_installed_price')) {
    $markup = material_get_business_markup();
    if ($markup !== NULL && $markup > 0) {
      $installed = $max_cost * $markup;

      // If installed price field is integer, round to nearest whole number.
      $field_def = $material->getFieldDefinition('field_installed_price');
      if ($field_def && $field_def->getType() === 'integer') {
        $installed = (float) round($installed);
      }
      else {
        $installed = (float) round($installed, 2);
      }

      $current_installed = NULL;
      if (!$material->get('field_installed_price')->isEmpty() && is_numeric($material->get('field_installed_price')->value)) {
        // Normalize compare to 2 decimals (or whole numbers if integer).
        if ($field_def && $field_def->getType() === 'integer') {
          $current_installed = (float) (int) $material->get('field_installed_price')->value;
        }
        else {
          $current_installed = (float) round((float) $material->get('field_installed_price')->value, 2);
        }
      }

      if ($current_installed === NULL || $current_installed !== $installed) {
        $material->set('field_installed_price', $installed);
        $dirty = TRUE;
      }
    }
  }

  if (!$dirty) {
    return;
  }

  // Save once, only when changes exist.
  $material->save();
}

/**
 * Reads business_setting.field_markup from Config Pages.
 *
 * Returns NULL if the config page or field is missing/empty.
 */
function material_get_business_markup(): ?float {
  if (!\Drupal::hasService('config_pages.loader')) {
    return NULL;
  }

  $business_setting = \Drupal::service('config_pages.loader')->load('business_setting');
  if (!$business_setting || !$business_setting->hasField('field_markup') || $business_setting->get('field_markup')->isEmpty()) {
    return NULL;
  }

  $raw = $business_setting->get('field_markup')->value;
  if (!is_numeric($raw)) {
    return NULL;
  }

  $markup = (float) $raw;
  if ($markup <= 0) {
    return NULL;
  }

  return $markup;
}
