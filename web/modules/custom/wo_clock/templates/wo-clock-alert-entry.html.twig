{#
/**
 * @file
 * A single open-clock-in row, used inside the alert region (and mirrored by the
 * JS modal). Reusable across both surfaces.
 *
 * Available variables:
 * - entry: { entry_id, wo_id, wo_url, property, start_us, start_local, now_local, ago }
 */
#}
<div class="wo-clock-entry" data-entry-id="{{ entry.entry_id }}">
  <div class="wo-clock-entry__info">
    {% if entry.wo_url %}
      <a class="wo-clock-entry__property wo-clock-entry__property--link" href="{{ entry.wo_url }}" target="_blank" rel="noopener">{{ entry.property }}</a>
    {% else %}
      <span class="wo-clock-entry__property">{{ entry.property }}</span>
    {% endif %}
    <span class="wo-clock-entry__meta">{{ entry.ago }} · started {{ entry.start_us }}</span>
  </div>
  <div class="wo-clock-entry__actions">
    <button type="button" class="wo-clock-entry__btn wo-clock-entry__btn--close-now"
            data-wo-clock-action="close" data-entry-id="{{ entry.entry_id }}">Close now</button>
    <button type="button" class="wo-clock-entry__btn wo-clock-entry__btn--close-time"
            data-wo-clock-action="close-time" data-entry-id="{{ entry.entry_id }}">Close at specific time</button>
    <span class="wo-clock-entry__time-picker" hidden>
      <input type="datetime-local" class="wo-clock-entry__time-input"
             {% if entry.start_local %}value="{{ entry.start_local }}"{% endif %}
             {% if entry.now_local %}max="{{ entry.now_local }}"{% endif %}
             aria-label="Clock-out date and time">
      <button type="button" class="wo-clock-entry__btn wo-clock-entry__btn--apply-time"
              data-wo-clock-action="apply-time" data-entry-id="{{ entry.entry_id }}">Set</button>
    </span>
  </div>
</div>
