{#
/**
 * @file
 * WO Clock block — renders one of three states.
 *
 * Available variables:
 * - state: 'a' (not clocked in) | 'b' (clocked in here) | 'c' (clocked in elsewhere)
 * - wo_id: the current work order id
 * - current_entry: { entry_id, start_us, elapsed } (state b)
 * - open_entries: list of themed wo_clock_alert_entry render arrays (state c)
 * - target_hours: null, or { target_label, clocked_label, delta_label, pct, over,
 *   source: null|{ hours_label, date } } — cleanups only (wo_shared).
 */
#}
<div class="wo-clock" data-wo-id="{{ wo_id }}">

  {#
    Target hours (cleanups). Above the buttons on purpose: the crew should see
    the number BEFORE they start, the same reason the pre-emergent season flag
    sits up here. "Clocked" counts closed entries only, so it is hours banked,
    not a guess; the bar caps at 100% and turns red once the target is passed.
  #}
  {% if target_hours %}
    <div class="wo-clock__target{% if target_hours.over %} wo-clock__target--over{% endif %}" role="status">
      <p class="wo-clock__target-main">
        <span class="wo-clock__target-label">Target</span> <strong>{{ target_hours.target_label }} hrs</strong>
        <span class="wo-clock__target-sep">·</span>
        <span class="wo-clock__target-label">Clocked</span> <strong>{{ target_hours.clocked_label }} hrs</strong>
        {% if target_hours.over %}<span class="wo-clock__target-delta">{{ target_hours.delta_label }} over</span>{% endif %}
      </p>
      <span class="wo-clock__target-bar" aria-hidden="true"><span class="wo-clock__target-fill" style="width: {{ target_hours.pct }}%"></span></span>
      {% if target_hours.source %}
        <p class="wo-clock__target-src">Last time: {{ target_hours.source.hours_label }} hrs on {{ target_hours.source.date }}</p>
      {% endif %}
    </div>
  {% endif %}

  {% if state == 'c' and open_entries %}
    <div class="wo-clock__alert" role="alert">
      <p class="wo-clock__alert-title">Heads up — you're still clocked in elsewhere:</p>
      {% for entry in open_entries %}
        {{ entry }}
      {% endfor %}
    </div>
  {% endif %}

  {% if state == 'b' and current_entry %}
    <p class="wo-clock__status">Clocked in at {{ current_entry.start_us }} ({{ current_entry.elapsed }} elapsed)</p>
    <button type="button" class="wo-clock__btn wo-clock__btn--out"
            data-wo-clock-action="out" data-entry-id="{{ current_entry.entry_id }}">Clock Out</button>
  {% elseif state == 'c' %}
    <button type="button" class="wo-clock__btn wo-clock__btn--in"
            data-wo-clock-action="in" data-wo-id="{{ wo_id }}">Clock In on this WO</button>
  {% else %}
    <button type="button" class="wo-clock__btn wo-clock__btn--in"
            data-wo-clock-action="in" data-wo-id="{{ wo_id }}">Clock In</button>
  {% endif %}

  {#
    Crew clock — the whole point is that it creates one REAL entry per person,
    so everything below stays independent afterwards: someone leaving early
    closes only their own row, and a late arrival uses the ordinary button
    above and gets their own start time.
  #}
  <div class="wo-clock__crew" data-wo-clock-crew>

    {% if crew_open %}
      <p class="wo-clock__crew-status">
        On the clock here ({{ crew_open|length }}):
        {% for p in crew_open %}{{ p.name }} ({{ p.start_us }}){% if not loop.last %}, {% endif %}{% endfor %}
      </p>
      <button type="button" class="wo-clock__btn wo-clock__btn--crew-out"
              data-wo-clock-action="crew-out" data-wo-id="{{ wo_id }}">Clock Out Crew ({{ crew_open|length }})</button>
    {% endif %}

    <button type="button" class="wo-clock__btn wo-clock__btn--crew-in"
            data-wo-clock-action="crew-in" data-wo-id="{{ wo_id }}">Clock In Crew</button>

  </div>

  {#
    Crew picker — a real modal, not an inline panel. It is used on a phone,
    outdoors, often in gloves: a full-width overlay with large tick targets
    beats a panel that pushes the page around and can scroll out of view
    mid-selection.

    Nobody is pre-ticked. Scheduling assigns ONE person per work order (the
    route driver, not the crew), so pre-ticking it implied a crew that was
    never recorded — and pre-ticking a whole 19-person crew would turn one
    careless press into 19 false entries. The foreman taps who is actually
    there, which is the only thing anyone actually knows.
  #}
  <div class="wo-clock__modal" data-wo-clock-crew-panel hidden>
    <div class="wo-clock__modal-backdrop" data-wo-clock-action="crew-cancel"></div>
    <div class="wo-clock__modal-box" role="dialog" aria-modal="true" aria-label="Who is on site?">
      <h3 class="wo-clock__modal-title">Who is on site?</h3>
      <p class="wo-clock__crew-help">Tick everyone here now. You are confirming these people are on the job.</p>
      <div class="wo-clock__crew-list" data-wo-clock-crew-list></div>
      {#
        Sits BELOW the list and ABOVE the buttons on purpose. The list scrolls
        inside the box while this and the actions stay pinned, so it is on
        screen at the moment the foreman commits — and it answers the question
        he actually has then: the roster only holds his own crew, so a helper
        borrowed from another crew will not be on it.
      #}
      <p class="wo-clock__crew-note">Anyone on site who is not on this list needs to clock in on their own.</p>
      <div class="wo-clock__crew-actions">
        <button type="button" class="wo-clock__btn wo-clock__btn--crew-confirm"
                data-wo-clock-action="crew-in-confirm" data-wo-id="{{ wo_id }}">Clock In Selected</button>
        <button type="button" class="wo-clock__btn wo-clock__btn--crew-cancel"
                data-wo-clock-action="crew-cancel">Cancel</button>
      </div>
    </div>
  </div>

  <span class="wo-clock__working" hidden>Working…</span>
  <div class="wo-clock__error" role="alert" hidden></div>
</div>
