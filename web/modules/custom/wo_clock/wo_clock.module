<?php

/**
 * @file
 * WO Clock — clock-in/out UX with silent GPS capture.
 *
 * Replaces the flag-based timer UI on the WO page (the flag path stays
 * functional during transition — see wo_timer_flag_update). This module owns:
 *   - hook_theme for the block + alert-entry templates
 *   - the distance-from-property presave calculation (silent)
 *   - the WO view integration (hides the timer flag render, renders the clock
 *     UI inline where the flag was — covers all WO bundles in one place)
 *
 * The heavy lifting lives in \Drupal\wo_clock\Service\WoClockService and
 * \Drupal\wo_clock\Controller\WoClockController.
 */

use Drupal\Core\Entity\EntityInterface;

/**
 * Implements hook_theme().
 */
function wo_clock_theme($existing, $type, $theme, $path) {
  return [
    'wo_clock_block' => [
      'variables' => [
        'state' => 'a',
        'wo_id' => 0,
        'current_entry' => NULL,
        'open_entries' => [],
        'urls' => [],
      ],
    ],
    'wo_clock_alert_entry' => [
      'variables' => [
        'entry' => [],
      ],
    ],
    // Card row for the per-teammate time-entry breakdown (wo_time_clock_entries,
    // embedded per teammate by wo_hours_grouping on the WO page).
    'views_view_fields__wo_time_clock_entries' => [
      'base hook' => 'views_view_fields',
    ],
  ];
}

/**
 * Implements hook_ENTITY_TYPE_presave() for wo_time_clock.
 *
 * Silent distance-from-property calculation. When a clock-in/out location and
 * the parent WO's property geofield are both present, store the Haversine
 * distance in feet. Any lookup failure leaves the distance null and the save
 * proceeds — never blocks. (Phase 1 guards run in wo_total_time's presave; if
 * one throws, the save aborts before this matters.)
 */
function wo_clock_wo_time_clock_presave(EntityInterface $entity) {
  if ($entity->bundle() !== 'entry') {
    return;
  }

  // Manual attribution catch-all. A NEW entry created via the standard entity
  // form — the "Enter Manually" button (/wo_time_clock/add/entry) or the admin
  // add form — that no known code path stamped is a manual entry. Every managed
  // path sets field_source first (flag / wo_clock_button / signoff_reconciliation)
  // or a transient marker (_wo_clock_write from WoClockService,
  // _signoff_reconciliation from sign-off), so an empty field_source with none
  // of those flags on an insert can only be a hand save.
  if ($entity->isNew()
    && $entity->hasField('field_source') && $entity->get('field_source')->isEmpty()
    && empty($entity->_wo_clock_write)
    && empty($entity->_signoff_reconciliation)) {
    $entity->set('field_source', 'manual');
    $who = \Drupal::currentUser()->getDisplayName();
    if ($entity->hasField('field_start_time') && !$entity->get('field_start_time')->isEmpty()) {
      _wo_clock_append_note($entity, sprintf('[Start: Manual %s by %s]', _wo_clock_fmt_us($entity->get('field_start_time')->value), $who));
    }
    if ($entity->hasField('field_end_time') && !$entity->get('field_end_time')->isEmpty()) {
      _wo_clock_append_note($entity, sprintf('[End: Manual %s by %s]', _wo_clock_fmt_us($entity->get('field_end_time')->value), $who));
    }
  }

  /** @var \Drupal\wo_clock\Service\WoClockService $svc */
  $svc = \Drupal::service('wo_clock.clock_service');

  $wo_id = ($entity->hasField('field_work_order') && !$entity->get('field_work_order')->isEmpty())
    ? (int) $entity->get('field_work_order')->target_id : 0;
  if ($wo_id <= 0) {
    return;
  }
  $prop = $svc->getPropertyLocation($wo_id);
  if (!$prop) {
    return;
  }

  foreach ([
    'field_clock_in_location' => 'field_clock_in_distance_ft',
    'field_clock_out_location' => 'field_clock_out_distance_ft',
  ] as $locField => $distField) {
    if (!$entity->hasField($locField) || $entity->get($locField)->isEmpty()
      || !$entity->hasField($distField)) {
      continue;
    }
    $geo = $entity->get($locField)->first()->getValue();
    if (!isset($geo['lat'], $geo['lon'])) {
      continue;
    }
    try {
      $feet = $svc->calculateDistanceFeet((float) $geo['lat'], (float) $geo['lon'], $prop['lat'], $prop['lon']);
      $entity->set($distField, round($feet, 2));
    }
    catch (\Throwable $e) {
      // Silent — leave the distance null.
      \Drupal::logger('wo_clock')->notice('Distance calc skipped on entry @id: @m', ['@id' => $entity->id() ?? 'new', '@m' => $e->getMessage()]);
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_view() for work_order.
 *
 * Coexistence with the flag path: hide the timer-flag render and drop the
 * clock UI in its place. Done in code so it applies to every WO bundle at once
 * (rather than editing 36 view-display configs); the flag field + its config
 * are left intact for the legacy cascade (wo_lawn_mowing / wo_snow_removal).
 */
function wo_clock_work_order_view(array &$build, EntityInterface $entity, $display, $view_mode) {
  // Only on the full page, for authenticated teammates.
  if ($view_mode !== 'full' && $view_mode !== 'default') {
    return;
  }
  $account = \Drupal::currentUser();
  if ($account->isAnonymous()) {
    return;
  }

  // Hide the legacy flag toggle so the UI isn't duplicated.
  if (isset($build['flag_work_order_timer'])) {
    unset($build['flag_work_order_timer']);
  }

  $render = _wo_clock_build_render((int) $entity->id(), $account);
  if ($render) {
    // Render exactly where the flag toggle did — same weight/region, per bundle
    // (weight 9 on landscaping) — so the button lands in the clock cluster
    // mid-page beside the "last clocked out" text, not at the top of the page.
    $flag_component = $display->getComponent('flag_work_order_timer');
    $render['#weight'] = (is_array($flag_component) && isset($flag_component['weight']))
      ? $flag_component['weight'] : 9;
    $build['wo_clock_ui'] = $render;
  }

  // The Hours-group time-entry cards (rendered by the embedded
  // wo_time_clock_entries view) + the modal edit link need these on the page.
  $build['#attached']['library'][] = 'wo_clock/hour_cards';
  $build['#attached']['library'][] = 'core/drupal.dialog.ajax';
}

/**
 * Implements hook_views_pre_render().
 *
 * Attaches the hour-card CSS + modal library to the per-teammate time-entry
 * view (also covered by the WO-view hook above; harmless if doubled).
 */
function wo_clock_views_pre_render($view) {
  if ($view->id() === 'wo_time_clock_entries') {
    $view->element['#attached']['library'][] = 'wo_clock/hour_cards';
    $view->element['#attached']['library'][] = 'core/drupal.dialog.ajax';
  }
}

/**
 * Implements hook_preprocess_HOOK() for views_view_fields.
 *
 * Builds the time-entry card for each wo_time_clock_entries row so the row
 * template can render a clickable card (opens the entry edit form in a modal).
 */
function wo_clock_preprocess_views_view_fields(array &$variables) {
  $view = $variables['view'] ?? NULL;
  if (!$view || $view->id() !== 'wo_time_clock_entries') {
    return;
  }
  $entry = $variables['row']->_entity ?? NULL;
  if (!$entry instanceof EntityInterface || $entry->getEntityTypeId() !== 'wo_time_clock') {
    return;
  }
  $variables['wo_hour_card'] = _wo_clock_entry_card($entry);
}

/**
 * Implements hook_preprocess_HOOK() for views_view.
 *
 * Adds a per-teammate subtotal footer to the time-entry breakdown (the
 * views_aggregator SUM row is lost when the style switches to card/unformatted).
 */
function wo_clock_preprocess_views_view(array &$variables) {
  $view = $variables['view'] ?? NULL;
  if (!$view || $view->id() !== 'wo_time_clock_entries') {
    return;
  }
  $sum = 0.0;
  $closed = 0;
  $hasOpen = FALSE;
  foreach ($view->result as $row) {
    $e = $row->_entity ?? NULL;
    if (!$e instanceof EntityInterface) {
      continue;
    }
    if ($e->get('field_end_time')->isEmpty()) {
      $hasOpen = TRUE;
      continue;
    }
    $sum += (float) $e->get('field_total_time')->value;
    $closed++;
  }
  if ($closed > 0 || $hasOpen) {
    $label = rtrim(rtrim(number_format($sum, 2), '0'), '.');
    $variables['footer'] = [
      '#markup' => '<div class="wo-hour-subtotal">Total: <strong>' . $label . ' hrs</strong>'
        . ($hasOpen ? ' <span class="wo-hour-subtotal__open">+ open entry</span>' : '') . '</div>',
      '#allowed_tags' => ['div', 'strong', 'span'],
    ];
  }
}

/**
 * Build the card data for one wo_time_clock entry.
 */
function _wo_clock_entry_card(EntityInterface $entry): array {
  $tz = new \DateTimeZone(date_default_timezone_get());
  $utc = new \DateTimeZone('UTC');
  $id = (int) $entry->id();

  $fmt = function (?string $raw, string $format) use ($tz, $utc): string {
    if (!$raw) {
      return '';
    }
    try {
      $d = new \DateTime($raw, $utc);
      $d->setTimezone($tz);
      return $d->format($format);
    }
    catch (\Throwable $e) {
      return '';
    }
  };

  $startRaw = $entry->get('field_start_time')->value;
  $endRaw = $entry->get('field_end_time')->value;
  $open = empty($endRaw);

  // Source → friendly label.
  $srcMap = [
    'flag' => 'Flag',
    'wo_clock_button' => 'Button',
    'wo_clock_intervention' => 'Office',
    'manual' => 'Manual',
    'signoff_reconciliation' => 'Sign-off',
    'cleanup_script' => 'Cleanup',
  ];
  $source = $entry->hasField('field_source') && !$entry->get('field_source')->isEmpty()
    ? (string) $entry->get('field_source')->value : '';

  // Edit form in a modal, returning to the WO page on save.
  $dest = '';
  if (($wo = $entry->get('field_work_order')->entity)) {
    try {
      $dest = $wo->toUrl()->toString();
    }
    catch (\Throwable $e) {
      $dest = '/work_order/' . $wo->id();
    }
  }
  $edit_url = \Drupal\Core\Url::fromRoute(
    'entity.wo_time_clock.edit_form',
    ['wo_time_clock' => $id],
    ['query' => $dest !== '' ? ['destination' => $dest] : []]
  )->toString();

  return [
    'id' => $id,
    'date' => $fmt($startRaw, 'D m/d'),
    'start' => $fmt($startRaw, 'g:i A'),
    'end' => $open ? '' : $fmt($endRaw, 'g:i A'),
    'open' => $open,
    'total' => $open ? '' : rtrim(rtrim(number_format((float) $entry->get('field_total_time')->value, 2), '0'), '.'),
    'notes' => trim((string) ($entry->get('field_notes')->value ?? '')),
    'source_label' => $srcMap[$source] ?? '',
    'edit_url' => $edit_url,
    // Only office/supervisor (edit access) get the click-to-edit modal link;
    // crew see a plain, non-clickable card.
    'editable' => $entry->access('update'),
  ];
}

/**
 * Build the clock UI render array for a WO + account.
 *
 * Shared by WoClockBlock::build() and the WO view integration so the block
 * plugin and the inline placement render identically. Returns NULL when there
 * is no WO context.
 *
 * @return array|null
 */
function _wo_clock_build_render(int $wo_id, \Drupal\Core\Session\AccountInterface $account): ?array {
  if ($wo_id <= 0) {
    return NULL;
  }
  /** @var \Drupal\wo_clock\Service\WoClockService $svc */
  $svc = \Drupal::service('wo_clock.clock_service');
  $uid = (int) $account->id();

  $current = $svc->getCurrentEntryOnWo($uid, $wo_id);
  $openElsewhere = $svc->getOpenEntriesForUser($uid, $wo_id);

  if ($current) {
    $state = 'b';
  }
  elseif ($openElsewhere) {
    $state = 'c';
  }
  else {
    $state = 'a';
  }

  $currentData = NULL;
  if ($current) {
    $start = (string) $current->get('field_start_time')->value;
    $currentData = [
      'entry_id' => (int) $current->id(),
      'start_us' => _wo_clock_fmt_us($start),
      'elapsed' => _wo_clock_elapsed($start),
    ];
  }

  // Each open entry becomes a themed render array (wo_clock_alert_entry) so the
  // same single-entry template backs the alert region here and any programmatic
  // render; the JS modal mirrors this markup client-side.
  $openData = [];
  foreach ($openElsewhere as $e) {
    $eWo = $e->get('field_work_order')->entity;
    $prop = ($eWo && $eWo->hasField('field_property') && !$eWo->get('field_property')->isEmpty())
      ? $eWo->get('field_property')->entity : NULL;
    $start = (string) $e->get('field_start_time')->value;
    $openData[] = [
      '#theme' => 'wo_clock_alert_entry',
      '#entry' => [
        'entry_id' => (int) $e->id(),
        'wo_id' => $eWo ? (int) $eWo->id() : 0,
        'wo_url' => $eWo ? $eWo->toUrl()->toString() : '',
        'property' => $prop ? $prop->label() : ($eWo ? $eWo->label() : 'Work Order'),
        'start_us' => _wo_clock_fmt_us($start),
        'start_local' => _wo_clock_fmt_local($start),
        'now_local' => _wo_clock_now_local(),
        'ago' => _wo_clock_ago($start),
      ],
    ];
  }

  return [
    '#theme' => 'wo_clock_block',
    '#state' => $state,
    '#wo_id' => $wo_id,
    '#current_entry' => $currentData,
    '#open_entries' => $openData,
    '#attached' => [
      'library' => ['wo_clock/clock'],
      'drupalSettings' => [
        'woClock' => [
          'woId' => $wo_id,
          'endpoints' => [
            'clockIn' => \Drupal\Core\Url::fromRoute('wo_clock.clock_in', ['wo_id' => $wo_id])->toString(),
          ],
        ],
      ],
    ],
    '#cache' => [
      'contexts' => ['user', 'route'],
      'tags' => ['wo_time_clock_list'],
      'max-age' => 0,
    ],
  ];
}

/**
 * Append a structured note line to a wo_time_clock entity's field_notes,
 * newline-separated (accumulates; never replaces existing content).
 */
function _wo_clock_append_note(EntityInterface $entity, string $line): void {
  $existing = (string) ($entity->get('field_notes')->value ?? '');
  $entity->set('field_notes', $existing === '' ? $line : $existing . "\n" . $line);
}

/**
 * Format a UTC datetime storage string as US MM/DD/YYYY h:i AM/PM (site tz).
 */
function _wo_clock_fmt_us(?string $utc): string {
  if (!$utc) {
    return '';
  }
  try {
    $d = new \DateTime($utc, new \DateTimeZone('UTC'));
    $d->setTimezone(new \DateTimeZone(date_default_timezone_get()));
    return $d->format('m/d/Y g:i A');
  }
  catch (\Throwable $e) {
    return '';
  }
}

/**
 * Format a UTC storage string as a site-tz value for an <input type="datetime-local">
 * (Y-m-d\TH:i). Empty string on failure/empty input.
 */
function _wo_clock_fmt_local(?string $utc): string {
  if (!$utc) {
    return '';
  }
  try {
    $d = new \DateTime($utc, new \DateTimeZone('UTC'));
    $d->setTimezone(new \DateTimeZone(date_default_timezone_get()));
    return $d->format('Y-m-d\TH:i');
  }
  catch (\Throwable $e) {
    return '';
  }
}

/**
 * "Now" in site tz as a datetime-local value (Y-m-d\TH:i) — for the picker's max.
 */
function _wo_clock_now_local(): string {
  try {
    return (new \DateTime('now', new \DateTimeZone(date_default_timezone_get())))->format('Y-m-d\TH:i');
  }
  catch (\Throwable $e) {
    return '';
  }
}

/**
 * Elapsed "Xh Ym" since a UTC start.
 */
function _wo_clock_elapsed(?string $utc): string {
  if (!$utc) {
    return '';
  }
  try {
    $s = \Drupal::time()->getRequestTime() - (new \DateTime($utc, new \DateTimeZone('UTC')))->getTimestamp();
    $s = max(0, $s);
    $h = intdiv($s, 3600);
    $m = intdiv($s % 3600, 60);
    return $h > 0 ? "{$h}h {$m}m" : "{$m}m";
  }
  catch (\Throwable $e) {
    return '';
  }
}

/**
 * Human "3 days ago" / "this morning" for a UTC start.
 */
function _wo_clock_ago(?string $utc): string {
  if (!$utc) {
    return '';
  }
  try {
    $s = \Drupal::time()->getRequestTime() - (new \DateTime($utc, new \DateTimeZone('UTC')))->getTimestamp();
    if ($s < 0) {
      $s = 0;
    }
    if ($s < 3600) {
      return max(1, (int) round($s / 60)) . ' min ago';
    }
    if ($s < 43200) {
      return (int) round($s / 3600) . ' hr ago';
    }
    $days = (int) floor($s / 86400);
    if ($days <= 0) {
      return 'earlier today';
    }
    return $days === 1 ? 'yesterday' : "$days days ago";
  }
  catch (\Throwable $e) {
    return '';
  }
}
