<?php

/**
 * @file
 * Module file for the WO Material List Form.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_entity_presave().
 */
function wo_material_list_form_entity_presave(EntityInterface $entity) {
  if ($entity->getEntityTypeId() === 'wo_material_list_item' && $entity->hasField('field_list_id') && !$entity->get('field_list_id')->target_id) {
    $parent_list = \Drupal::routeMatch()->getParameter('wo_material_list');
    if ($parent_list) {
      $entity->set('field_list_id', ['target_id' => $parent_list->id()]);
    }
  }
}

/**
 * Implements hook_form_alter().
 *
 * On any material-line add/edit form (all form modes), hide the freight amount
 * until "Add Freight" is checked — so a normal line looks unchanged. Keyed on
 * the presence of both fields, so it is inert on every other form.
 */
function wo_material_list_form_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  if (isset($form['field_add_freight']) && isset($form['field_freight'])) {
    $form['field_freight']['#states']['visible'][':input[name="field_add_freight[value]"]'] = ['checked' => TRUE];
  }
}