{#
/**
 * @file
 * WO Notes EVA row — one note card.
 *
 * Vars from wo_notes_preprocess_views_view_fields():
 *   attribution    — "Name, m/d/Y g:i A" (who logged it + when).
 *   body_lines     — system notes: labeled lines (Scheduled/Rescheduled,
 *                    Assigned, Schedule note).
 *   show_html_body — manual notes: render the formatted body (preserves HTML).
 *   accent_class   — wo-note-card--system | wo-note-card--manual.
 *   edit_url       — modal edit-form URL (empty if the user can't edit).
 *
 * The whole card opens the note's edit form in a modal via JS (see
 * wo-notes-toggle.js: data-edit-url), when the user can edit; otherwise it
 * renders as a plain, non-clickable card. It must NOT be an <a> — note bodies
 * can contain links, and nested anchors are invalid HTML (browsers split them).
 */
#}
{% set card_inner %}
  <div class="wo-note-attribution">{{ attribution }}</div>
  {% if body_lines %}
    <div class="wo-note-body">
      {% for line in body_lines %}
        <div class="wo-note-line">{{ line }}</div>
      {% endfor %}
    </div>
  {% elseif show_html_body %}
    <div class="wo-note-body">{{ fields.field_note_text.content }}</div>
  {% endif %}
{% endset %}

{#
  The whole card opens the edit modal, but it must be a <div>, not an <a>:
  note bodies can contain links (e.g. a "WO#12345" cross-reference), and nested
  <a> tags are invalid HTML — the browser force-closes the outer card link at
  the inner link, splitting the card apart. JS (wo-notes-toggle.js) opens the
  modal on click via data-edit-url, and ignores clicks on real inner links.
#}
{% if edit_url %}
  <div class="wo-note-card wo-note-card--link {{ accent_class }}"
       data-edit-url="{{ edit_url }}" role="button" tabindex="0">
    {{ card_inner }}
  </div>
{% else %}
  <div class="wo-note-card {{ accent_class }}">
    {{ card_inner }}
  </div>
{% endif %}
