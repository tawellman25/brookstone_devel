<?php

use Drupal\Core\Entity\EntityInterface;
use Drupal\user\Entity\User;
use Drupal\Core\Url;
use Drupal\Core\Datetime\DrupalDateTime;
use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_entity_prepare_form().
 *
 * Default a brand-new scheduling:work_order form to TODAY, ALL DAY.
 *
 * The Smart Date widget's JS only ticks its "All day" checkbox when
 * the rendered start/end time inputs are exactly 00:00:00 / 23:59:00
 * (setAllDay() in smart_date.js). Setting the form display's
 * default_duration to 1439 makes the duration default to all-day but
 * does NOT produce those midnight times on a blank Add form, so the
 * box stayed unchecked. Seeding field_date here — today, 00:00 to
 * 23:59 America/Denver, duration 1439 — makes the widget render the
 * midnight/23:59 inputs, so the JS checks the box.
 *
 * Begin/end times are fully preserved: this only sets the *default*.
 * Unchecking All Day reveals the normal time pickers exactly as
 * before; the user changes the day (and times, if a real appointment)
 * as needed.
 *
 * The field_date field has its own default value (default_date_type
 * 'now', default_duration 15) which Drupal auto-applies at entity
 * create — so field_date is never actually "empty" here. We
 * deliberately override that now/15 default with today/all-day.
 * Smart Date's field default parses default_date in UTC, which makes
 * "midnight in America/Denver" impossible to express reliably as
 * config (DST-shifting offset) — hence doing it here in code.
 *
 * Guards:
 *  - Only the scheduling:work_order entity form.
 *  - Only NEW entities (never touches an existing schedule). On AJAX
 *    / validation rebuilds the entity is reused from form state and
 *    this hook does not re-fire, so a user's edited date persists.
 *  - All programmatic creators (bos_scheduling, admin_calendar,
 *    contract enrichers) build entities directly and never hit an
 *    entity form, so this hook never fires for them — their explicit
 *    field_date values are untouched.
 */
function wo_schedule_entity_prepare_form(EntityInterface $entity, $operation, FormStateInterface $form_state) {
  if ($entity->getEntityTypeId() !== 'scheduling' || $entity->bundle() !== 'work_order') {
    return;
  }
  if (!$entity->isNew()) {
    return;
  }
  if (!$entity->hasField('field_date')) {
    return;
  }

  $tz = new \DateTimeZone('America/Denver');
  $start = new DrupalDateTime('now', $tz);
  $start->setTime(0, 0, 0);
  $end = clone $start;
  $end->setTime(23, 59, 0);

  $entity->set('field_date', [
    'value' => $start->getTimestamp(),
    'end_value' => $end->getTimestamp(),
    'duration' => 1439,
  ]);
}

/**
 * Sync Smart Date -> Date Range as UTC (display America/Denver).
 */
function wo_schedule_entity_presave(EntityInterface $entity) {
  if ($entity->getEntityTypeId() !== 'scheduling' || $entity->bundle() !== 'work_order') {
    return;
  }

  // Smart Date -> Date Range sync (only when field_date is present).
  if (!$entity->get('field_date')->isEmpty()) {
    $smart_date = $entity->get('field_date')->first();
    $start_value = $smart_date->value; // Unix timestamp (UTC).
    $end_value = $smart_date->end_value ?: $start_value;
    $is_all_day = ($smart_date->duration == 0 || $smart_date->duration == 1439);

    $start = new DrupalDateTime('@' . $start_value, new \DateTimeZone('UTC'));
    if ($is_all_day) {
      $start->setTimezone(new \DateTimeZone('America/Denver'))->setTime(0, 0, 0);
      $end = (clone $start)->setTime(23, 59, 59);
      $start->setTimezone(new \DateTimeZone('UTC'));
      $end->setTimezone(new \DateTimeZone('UTC'));
    }
    else {
      $end = new DrupalDateTime('@' . $end_value, new \DateTimeZone('UTC'));
    }

    $entity->set('field_scheduled_date_and_time', [
      'value' => $start->format('Y-m-d\TH:i:s'),
      'end_value' => $end->format('Y-m-d\TH:i:s'),
    ]);
  }

  // Capture the schedule-change WO note. Runs AFTER the smart-date
  // sync above so the "new" date compared is the final stored value.
  // $entity->original is not populated on update in this Drupal
  // version, so old values come from loadUnchanged() (presave still
  // sees the pre-write DB row). The composed note text is stashed on
  // the entity and written post-save by the insert/update hooks.
  _wo_schedule_capture_change_note($entity);
}

/**
 * Build the schedule-change note text (if anything tracked changed)
 * and stash it on the entity for the post-save writer.
 *
 * Tracked: field_scheduled_date_and_time, field_assigned_to,
 * field_scheduling_note. Insert -> a snapshot of populated values.
 * Update -> only the fields that actually changed, old -> new.
 * Nothing changed -> nothing stashed (no-op resaves stay quiet).
 */
function _wo_schedule_capture_change_note(EntityInterface $entity): void {
  // Date-only label. Stored values are UTC; an all-day schedule is
  // saved as midnight→23:59:59 Denver (06:00 UTC → 05:59:59 UTC next
  // day), which read as a misleading ~24h "6:00 AM – 5:59 AM" span.
  // Convert UTC → America/Denver and format the date only, so a
  // single-day schedule shows one clean date and a genuine multi-day
  // range shows "start – end".
  $fmtDate = function ($iso) {
    if (empty($iso)) {
      return '(none)';
    }
    try {
      $dt = new DrupalDateTime($iso, new \DateTimeZone('UTC'));
      $dt->setTimezone(new \DateTimeZone('America/Denver'));
      return $dt->format('m/d/Y');
    }
    catch (\Exception $e) {
      return $iso;
    }
  };
  $name = function ($uid) {
    if (!$uid) {
      return '(unassigned)';
    }
    $u = User::load($uid);
    return $u ? $u->getDisplayName() : "uid {$uid}";
  };
  $dateLabel = function ($start, $end) use ($fmtDate) {
    if (empty($start)) {
      return '(none)';
    }
    $s = $fmtDate($start);
    $e = !empty($end) ? $fmtDate($end) : $s;
    return ($s === $e) ? $s : ($s . ' – ' . $e);
  };

  $newStart = $entity->get('field_scheduled_date_and_time')->value ?? NULL;
  $newEnd = $entity->get('field_scheduled_date_and_time')->end_value ?? NULL;
  $newAssigned = $entity->get('field_assigned_to')->target_id ?? NULL;
  $newNote = trim((string) ($entity->get('field_scheduling_note')->value ?? ''));

  // Structured stash: the card builds attribution from the note's uid + created,
  // so there is no "by {actor}, {stamp}" prefix here. summary = machine diff;
  // note = the scheduling note's NEW value only.
  $parts = [];

  if ($entity->isNew()) {
    if (!empty($newStart)) {
      $parts[] = 'Scheduled: ' . $dateLabel($newStart, $newEnd);
    }
    if (!empty($newAssigned)) {
      $parts[] = 'Assigned: ' . $name($newAssigned);
    }
    $summary = implode('; ', $parts);
    $note = $newNote;
    if ($summary === '' && $note === '') {
      return;
    }
    $entity->_wo_schedule_change_note = [
      'summary' => $summary,
      'note' => $note,
      'kind' => 'schedule_insert',
    ];
    return;
  }

  $old = \Drupal::entityTypeManager()->getStorage('scheduling')->loadUnchanged($entity->id());
  if (!$old instanceof EntityInterface) {
    return;
  }
  $oldStart = $old->get('field_scheduled_date_and_time')->value ?? NULL;
  $oldEnd = $old->get('field_scheduled_date_and_time')->end_value ?? NULL;
  $oldAssigned = $old->get('field_assigned_to')->target_id ?? NULL;
  // Pre-write values for the single timeline entry written post-save by
  // _wo_schedule_handle_status_update() (same reason as above: presave is
  // where the old row is reliably readable).
  $entity->_wo_schedule_prev = ['start' => $oldStart, 'assigned' => $oldAssigned];
  $oldNote = trim((string) ($old->get('field_scheduling_note')->value ?? ''));

  if ($oldStart !== $newStart || $oldEnd !== $newEnd) {
    $parts[] = 'Rescheduled: ' . $dateLabel($oldStart, $oldEnd) . ' → ' . $dateLabel($newStart, $newEnd);
  }
  if ((string) $oldAssigned !== (string) $newAssigned) {
    $parts[] = 'Assigned: ' . $name($oldAssigned) . ' → ' . $name($newAssigned);
  }
  $summary = implode('; ', $parts);
  // Scheduling note: NEW value only when it changed; do not restate if unchanged.
  $note = ($oldNote !== $newNote) ? $newNote : '';
  if ($summary === '' && $note === '') {
    return;
  }
  $entity->_wo_schedule_change_note = [
    'summary' => $summary,
    'note' => $note,
    'kind' => 'schedule_change',
  ];
}

/**
 * Insert.
 */
function wo_schedule_entity_insert(EntityInterface $entity) {
  if ($entity->getEntityTypeId() === 'scheduling' && $entity->bundle() === 'work_order') {
    _wo_schedule_handle_status_update($entity, TRUE);
    _wo_schedule_send_email_on_assignment($entity);
    _wo_schedule_log_schedule_change_note($entity, TRUE);
  }
}

/**
 * Update.
 */
function wo_schedule_entity_update(EntityInterface $entity) {
  if ($entity->getEntityTypeId() === 'scheduling' && $entity->bundle() === 'work_order') {
    _wo_schedule_handle_status_update($entity, FALSE);
    _wo_schedule_send_email_on_assignment($entity);
    _wo_schedule_log_schedule_change_note($entity, FALSE);
  }
}

/**
 * Post-save writer: persist the schedule-change note that
 * _wo_schedule_capture_change_note() composed during presave.
 *
 * The text is stashed on $entity->_wo_schedule_change_note in
 * presave (where old values are reliably available via
 * loadUnchanged, since $entity->original is not populated on
 * update in this Drupal version). Writing here, post-save, means
 * the note is only created if the scheduling save actually
 * succeeded.
 *
 * Writes to wo_notes:note. field_note_text is text_long (no length
 * limit) so a long misused work-note in field_scheduling_note
 * copies over intact — deliberate: crews have been putting
 * job-notes in the schedule note, and this lands them on the WO's
 * permanent record where they belong.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The saved scheduling entity.
 * @param bool $isNew
 *   Unused (kept for call-site symmetry); insert vs update is
 *   already baked into the stashed text.
 */
function _wo_schedule_log_schedule_change_note(EntityInterface $entity, bool $isNew): void {
  $data = $entity->_wo_schedule_change_note ?? NULL;
  if (empty($data) || !is_array($data)) {
    return;
  }
  $wo_ref = $entity->get('field_work_order')->getValue();
  $wo_id = !empty($wo_ref[0]['target_id']) ? $wo_ref[0]['target_id'] : NULL;
  if (!$wo_id) {
    return;
  }
  try {
    \Drupal::entityTypeManager()->getStorage('wo_notes')->create([
      'type' => 'note',
      'field_change_summary' => $data['summary'] ?? '',
      'field_note_text' => $data['note'] ?? '',
      'field_note_kind' => $data['kind'] ?? 'schedule_change',
      'field_is_system_note' => TRUE,
      'field_work_order' => $wo_id,
      'uid' => \Drupal::currentUser()->id(),
      'created' => \Drupal::time()->getRequestTime(),
    ])->save();
  }
  catch (\Throwable $e) {
    \Drupal::logger('wo_schedule')->error(
      'Failed to write schedule-change WO note for WO @wo: @msg',
      ['@wo' => $wo_id, '@msg' => $e->getMessage()]
    );
  }
}

/**
 * ONE work-order timeline entry per scheduling change (2026-11-14).
 *
 * Before this a dated + assigned insert wrote three entries ("Scheduled for
 * …", "Assigned to X (Scheduled)", "Assigned to X Scheduled for …"), and the
 * all-day time printed as "07:00 AM" because the stored UTC datetime was read
 * as local. Todd: "We only need one entry." Rules kept from the original:
 * - a record WITH a date keeps the WO at Scheduled (1091), never Assigned;
 * - Assigned (1090) only when there is no date;
 * - Complete / Canceled work orders are never touched;
 * - the WO's scheduled flag is set when a date lands.
 * New: clearing the assignee or the date is recorded too (it used to vanish),
 * and the label is the schedule as a person reads it (date only for all-day,
 * date + time for a timed stop). Old values come from the presave stash
 * ($entity->_wo_schedule_prev); without it an update stays quiet rather than
 * guess.
 */
function _wo_schedule_handle_status_update(EntityInterface $entity, $isNew) {
  $work_order_id = (int) ($entity->get('field_work_order')->target_id ?? 0);
  $work_order = $work_order_id ? \Drupal::entityTypeManager()->getStorage('work_order')->load($work_order_id) : NULL;
  if (!$work_order) {
    return;
  }

  // wo_status vocabulary.
  $STATUS_ASSIGNED = 1090;
  $STATUS_SCHEDULED = 1091;
  $STATUS_COMPLETE = 1097;
  $STATUS_CANCELED = 1098;

  $current = (int) ($work_order->get('field_status')->target_id ?? 0);
  if (in_array($current, [$STATUS_COMPLETE, $STATUS_CANCELED], TRUE)) {
    return;
  }

  $assigned_id = (int) ($entity->get('field_assigned_to')->target_id ?? 0);
  $hasDate = !empty($entity->get('field_scheduled_date_and_time')->value);
  $when = $hasDate ? _wo_schedule_when_label($entity) : '';
  $who = $assigned_id ? _wo_schedule_user_name($assigned_id) : '';

  if ($isNew) {
    if ($hasDate && $who !== '') {
      $note = "Scheduled for {$when} — assigned to {$who}";
    }
    elseif ($hasDate) {
      $note = "Scheduled for {$when} (unassigned)";
    }
    elseif ($who !== '') {
      $note = "Assigned to {$who} (no date yet)";
    }
    else {
      return;
    }
    $dateLanded = $hasDate;
  }
  else {
    $prev = $entity->_wo_schedule_prev ?? NULL;
    if (!is_array($prev)) {
      return;
    }
    $dateChanged = (string) ($prev['start'] ?? '') !== (string) ($entity->get('field_scheduled_date_and_time')->value ?? '');
    $assigneeChanged = (int) ($prev['assigned'] ?? 0) !== $assigned_id;
    if (!$dateChanged && !$assigneeChanged) {
      return;
    }
    $oldWho = !empty($prev['assigned']) ? _wo_schedule_user_name((int) $prev['assigned']) : '';
    if ($dateChanged && !$hasDate) {
      $note = 'Schedule date removed' . ($who !== '' ? " — still assigned to {$who}" : '');
    }
    elseif ($dateChanged && $assigneeChanged) {
      $note = $who !== ''
        ? "Rescheduled to {$when} — reassigned to {$who}"
        : "Rescheduled to {$when} — unassigned" . ($oldWho !== '' ? " (was {$oldWho})" : '');
    }
    elseif ($dateChanged) {
      $note = "Rescheduled to {$when}" . ($who !== '' ? " ({$who})" : ' (unassigned)');
    }
    else {
      $note = $who !== ''
        ? "Reassigned to {$who}" . ($hasDate ? " for {$when}" : '')
        : 'Unassigned' . ($oldWho !== '' ? " (was {$oldWho})" : '') . ($hasDate ? ", still scheduled for {$when}" : '');
    }
    $dateLanded = $hasDate && $dateChanged;
  }

  // Dated → Scheduled; undated with an assignee → Assigned; undated and
  // unassigned → the WO's current status (record the change, move nothing).
  $status = $hasDate ? $STATUS_SCHEDULED : ($who !== '' ? $STATUS_ASSIGNED : $current);
  wo_schedule_create_wo_status_update($work_order_id, $note, \Drupal::currentUser()->id(), $status, $hasDate ? 1 : 0);
  // Not every WO bundle carries field_scheduled; the entry above is the record.
  if ($dateLanded && $work_order->hasField('field_scheduled') && (int) $work_order->get('field_scheduled')->value !== 1) {
    $work_order->set('field_scheduled', 1)->save();
  }
}

/**
 * Display name for a uid ("uid N" when the account is gone).
 */
function _wo_schedule_user_name(int $uid): string {
  $u = User::load($uid);
  return $u ? $u->getDisplayName() : "uid {$uid}";
}

/**
 * The schedule as a person reads it, America/Denver: "Wed 11/11/2026" for an
 * all-day stop, "Wed 11/11/2026 9:30 AM" for a timed one.
 *
 * Prefers smart-date field_date (timestamp + duration; 1439 = all day). Falls
 * back to the daterange, whose stored value is UTC — never read it as local
 * (that is where the old "07:00 AM" came from: midnight Denver is 07:00 UTC).
 */
function _wo_schedule_when_label(EntityInterface $entity): string {
  $tz = new \DateTimeZone('America/Denver');
  if ($entity->hasField('field_date') && !$entity->get('field_date')->isEmpty() && !empty($entity->get('field_date')->value)) {
    $item = $entity->get('field_date')->first();
    $start = (new \DateTime('@' . (int) $item->value))->setTimezone($tz);
    // Same convention as the presave sync above: duration 0 or 1439 = all day.
    $allDay = in_array((int) ($item->duration ?? 0), [0, 1439], TRUE) || (int) ($item->duration ?? 0) > 1439;
    return $start->format($allDay ? 'D m/d/Y' : 'D m/d/Y g:i A');
  }
  $item = $entity->get('field_scheduled_date_and_time')->first();
  try {
    $start = new \DateTime((string) $item->value, new \DateTimeZone('UTC'));
  }
  catch (\Exception $e) {
    return (string) $item->value;
  }
  $start->setTimezone($tz);
  $allDay = !empty($item->all_day) || $start->format('H:i:s') === '00:00:00';
  return $start->format($allDay ? 'D m/d/Y' : 'D m/d/Y g:i A');
}

/**
 * Create a 'wo_status_updates' entity.
 */
function wo_schedule_create_wo_status_update($work_order_id, $note, $uid, $statusId, $scheduled) {
  $update = \Drupal::entityTypeManager()
    ->getStorage('wo_status_updates')
    ->create([
      'type' => 'update',
      'field_status_of_wo' => $work_order_id,
      'field_status' => $statusId,
      'field_status_change_note' => ['value' => $note],
      'uid' => $uid,
      'field_scheduled' => $scheduled,
    ]);
  $update->save();
}

/**
 * Email on assignment/reassignment.
 */
function _wo_schedule_send_email_on_assignment(EntityInterface $entity) {
  $assigned_id = $entity->get('field_assigned_to')->target_id;
  $notify = $entity->get('field_notify_assigned_teammate')->value;

  \Drupal::logger('wo_schedule')->notice('Entering _wo_schedule_send_email_on_assignment: Assigned ID: @id, Notify: @notify', [
    '@id' => $assigned_id ?? 'None',
    '@notify' => $notify ? 'Yes' : 'No',
  ]);

  if (!$assigned_id || (int) $notify !== 1) {
    return;
  }

  $user = User::load($assigned_id);
  if (!$user || !$user->getEmail()) {
    return;
  }

  $work_order_id = $entity->get('field_work_order')->target_id;
  $url = Url::fromRoute('entity.work_order.canonical', ['work_order' => $work_order_id], ['absolute' => TRUE])->toString();
  $to = $user->getEmail();
  $userName = $user->getDisplayName();
  $dateVal = $entity->get('field_scheduled_date_and_time')->getValue();
  $formattedDate = 'No date set';
  $note = $entity->get('field_scheduling_note')->isEmpty() ? 'No note provided' : $entity->get('field_scheduling_note')->value;

  if (!empty($dateVal) && !empty($dateVal[0]['value'])) {
    $dt = new DrupalDateTime($dateVal[0]['value'], new \DateTimeZone('America/Denver'));
    $formattedDate = $dt->format('m/d/Y h:i A');
  }

  \Drupal::logger('wo_schedule')->notice('Email variables: To: @to, WO ID: @id, Date: @date, URL: @url, Note: @note', [
    '@to' => $to,
    '@id' => $work_order_id,
    '@date' => $formattedDate,
    '@url' => $url,
    '@note' => $note,
  ]);

  try {
    if (!\Drupal::hasService('email_factory')) {
      \Drupal::logger('wo_schedule')->error('Email factory service not found. Ensure Symfony Mailer module is enabled.');
      \Drupal::messenger()->addError(t('Email service unavailable. Please contact the site administrator.'));
      return;
    }

    $email = \Drupal::service('email_factory')->newTypedEmail('wo_schedule', 'schedule_notification');
    $email
      ->setTo($to)
      ->setSubject(t('Work Order #@work_order_id Assignment', ['@work_order_id' => $work_order_id]))
      ->setBody([
        '#type' => 'processed_text',
        '#text' => sprintf(
          '<p>WO#%s has been %s to you and scheduled for %s.</p><p>Scheduling Note: %s</p><p>You can view it <a href="%s">here</a>.</p>',
          $work_order_id,
          ($entity->isNew() ? 'assigned' : 're-assigned'),
          $formattedDate,
          htmlspecialchars($note, ENT_QUOTES, 'UTF-8'),
          $url
        ),
        '#format' => 'full_html',
      ]);

    \Drupal::logger('wo_schedule')->notice('Email to @email: Subject: @subject, Body: @body', [
      '@email' => $to,
      '@subject' => $email->getSubject(),
      '@body' => $email->getBody()['#text'],
    ]);

    $email->send()
      ? \Drupal::messenger()->addStatus(t('Email sent successfully to @name.', ['@name' => $userName]))
      : (\Drupal::messenger()->addError(t('There was a problem sending the email to @email.', ['@email' => $to])) &
         \Drupal::logger('wo_schedule')->error('Failed to send email to @email', ['@email' => $to]));
  }
  catch (\Exception $e) {
    \Drupal::logger('wo_schedule')->error('Email sending failed: @message', ['@message' => $e->getMessage()]);
    \Drupal::messenger()->addError(t('Failed to send email to @email. Please contact the site administrator.', ['@email' => $to]));
  }
}

/**
 * Redirect back to the WO after saving Scheduling.
 */
function wo_schedule_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  if (!in_array($form_id, ['scheduling_work_order_form', 'scheduling_work_order_edit_form'], TRUE)) {
    return;
  }
  $form['actions']['submit']['#submit'][] = 'wo_schedule_scheduling_form_submit';
  \Drupal::logger('wo_schedule')->notice('Form alter triggered for form ID: @id', ['@id' => $form_id]);
}

function wo_schedule_scheduling_form_submit($form, \Drupal\Core\Form\FormStateInterface $form_state) {
  $entity = $form_state->getFormObject()->getEntity();
  if ($entity->getEntityTypeId() === 'scheduling' && $entity->bundle() === 'work_order') {
    $work_order_id = $entity->get('field_work_order')->target_id;
    if ($work_order_id) {
      $form_state->setRedirect('entity.work_order.canonical', ['work_order' => $work_order_id]);
      \Drupal::logger('wo_schedule')->notice('Redirecting to Work Order: @id', ['@id' => $work_order_id]);
    }
    else {
      \Drupal::logger('wo_schedule')->notice('No redirect: field_work_order empty for Scheduling entity: @id', ['@id' => $entity->id() ?: 'new']);
    }
  }
}
