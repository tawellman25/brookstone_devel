<?php

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityStorageException;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Session\AccountInterface;

/**
 * Maps WO bundles to their property_spraying_info bundle equivalent.
 *
 * Only bundles that have a corresponding property_spraying_info type
 * are included here.
 */
function _wo_shared_get_spraying_info_bundle_map(): array {
  return [
    'pre_emergent'           => 'pre_emergent',
    'weed_spraying'          => 'weed_spraying',
    'aspen_twig_gall'        => 'aspen_twig_gall',
    'cooley_spruce_gall'     => 'cooley_spruce',
    'deciduous_bore'         => 'deciduous_bore',
    'dormant_oil'            => 'dormant_oil',
    'grub_prevention'        => 'grub_prevention',
    'pinion_pine_ips_beetle' => 'ips_beetle',
    'trunk_bore'             => 'trunk_bore',
    'deer_prevention'        => NULL,
  ];
}

/**
 * Implements hook_entity_insert().
 *
 * When a spray-related Work Order is created, ensure a matching
 * property_spraying_info record exists for the property.
 * Creates a bare record if one doesn't exist.
 * Never overwrites an existing record.
 */
function wo_shared_entity_insert(EntityInterface $entity) {
  if ($entity->getEntityTypeId() !== 'work_order') {
    return;
  }

  $bundle = $entity->bundle();
  $map = _wo_shared_get_spraying_info_bundle_map();

  if (!array_key_exists($bundle, $map)) {
    return;
  }

  $spraying_info_bundle = $map[$bundle];
  if ($spraying_info_bundle === NULL) {
    return;
  }

  $property_id = $entity->get('field_property')->target_id ?? NULL;
  if (!$property_id) {
    return;
  }

  $existing = \Drupal::entityTypeManager()
    ->getStorage('property_spraying_info')
    ->loadByProperties([
      'type'           => $spraying_info_bundle,
      'field_property' => $property_id,
    ]);

  if (!empty($existing)) {
    return;
  }

  $record = \Drupal::entityTypeManager()
    ->getStorage('property_spraying_info')
    ->create([
      'type'           => $spraying_info_bundle,
      'field_property' => $property_id,
    ]);
  $record->save();

  \Drupal::logger('wo_shared')->notice(
    'Auto-created property_spraying_info:@bundle for property @pid on WO @woid insert.',
    [
      '@bundle' => $spraying_info_bundle,
      '@pid'    => $property_id,
      '@woid'   => $entity->id(),
    ]
  );
}

/**
 * Implements hook_ENTITY_TYPE_insert() for work_order entities.
 *
 * Heals the auto_entitylabel sentinel placeholder
 * (`%AutoEntityLabel: <uuid>%`) that gets stuck in a WO title whenever
 * the entity is created with a single ->save() and its AEL pattern uses
 * the `[work_order:id]` token (30+ WO bundles do). The id is not yet
 * assigned during presave-on-insert, so AEL writes its sentinel expecting
 * a follow-up save to resolve it. Programmatic creators that save only
 * once — and any interactive path that does the same — leave the sentinel
 * in place; pathauto then builds the URL alias (and every child entity's
 * alias) from that garbage string.
 *
 * This is the path-agnostic backstop: regardless of which code path or
 * form created the WO, if the freshly-inserted title carries the
 * sentinel we clear it and save again. AEL's status:2 (OPTIONAL) only
 * fills an empty title, so the second save regenerates the label with
 * the now-known id, and pathauto regenerates the alias from the corrected
 * title. Because the WO title is fixed before any child entities are
 * created, child aliases never inherit the broken segment.
 *
 * No recursion: the heal save is an update, so this insert hook does not
 * re-fire. The guard (sentinel must be present) makes this a no-op for
 * the overwhelming majority of inserts. See drupal_bos_gotchas.md and the
 * cabb8a6e check-up title fix this generalizes.
 */
function wo_shared_work_order_insert(EntityInterface $entity) {
  wo_shared_once_per_year_log($entity);
  if (!$entity->hasField('title')) {
    return;
  }
  $title = (string) $entity->get('title')->value;
  if (strpos($title, '%AutoEntityLabel:') === FALSE) {
    return;
  }

  $entity->set('title', '');
  $entity->save();

  \Drupal::logger('wo_shared')->notice(
    'Healed stuck AutoEntityLabel sentinel on WO @id (@bundle): %before -> %after',
    [
      '@id'     => $entity->id(),
      '@bundle' => $entity->bundle(),
      '%before' => $title,
      '%after'  => $entity->label(),
    ]
  );
}

/**
 * Implements hook_ENTITY_TYPE_presave() for work_order entities.
 *
 * Recalculates field_total_time = sum(wo_time_clock.field_total_time)
 * for the WO's closed clock entries, but only while the WO is in
 * Complete status (1097):
 *   - Pre-completion WOs are skipped — clock data is mid-flight and a
 *     partial total would mislead.
 *   - Invoiced (1281), Paid (1504), Canceled (1098), and Warrantied
 *     (1283) are skipped implicitly because they're not Complete — the
 *     captured-at-billing-time value is preserved once the WO leaves
 *     the Complete state.
 *
 * Pairs with wo_total_time's _wo_total_time_trigger_wo_recalc(): that
 * helper saves the parent WO whenever a wo_time_clock entry is
 * inserted/updated, which then flows through this hook to refresh the
 * roll-up. The combined chain means editing a clock entry on a
 * Complete WO will produce a refreshed total without anyone needing
 * to manually re-save the WO.
 *
 * For lawn_mowing WOs, wo_lawn_mowing also recalculates field_total_time
 * (alongside field_labor_total and other bundle-specific derived
 * fields). Both produce the same value here — sum of clock entries, no
 * multiplier — so the redundancy is idempotent.
 */
function wo_shared_work_order_presave(EntityInterface $entity) {
  // Guard runs before the recalc: an invalid status transition halts
  // the save via EntityStorageException before any totals are touched.
  _wo_shared_assert_invoiced_transition_valid($entity);

  if ($entity->isNew()) {
    return;
  }
  if (!$entity->hasField('field_total_time')) {
    return;
  }
  $status = (int) ($entity->get('field_status')->target_id ?? 0);
  if ($status !== 1097) {
    return;
  }

  // Billable vs non-billable split (item 6, 2026-11-11): Total Time is the
  // BILLABLE sum — what every wo_* labor formula reads — and the flagged
  // remainder is stored beside it. Same closed-entries rule as before.
  $split = wo_shared_clock_hours_split((int) $entity->id());
  $entity->set('field_total_time', $split['billable']);
  if ($entity->hasField('field_non_billable_time')) {
    $entity->set('field_non_billable_time', $split['non_billable'] > 0 ? $split['non_billable'] : NULL);
  }
}

/**
 * Block any work_order save that transitions field_status to Invoiced
 * (1281) without the prior status having been Complete (1097).
 *
 * Catches the recurring "office invoices before crew signs off" mistake
 * — the orphan clock entry and incomplete wo_tasks_list left behind by
 * a premature Invoiced transition blocks the crew from creating new
 * mowing WOs (see WO 49892 — three crew members stuck on 2026-05-13).
 *
 * Allowed transitions:
 *   - any status -> any non-Invoiced status (1281)
 *   - Complete (1097) -> Invoiced (1281)             (normal billing flow)
 *   - Invoiced (1281) -> Invoiced (1281)             (no-op resave)
 *
 * Blocked:
 *   - In Progress / Open / any non-Complete status -> Invoiced
 *   - New entity inserted directly with status = Invoiced
 *
 * Bypass for scripts and migrations: set
 *   $work_order->_skip_invoiced_guard = TRUE;
 * before saving. The UI flow has no path to this flag, so office staff
 * cannot bypass through the form. The flag is documented inline so
 * future maintainers can find it.
 *
 * Throws EntityStorageException with a message that names the WO and
 * explains the required next step.
 */
function _wo_shared_assert_invoiced_transition_valid(EntityInterface $entity): void {
  // 1281 = Invoiced, 1097 = Complete (BOS status taxonomy term IDs).
  $INVOICED = 1281;
  $COMPLETE = 1097;

  if (!empty($entity->_skip_invoiced_guard)) {
    return;
  }
  if (!$entity->hasField('field_status')) {
    return;
  }
  $new_status = (int) ($entity->get('field_status')->target_id ?? 0);
  if ($new_status !== $INVOICED) {
    return;
  }

  if ($entity->isNew()) {
    $prior_status = 0;
  }
  else {
    /** @var \Drupal\Core\Entity\ContentEntityInterface|null $original */
    $original = $entity->original ?? NULL;
    if (!$original instanceof EntityInterface) {
      // Original not available — can't compare. Better to allow than
      // to block legitimate operations that don't carry $entity->original
      // (e.g. some programmatic paths). Logged so we can spot it.
      \Drupal::logger('wo_shared')->warning(
        'Invoiced-transition guard: $entity->original not present on save for WO @id. Allowing save.',
        ['@id' => $entity->id() ?: '(new)']
      );
      return;
    }
    $prior_status = (int) ($original->get('field_status')->target_id ?? 0);
  }

  if ($prior_status === $INVOICED) {
    return;
  }
  if ($prior_status === $COMPLETE) {
    return;
  }

  $wo_label = $entity->hasField('field_work_order_id') && !$entity->get('field_work_order_id')->isEmpty()
    ? '#' . $entity->get('field_work_order_id')->value
    : '#' . ($entity->id() ?: '(new)');

  throw new EntityStorageException(
    "Cannot mark WO $wo_label as Invoiced: the work order must be Complete first. "
    . "The crew has not signed off — wait for them to finish, or contact them to complete the sign-off, "
    . "before flipping the status to Invoiced. "
    . "(Current status term ID: $prior_status; required: $COMPLETE Complete.)"
  );
}

/**
 * Implements hook_form_FORM_ID_alter() for views_exposed_form.
 *
 * Crew fertilizing WO views: trim the exposed Status dropdown to only the
 * statuses a crew can work a live WO by. The taxonomy_index_tid "limit" scopes
 * the option list to the whole wo_status vocabulary (all 15 terms), so the
 * dropdown offered the terminal/done statuses (Complete 1097, Warrantied 1283,
 * Invoiced 1281, Paid 1504, Canceled 1098 — the same set the view now locks off
 * the map) plus Accepted (1503, an estimate status no work order is ever in).
 * Those are dead options that return nothing, so they are removed here.
 *
 * This lives in a module, not the crew theme: theme-level exposed-form alters do
 * not reliably fire for these views (the CSS applied but the theme alter did
 * not), whereas a module hook_form_alter always runs. Everything else in
 * wo_status stays, so a genuinely new active status would still appear.
 */
function wo_shared_form_views_exposed_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  $view = $form_state->get('view');
  if (!$view || !in_array($view->id(), ['teammate_lawn_fertilizer', 'teammate_fertilize_trees_and_shrubs_wos'], TRUE)) {
    return;
  }
  if (empty($form['field_status_target_id']['#options'])) {
    return;
  }
  // Done/terminal statuses + Accepted — hidden from the crew status filter.
  $hide = [1097 => 1, 1283 => 1, 1281 => 1, 1504 => 1, 1098 => 1, 1503 => 1];
  foreach ($form['field_status_target_id']['#options'] as $key => $opt) {
    // Options are stdClass {option: [tid => label]} (hierarchy widget); leave any
    // non-object entry (e.g. an "- Any -" placeholder) untouched.
    if (is_object($opt) && isset($opt->option)) {
      $tid = (int) array_key_first((array) $opt->option);
      if (isset($hide[$tid])) {
        unset($form['field_status_target_id']['#options'][$key]);
      }
    }
  }

  // Compact the widgets via HTML attributes (server-rendered — immune to CSS
  // specificity fights with Olivero and to stale cached stylesheets). The status
  // multiselect defaults to size=9 (one row per option → a tall box); cap it at
  // 5 visible rows (scrolls), and narrow the text inputs.
  $form['field_status_target_id']['#size'] = 5;
  foreach (['field_nickname_value', 'field_street_address_value', 'field_city_name_value'] as $tf) {
    if (isset($form[$tf])) {
      $form[$tf]['#size'] = 22;
    }
  }
}

/**
 * Work order bundles that should only be created once per property per year.
 *
 * Both are once-a-season jobs off the contract, so a second one usually means it
 * was entered by hand after the batch had already created it. Calendar year is a
 * correct season key for both because neither season straddles a year boundary:
 * measured over four years, winterizing is 99.7% Aug–Dec and start-up 99.8%
 * Feb–Jun, and the two never overlap.
 */
const WO_SHARED_ONCE_PER_YEAR_BUNDLES = ['sprinkler_winterizing', 'sprinkler_start_up'];

/**
 * Other work orders of the same service, on the same property, the same year.
 *
 * Canceled (1098) is excluded deliberately: cancel-and-recreate is a real office
 * workflow — seven of the 2026 start-up pairs are exactly that — and warning on
 * it would train people to click through the warning.
 *
 * @return \Drupal\Core\Entity\EntityInterface[]
 *   Keyed by work order id, newest first. Empty when there is no duplicate.
 */
function wo_shared_same_year_duplicates(string $bundle, int $property_id, ?int $exclude_wo = NULL): array {
  if (!$property_id || !in_array($bundle, WO_SHARED_ONCE_PER_YEAR_BUNDLES, TRUE)) {
    return [];
  }
  // Year bounds in the SITE timezone, compared as timestamps. Never a SQL date
  // cast: MariaDB runs UTC on this VPS while the site is America/Denver.
  $tz = new \DateTimeZone(date_default_timezone_get());
  $now = new \DateTime('now', $tz);
  $start = (clone $now)->setDate((int) $now->format('Y'), 1, 1)->setTime(0, 0, 0)->getTimestamp();
  $end = (clone $now)->setDate((int) $now->format('Y'), 12, 31)->setTime(23, 59, 59)->getTimestamp();

  $query = \Drupal::entityTypeManager()->getStorage('work_order')->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', $bundle)
    ->condition('field_property', $property_id)
    ->condition('created', $start, '>=')
    ->condition('created', $end, '<=')
    ->condition('field_status', 1098, '<>')
    ->sort('created', 'DESC');
  if ($exclude_wo) {
    $query->condition('id', $exclude_wo, '<>');
  }
  $ids = $query->execute();
  return $ids ? \Drupal::entityTypeManager()->getStorage('work_order')->loadMultiple($ids) : [];
}

/**
 * Implements hook_form_alter().
 *
 * Warn — do not block — when someone is about to create a second winterizing or
 * start-up work order for a property that already has one this year. The office
 * asked for a confirmation rather than a hard gate, and there are legitimate
 * second visits, so the confirmation IS the override: tick the box and save.
 */
function wo_shared_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id): void {
  foreach (WO_SHARED_ONCE_PER_YEAR_BUNDLES as $bundle) {
    if ($form_id !== 'work_order_' . $bundle . '_form') {
      continue;
    }
    $entity = $form_state->getFormObject()->getEntity();
    // Editing an existing work order is never second-guessed.
    if (!$entity->isNew()) {
      return;
    }
    $form['wo_shared_duplicate_confirm'] = [
      '#type' => 'checkbox',
      '#title' => t('Yes — record a second one anyway'),
      '#description' => t('Tick this only if this property genuinely needs another one this year.'),
      // Hidden until the warning fires, so a normal entry never sees it.
      '#access' => (bool) $form_state->get('wo_shared_duplicate_warned'),
      '#weight' => -50,
    ];
    // Append, never array_unshift: FormBuilder seeds $form['#validate'] with
    // '::validateForm' AFTER hook_form_alter runs, so at this point the key may
    // not exist yet and unshifting a missing key is a fatal in PHP 8. Appending
    // leaves entity validation first and this second, which is the right order.
    $form['#validate'][] = '_wo_shared_duplicate_validate';
    return;
  }
}

/**
 * Validate: one warning, then let it through if confirmed.
 */
function _wo_shared_duplicate_validate(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  // Read the RAW submitted input, not the processed value. The processed value of
  // an element carrying '#access' => FALSE is decided by Drupal's own value
  // juggling rather than by what the person did, and on a programmed submission
  // it came back as 1 for an unticked box — measured, not assumed. Raw input is
  // unambiguous: a browser omits an unticked checkbox entirely.
  $input = $form_state->getUserInput();
  if (!empty($input['wo_shared_duplicate_confirm'])) {
    // Confirmed — remember it so the insert hook can record why.
    $form_state->getFormObject()->getEntity()->_wo_shared_duplicate_confirmed = TRUE;
    return;
  }
  $entity = $form_state->getFormObject()->getEntity();
  // Read the SUBMITTED property, not the entity's: on the add form it arrives
  // from the form (or a prefilled query parameter), not from storage.
  $submitted = $form_state->getValue(['field_property', 0, 'target_id']);
  $property_id = (int) (is_array($submitted) ? ($submitted['target_id'] ?? 0) : $submitted);
  if (!$property_id) {
    $property_id = (int) ($entity->get('field_property')->target_id ?? 0);
  }
  $existing = wo_shared_same_year_duplicates($entity->bundle(), $property_id, (int) $entity->id());
  if (!$existing) {
    return;
  }

  $service = ucwords(str_replace('_', ' ', $entity->bundle()));
  $links = [];
  foreach ($existing as $wo) {
    $links[] = $wo->toLink('WO ' . $wo->id() . ' (' . date('m/d/Y', (int) $wo->get('created')->value) . ')')->toString();
  }
  // Reveal the confirm box on the rebuilt form, and say plainly what exists.
  $form_state->set('wo_shared_duplicate_warned', TRUE);
  $form_state->setRebuild(TRUE);
  $form_state->setErrorByName('field_property', t(
    'This property already has a @service work order this year: @list. Are you sure you want to record a second one? If so, tick "Yes — record a second one anyway" below and save again.',
    ['@service' => $service, '@list' => \Drupal\Core\Render\Markup::create(implode(', ', $links))]
  ));
}

/**
 * Implements hook_ENTITY_TYPE_insert() for work_order.
 *
 * Leave a trail for both halves of this: a deliberately confirmed second one, and
 * a second one created by a path with no form (the contract generator, a bulk
 * action, a script) which gets no warning at all. One of the 2026 winterizing
 * duplicates came from the bulk batch itself, so the log matters.
 */
function wo_shared_once_per_year_log(Drupal\Core\Entity\EntityInterface $entity): void {
  if (!in_array($entity->bundle(), WO_SHARED_ONCE_PER_YEAR_BUNDLES, TRUE)) {
    return;
  }
  $property_id = (int) ($entity->get('field_property')->target_id ?? 0);
  $existing = wo_shared_same_year_duplicates($entity->bundle(), $property_id, (int) $entity->id());
  if (!$existing) {
    return;
  }
  $confirmed = !empty($entity->_wo_shared_duplicate_confirmed);
  $others = implode(', ', array_map(fn($w) => 'WO ' . $w->id(), $existing));
  \Drupal::logger('wo_shared')->warning(
    'Second @bundle work order for property @pid this year: WO @new alongside @others. @how',
    [
      '@bundle' => $entity->bundle(),
      '@pid' => $property_id,
      '@new' => $entity->id(),
      '@others' => $others,
      '@how' => $confirmed ? 'Confirmed on the form.' : 'Created without a form warning.',
    ]
  );
  // A note on the work order itself, so it is visible where the job is, not only
  // in the log. wo_notes is the established structured-note entity.
  try {
    \Drupal::entityTypeManager()->getStorage('wo_notes')->create([
      'type' => 'note',
      'field_work_order' => $entity->id(),
      'field_is_system_note' => TRUE,
      'field_note_kind' => 'other',
      'field_change_summary' => 'Second ' . str_replace('_', ' ', $entity->bundle())
        . ' this year for this property (also ' . $others . ').'
        . ($confirmed ? ' Confirmed by the person who entered it.' : ' Created without a form warning.'),
    ])->save();
  }
  catch (\Throwable $e) {
    // A note is a nice-to-have; never fail the work order over it.
    \Drupal::logger('wo_shared')->warning('Could not note the duplicate on WO @id: @m', ['@id' => $entity->id(), '@m' => $e->getMessage()]);
  }
}

// ─────────────────────────────────────────────────────────────────────
// Target hours on cleanup work orders (job-clock guardrails item 5,
// Todd 2026-11-10). Shared helpers; the per-bundle call sites live in
// wo_fall_cleanup / wo_spring_cleanup (one wo_* module per bundle).
// ─────────────────────────────────────────────────────────────────────

/**
 * Bundles that carry field_target_hours. A cleanup is the one job where last
 * year's hours on the same property are a fair forecast of this year's: same
 * yard, same season, same scope — which is what makes the prefill honest.
 */
const WO_SHARED_TARGET_HOURS_BUNDLES = ['fall_cleanup', 'spring_cleanup'];

/**
 * Statuses whose field_total_time was captured at billing time and has not
 * moved since: Complete (1097), Invoiced (1281), Paid (1504). Only these are
 * trustworthy enough to become a target.
 */
const WO_SHARED_TARGET_HOURS_BILLED_STATUSES = [1097, 1281, 1504];

/**
 * Fallback per-person plausibility cap when wo_total_time's long-shift
 * threshold is unavailable. Normally business_setting.field_long_shift_hours
 * decides — see wo_shared_target_hours_prefill().
 */
const WO_SHARED_TARGET_HOURS_FALLBACK_CAP = 16.0;

/**
 * Sum of CLOSED wo_time_clock entries on a work order, in man-hours.
 *
 * Open punches (no field_end_time) are excluded — the same rule the
 * teammate-operations variance uses — so an in-progress job reads as
 * "hours banked so far", never a partial guess.
 */
function wo_shared_clocked_hours(int $wo_id): float {
  if ($wo_id <= 0) {
    return 0.0;
  }
  $storage = \Drupal::entityTypeManager()->getStorage('wo_time_clock');
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('field_work_order', $wo_id)
    ->exists('field_end_time')
    ->execute();
  $sum = 0.0;
  if ($ids) {
    foreach ($storage->loadMultiple($ids) as $tc) {
      $sum += (float) ($tc->get('field_total_time')->value ?? 0);
    }
  }
  return round($sum, 2);
}

/**
 * The most recent prior-year billed cleanup of the same kind on a property.
 *
 * "Prior year" = created before $before_ts (the start of the new WO's year
 * in the SITE timezone — never a SQL date cast, MariaDB runs UTC here).
 * Same-year siblings are skipped deliberately: a re-do or a cancel-and-
 * recreate in the current season is not a forecast, it is the same job.
 */
function wo_shared_prior_year_cleanup(string $bundle, int $property_id, int $before_ts): ?EntityInterface {
  if ($property_id <= 0 || !in_array($bundle, WO_SHARED_TARGET_HOURS_BUNDLES, TRUE)) {
    return NULL;
  }
  $storage = \Drupal::entityTypeManager()->getStorage('work_order');
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', $bundle)
    ->condition('field_property', $property_id)
    ->condition('field_status', WO_SHARED_TARGET_HOURS_BILLED_STATUSES, 'IN')
    ->condition('field_total_time', 0, '>')
    ->condition('created', $before_ts, '<')
    ->sort('created', 'DESC')
    ->range(0, 1)
    ->execute();
  if (!$ids) {
    return NULL;
  }
  return $storage->load(reset($ids));
}

/**
 * Prefill field_target_hours (+ field_target_hours_source) on a cleanup WO
 * from the most recent prior-year billed cleanup at the same property.
 *
 * Never overwrites a target that is already set — the office's edit wins —
 * and never fabricates one: with no usable prior the field stays empty and
 * the crew sees no target, which is the truth.
 *
 * Plausibility guard: the prior WO's hours per person (roster or clocked —
 * see _wo_shared_people_clocked()) must not exceed
 * business_setting.field_long_shift_hours, the site's own "a shift this long
 * is suspicious" threshold. Measured on the 2026-11-08 nightly, the one
 * prior-year cleanup that fails it is a single 219 h punch from a forgotten
 * clock-out, Invoiced as-is; handing a crew "Target: 219 hrs" would teach
 * them the number means nothing. Those are left blank and logged so the
 * office can set a real target.
 *
 * Does NOT save — call from presave, or save afterwards (backfill).
 *
 * @return string
 *   Outcome code for reporting: 'set' | 'kept' (already had a target) |
 *   'no_field' | 'no_property' | 'no_prior' | 'implausible'.
 */
function wo_shared_target_hours_prefill(EntityInterface $wo): string {
  if ($wo->getEntityTypeId() !== 'work_order' || !$wo->hasField('field_target_hours')) {
    return 'no_field';
  }
  if (!$wo->get('field_target_hours')->isEmpty()) {
    return 'kept';
  }
  $property_id = ($wo->hasField('field_property') && !$wo->get('field_property')->isEmpty())
    ? (int) $wo->get('field_property')->target_id : 0;
  if ($property_id <= 0) {
    return 'no_property';
  }

  // Start of the WO's year, site timezone. A new entity's created is set by
  // ECK's base-field default, but fall back to request time for safety.
  $created = (int) ($wo->get('created')->value ?? 0) ?: \Drupal::time()->getRequestTime();
  $tz = new \DateTimeZone(date_default_timezone_get());
  $year_start = (new \DateTime('@' . $created))->setTimezone($tz);
  $year_start->setDate((int) $year_start->format('Y'), 1, 1)->setTime(0, 0, 0);

  $prior = wo_shared_prior_year_cleanup($wo->bundle(), $property_id, $year_start->getTimestamp());
  if (!$prior) {
    return 'no_prior';
  }
  $hours = round((float) $prior->get('field_total_time')->value, 2);

  // Plausibility: hours per person on the prior WO vs the long-shift cap.
  $people = _wo_shared_people_clocked((int) $prior->id());
  $cap = function_exists('_wo_total_time_get_long_shift_hours')
    ? _wo_total_time_get_long_shift_hours()
    : WO_SHARED_TARGET_HOURS_FALLBACK_CAP;
  if ($hours / max(1, $people) > $cap) {
    \Drupal::logger('wo_shared')->notice(
      'Target hours NOT prefilled on @bundle WO @id (property @prop): prior-year WO @prior carries @h h across @n people (cap @cap h/person) — left for the office to set.',
      ['@bundle' => $wo->bundle(), '@id' => $wo->id() ?? 'new', '@prop' => $property_id, '@prior' => $prior->id(), '@h' => $hours, '@n' => $people, '@cap' => $cap]
    );
    return 'implausible';
  }

  $wo->set('field_target_hours', $hours);
  if ($wo->hasField('field_target_hours_source')) {
    $wo->set('field_target_hours_source', $prior->id());
  }
  return 'set';
}

/**
 * How many people worked a WO, for the per-person plausibility check.
 *
 * The LARGEST of: the sign-off roster (wo_complete_info.field_those_on_crew),
 * distinct teammates with a clock entry, and the entry count. Minimum 1.
 *
 * The roster has to be in there: before the 2026 per-member reconciliation,
 * a cleanup's field_total_time was man-hours for the whole crew while the
 * clock held ONE entry (the foreman's). Measured 2026-11-10: of the 13
 * prior-year cleanups the clock-only count rejected, 12 carried a roster of
 * 4–8 people and sit at 2–12 h per person — ordinary cleanups. Only the
 * 219 h single punch stays implausible (24 h/person across a roster of 9).
 */
function _wo_shared_people_clocked(int $wo_id): int {
  $etm = \Drupal::entityTypeManager();

  $roster = [];
  if ($etm->hasDefinition('wo_complete_info')) {
    $ci_storage = $etm->getStorage('wo_complete_info');
    $ci_ids = $ci_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('field_work_order', $wo_id)
      ->execute();
    foreach ($ci_ids ? $ci_storage->loadMultiple($ci_ids) : [] as $ci) {
      if ($ci->hasField('field_those_on_crew')) {
        foreach ($ci->get('field_those_on_crew') as $item) {
          if ($item->target_id) {
            $roster[(int) $item->target_id] = TRUE;
          }
        }
      }
    }
  }

  $tc_storage = $etm->getStorage('wo_time_clock');
  $tc_ids = $tc_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('field_work_order', $wo_id)
    ->execute();
  $uids = [];
  foreach ($tc_ids ? $tc_storage->loadMultiple($tc_ids) : [] as $tc) {
    $uid = (int) ($tc->get('field_teammate')->target_id ?? 0);
    if ($uid > 0) {
      $uids[$uid] = TRUE;
    }
  }

  return max(1, count($roster), count($uids), count($tc_ids));
}

/**
 * Target-vs-clocked summary for the crew-facing surfaces (clock banner,
 * sign-off), or NULL when the WO has no (positive) target.
 *
 * @return array|null
 *   target, clocked, delta (clocked − target), pct (0–100, capped), over
 *   (bool), *_label (trimmed "5.25" / "5" strings), and source
 *   {id, url, hours, hours_label, date} when the prefill origin is known.
 */
function wo_shared_target_hours_summary(EntityInterface $wo): ?array {
  if (!$wo->hasField('field_target_hours') || $wo->get('field_target_hours')->isEmpty()) {
    return NULL;
  }
  $target = round((float) $wo->get('field_target_hours')->value, 2);
  if ($target <= 0) {
    return NULL;
  }
  $clocked = wo_shared_clocked_hours((int) $wo->id());
  $delta = round($clocked - $target, 2);

  $source = NULL;
  if ($wo->hasField('field_target_hours_source') && !$wo->get('field_target_hours_source')->isEmpty()) {
    $src = $wo->get('field_target_hours_source')->entity;
    if ($src) {
      $src_hours = round((float) ($src->get('field_total_time')->value ?? 0), 2);
      $src_created = (int) ($src->get('created')->value ?? 0);
      $source = [
        'id' => (int) $src->id(),
        'url' => $src->toUrl()->toString(),
        'hours' => $src_hours,
        'hours_label' => wo_shared_hours_label($src_hours),
        // US date, site timezone — storage is UTC (CLAUDE.md "Date Formatting").
        'date' => $src_created ? (new \DateTime('@' . $src_created))->setTimezone(new \DateTimeZone(date_default_timezone_get()))->format('m/d/Y') : '',
      ];
    }
  }

  return [
    'target' => $target,
    'clocked' => $clocked,
    'delta' => $delta,
    'pct' => (int) min(100, round($clocked / $target * 100)),
    'over' => $delta > 0,
    'target_label' => wo_shared_hours_label($target),
    'clocked_label' => wo_shared_hours_label($clocked),
    'delta_label' => wo_shared_hours_label(abs($delta)),
    'source' => $source,
  ];
}

/**
 * "5.25" / "5" — two decimals with trailing zeros trimmed, for hour labels.
 */
function wo_shared_hours_label(float $hours): string {
  $s = rtrim(rtrim(number_format($hours, 2, '.', ''), '0'), '.');
  return $s === '' ? '0' : $s;
}

// ─────────────────────────────────────────────────────────────────────
// Non-billable punches (job-clock guardrails item 6, Todd 2026-11-10).
//
// One teammate's time on a billable job can be kept as hours worked and
// left off the invoice. The ENTRY keeps its true field_total_time; the
// WORK ORDER's field_total_time becomes the billable sum (so the labor
// formulas in the 36 wo_* modules are untouched) and field_non_billable_time
// holds the rest. The foreman makes the call at sign-off (wo_sign_off);
// the office may correct it on the entry form while the WO is Complete.
// ─────────────────────────────────────────────────────────────────────

/**
 * Roles allowed to change the non-billable fields on an entry FORM. The
 * teammates role holds "edit any wo_time_clock entities of bundle entry", so
 * the form would otherwise expose a billing decision to every crew member.
 * The sign-off path writes programmatically and is not subject to this.
 */
const WO_SHARED_NON_BILLABLE_EDIT_ROLES = ['supervisor', 'administration', 'site_assistant', 'site_admin', 'administrator'];

/**
 * WO statuses whose billed totals are frozen: Invoiced (1281), Paid (1504).
 * A non-billable change on an entry under one of these is rejected — move the
 * WO back to Complete first (the same deliberate path wo_billing_recalc uses).
 */
const WO_SHARED_NON_BILLABLE_FROZEN_STATUSES = [1281, 1504];

/**
 * Whether a clock entry is flagged non-billable.
 */
function wo_shared_entry_is_non_billable(EntityInterface $entry): bool {
  return $entry->hasField('field_non_billable') && (bool) ($entry->get('field_non_billable')->value ?? FALSE);
}

/**
 * Closed clock hours on a work order, split billable / non-billable.
 *
 * The single sum every billing path now reads — the 34 per-bundle
 * get_hours_for_*() helpers, wo_sign_off's completion presave and
 * wo_shared_work_order_presave() all delegate here. Open punches (no
 * field_end_time) are excluded, as before.
 *
 * @return array{billable: float, non_billable: float, all: float, flagged: int}
 */
function wo_shared_clock_hours_split(int $wo_id): array {
  $out = ['billable' => 0.0, 'non_billable' => 0.0, 'all' => 0.0, 'flagged' => 0];
  if ($wo_id <= 0) {
    return $out;
  }
  $storage = \Drupal::entityTypeManager()->getStorage('wo_time_clock');
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('field_work_order', $wo_id)
    ->condition('type', 'entry')
    ->exists('field_end_time')
    ->execute();
  if (!$ids) {
    return $out;
  }
  foreach ($storage->loadMultiple($ids) as $tc) {
    $h = (float) ($tc->get('field_total_time')->value ?? 0);
    $out['all'] += $h;
    if (wo_shared_entry_is_non_billable($tc)) {
      $out['non_billable'] += $h;
      $out['flagged']++;
    }
    else {
      $out['billable'] += $h;
    }
  }
  foreach (['billable', 'non_billable', 'all'] as $k) {
    $out[$k] = round($out[$k], 2);
  }
  return $out;
}

/**
 * Billable closed man-hours on a work order — what labor is charged on.
 *
 * Replaces the identical load-and-sum loop that lived in each wo_* module
 * (CLAUDE.md: don't let a third copy land — this was the 34th).
 */
function wo_shared_billable_hours(int $wo_id): float {
  return wo_shared_clock_hours_split($wo_id)['billable'];
}

/**
 * Implements hook_ENTITY_TYPE_presave() for wo_time_clock.
 *
 * Integrity of the non-billable call:
 *   1. A reason is required when the flag is set (programmatic paths too —
 *      the form has its own inline error).
 *   2. Stamp field_non_billable_by / _at when the flag turns on; clear the
 *      reason and stamps when it turns off. Stamps are never user-edited.
 *   3. Reject a change to the flag or reason while the parent WO is Invoiced
 *      or Paid — the invoice already went out with the other number. Move
 *      the WO back to Complete first; wo_total_time then re-saves it and the
 *      labor recomputes on the billable sum.
 */
function wo_shared_wo_time_clock_presave(EntityInterface $entity) {
  if ($entity->bundle() !== 'entry' || !$entity->hasField('field_non_billable')) {
    return;
  }
  $flag = (bool) ($entity->get('field_non_billable')->value ?? FALSE);
  $reason = $entity->hasField('field_non_billable_reason') ? (string) ($entity->get('field_non_billable_reason')->value ?? '') : '';
  // D11.2+ exposes the pre-save copy via getOriginal(); the property is deprecated.
  $orig = method_exists($entity, 'getOriginal') ? $entity->getOriginal() : ($entity->original ?? NULL);
  $was = $orig && $orig->hasField('field_non_billable') ? (bool) ($orig->get('field_non_billable')->value ?? FALSE) : FALSE;
  $was_reason = $orig && $orig->hasField('field_non_billable_reason') ? (string) ($orig->get('field_non_billable_reason')->value ?? '') : '';
  $changed = ($flag !== $was) || ($flag && $reason !== $was_reason);

  if (!$changed) {
    return;
  }

  // 3. Frozen WO guard.
  $wo = ($entity->hasField('field_work_order') && !$entity->get('field_work_order')->isEmpty())
    ? $entity->get('field_work_order')->entity : NULL;
  if ($wo && $wo->hasField('field_status')
      && in_array((int) ($wo->get('field_status')->target_id ?? 0), WO_SHARED_NON_BILLABLE_FROZEN_STATUSES, TRUE)) {
    throw new EntityStorageException(sprintf(
      'Work order %d is Invoiced/Paid — its billed hours are frozen. Move it back to Complete before changing whether entry %s is billable.',
      $wo->id(), $entity->id() ?? 'new'
    ));
  }

  // 1. Reason required.
  if ($flag && $reason === '') {
    throw new EntityStorageException(sprintf(
      'Entry %s marked non-billable without a reason — a reason is required (over_staffed, customer_budget, training, rework, other).',
      $entity->id() ?? 'new'
    ));
  }

  // 2. Stamps.
  if ($flag) {
    if ($entity->hasField('field_non_billable_by')) {
      $by = (int) ($entity->_non_billable_by ?? 0) ?: (int) \Drupal::currentUser()->id();
      $entity->set('field_non_billable_by', $by ?: NULL);
    }
    if ($entity->hasField('field_non_billable_at')) {
      $entity->set('field_non_billable_at', gmdate('Y-m-d\TH:i:s'));
    }
  }
  else {
    if ($entity->hasField('field_non_billable_reason')) {
      $entity->set('field_non_billable_reason', NULL);
    }
    if ($entity->hasField('field_non_billable_by')) {
      $entity->set('field_non_billable_by', NULL);
    }
    if ($entity->hasField('field_non_billable_at')) {
      $entity->set('field_non_billable_at', NULL);
    }
  }
}

/**
 * Implements hook_entity_field_access().
 *
 * The non-billable fields on a clock entry are a billing decision. On FORMS
 * (and REST) only supervisor+ may edit them; everyone who can see the entry
 * may view them. The sign-off path sets them in code, which this hook does
 * not gate — that is the foreman's sanctioned route.
 */
function wo_shared_entity_field_access($operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL) {
  if ($operation !== 'edit' || $field_definition->getTargetEntityTypeId() !== 'wo_time_clock') {
    return AccessResult::neutral();
  }
  if (!in_array($field_definition->getName(), ['field_non_billable', 'field_non_billable_reason', 'field_non_billable_by', 'field_non_billable_at'], TRUE)) {
    return AccessResult::neutral();
  }
  // The stamps are never hand-edited by anyone.
  if (in_array($field_definition->getName(), ['field_non_billable_by', 'field_non_billable_at'], TRUE)) {
    return AccessResult::forbidden('Stamped automatically.');
  }
  $allowed = (bool) array_intersect(WO_SHARED_NON_BILLABLE_EDIT_ROLES, $account->getRoles());
  return AccessResult::forbiddenIf(!$allowed)->addCacheContexts(['user.roles']);
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for wo_time_clock entity forms
 * (add + edit, every operation share the base id): the reason only shows, and
 * is required, when Non-billable is ticked; a tick without a reason is an
 * inline error rather than the presave exception.
 */
function wo_shared_form_wo_time_clock_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  _wo_shared_non_billable_form_alter($form, $form_state);
}

function _wo_shared_non_billable_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  if (!isset($form['field_non_billable']) || !isset($form['field_non_billable_reason'])) {
    return;
  }
  $form['field_non_billable_reason']['#states'] = [
    'visible' => [':input[name="field_non_billable[value]"]' => ['checked' => TRUE]],
  ];
  $form['#validate'][] = '_wo_shared_non_billable_form_validate';
}

function _wo_shared_non_billable_form_validate(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  $flag = (bool) ($form_state->getValue(['field_non_billable', 'value']) ?? FALSE);
  $reason = (string) ($form_state->getValue(['field_non_billable_reason', 0, 'value']) ?? '');
  if ($flag && $reason === '') {
    $form_state->setErrorByName('field_non_billable_reason', t('Pick a reason for marking this time non-billable.'));
  }
}
