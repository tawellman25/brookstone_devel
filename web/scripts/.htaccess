# Deny all HTTP access to this directory.
# These are drush helpers, run only from the CLI:
#   ddev drush php:script web/scripts/<name>.php
# Nothing here is meant to answer a browser or a crawler. Added 2026-11-08.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
