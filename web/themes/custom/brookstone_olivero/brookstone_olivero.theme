<?php

/**
 * @file
 * Theme presentation hooks for brookstone_olivero.
 */

/**
 * Implements hook_preprocess_node().
 *
 * The /about trust page: add the `about-page` wrapper class and attach the
 * scoped about.css library. Gated to the single node whose alias is /about, so
 * no other node is affected. Presentation only — the page's structured data
 * (Organization JSON-LD, meta description, head title) lives in bos_homepage.
 */
function brookstone_olivero_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node || $node->bundle() !== 'page') {
    return;
  }
  try {
    $alias = \Drupal::service('path_alias.manager')
      ->getAliasByPath('/node/' . $node->id());
  }
  catch (\Throwable $e) {
    return;
  }
  if ($alias !== '/about') {
    return;
  }
  $variables['attributes']['class'][] = 'about-page';
  $variables['#attached']['library'][] = 'brookstone_olivero/about';
}

/**
 * Implements hook_theme().
 *
 * Row template for the footer_promo view (fields row style).
 */
function brookstone_olivero_theme($existing, $type, $theme, $path): array {
  return [
    'views_view_fields__footer_promo' => [
      'base hook' => 'views_view_fields',
    ],
  ];
}

/**
 * Implements hook_theme_suggestions_block_alter().
 *
 * Give footer content blocks a bundle-based template suggestion
 * (block--block-content--footer-company.html.twig, etc.).
 */
function brookstone_olivero_theme_suggestions_block_alter(array &$suggestions, array $variables): void {
  $block = $variables['elements']['content']['#block_content'] ?? NULL;
  if ($block) {
    $suggestions[] = 'block__block_content__' . $block->bundle();
  }
}

/**
 * Implements hook_preprocess_views_view_fields().
 *
 * Resolve the promo button URL to a plain href for the row template.
 */
function brookstone_olivero_preprocess_views_view_fields(array &$variables): void {
  if (($variables['view']->id() ?? '') !== 'footer_promo') {
    return;
  }
  $variables['promo_btn_url'] = '';
  $entity = $variables['row']->_entity ?? NULL;
  if ($entity && $entity->hasField('field_promo_btn_url') && !$entity->get('field_promo_btn_url')->isEmpty()) {
    try {
      $variables['promo_btn_url'] = \Drupal\Core\Url::fromUri($entity->get('field_promo_btn_url')->uri)->toString();
    }
    catch (\Throwable $e) {
      // Leave empty — the button is omitted when the URL will not resolve.
    }
  }
}
