<?php

/**
 * @file
 * Theme presentation hooks for brookstone_olivero.
 */

/**
 * Implements hook_preprocess_node().
 *
 * The /about trust page: add the `about-page` wrapper class and attach the
 * scoped about.css library. Gated to the single node whose alias is /about, so
 * no other node is affected. Presentation only — the page's structured data
 * (Organization JSON-LD, meta description, head title) lives in bos_homepage.
 */
function brookstone_olivero_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node || $node->bundle() !== 'page') {
    return;
  }
  try {
    $alias = \Drupal::service('path_alias.manager')
      ->getAliasByPath('/node/' . $node->id());
  }
  catch (\Throwable $e) {
    return;
  }
  if ($alias === '/about') {
    $variables['attributes']['class'][] = 'about-page';
    $variables['#attached']['library'][] = 'brookstone_olivero/about';
    return;
  }
  // Long-form legal / policy pages share one readable treatment.
  if (in_array($alias, ['/privacy', '/terms', '/accessibility'], TRUE)) {
    $variables['attributes']['class'][] = 'legal-page';
    $variables['#attached']['library'][] = 'brookstone_olivero/legal';
  }
}

/**
 * Implements hook_theme().
 *
 * Row template for the footer_promo view (fields row style).
 */
function brookstone_olivero_theme($existing, $type, $theme, $path): array {
  return [
    'views_view_fields__footer_promo' => [
      'base hook' => 'views_view_fields',
    ],
    // Full-bleed rotating banner hero (audience pattern; see ui_patterns.md).
    'bo_hero_banner' => [
      'variables' => [
        'images' => [],
        'title' => '',
        'subtitle' => '',
        // When TRUE, the subtitle shows each image's caption (alt text) and
        // rotates with the slides, instead of the static `subtitle`.
        'alt_subtitle' => FALSE,
      ],
    ],
  ];
}

/**
 * Implements hook_theme_suggestions_block_alter().
 *
 * Give footer content blocks a bundle-based template suggestion
 * (block--block-content--footer-company.html.twig, etc.).
 */
function brookstone_olivero_theme_suggestions_block_alter(array &$suggestions, array $variables): void {
  $block = $variables['elements']['content']['#block_content'] ?? NULL;
  if ($block) {
    $suggestions[] = 'block__block_content__' . $block->bundle();
  }
}

/**
 * Implements hook_preprocess_views_view_fields().
 *
 * Resolve the promo button URL to a plain href for the row template.
 */
function brookstone_olivero_preprocess_views_view_fields(array &$variables): void {
  if (($variables['view']->id() ?? '') !== 'footer_promo') {
    return;
  }
  $variables['promo_btn_url'] = '';
  $entity = $variables['row']->_entity ?? NULL;
  if ($entity && $entity->hasField('field_promo_btn_url') && !$entity->get('field_promo_btn_url')->isEmpty()) {
    try {
      $variables['promo_btn_url'] = \Drupal\Core\Url::fromUri($entity->get('field_promo_btn_url')->uri)->toString();
    }
    catch (\Throwable $e) {
      // Leave empty — the button is omitted when the URL will not resolve.
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for views_exposed_form.
 *
 * Crew fertilizing WO views: trim the exposed Status dropdown to the ACTIVE
 * statuses only. The taxonomy_index_tid "limit" scopes the option list to the
 * whole wo_status vocabulary (all 15 terms, incl. Complete/Invoiced/Paid/
 * Canceled/Warrantied + Accepted), and these views now lock done work orders out
 * entirely — so offering a done status is dead UI that returns nothing. The
 * allowed set is read from the filter's own configured default value (the active
 * statuses), so the list self-maintains if that value ever changes.
 */
function brookstone_olivero_form_views_exposed_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  $view = $form_state->get('view');
  if (!$view || !in_array($view->id(), ['teammate_lawn_fertilizer', 'teammate_fertilize_trees_and_shrubs_wos'], TRUE)) {
    return;
  }
  if (empty($form['field_status_target_id']['#options'])) {
    return;
  }
  // Hide the statuses a crew can never work a live fertilizing WO by: the five
  // DONE/terminal statuses (Complete 1097, Warrantied 1283, Invoiced 1281,
  // Paid 1504, Canceled 1098 — the same set the view now locks off the map) plus
  // Accepted (1503, an estimate status no work order is ever in). Everything else
  // in wo_status stays, so a genuinely new active status would still appear.
  $hide = [1097 => 1, 1283 => 1, 1281 => 1, 1504 => 1, 1098 => 1, 1503 => 1];
  foreach ($form['field_status_target_id']['#options'] as $key => $opt) {
    // Options are stdClass {option: [tid => label]} (hierarchy widget); keep any
    // non-object entry (e.g. an "- Any -" placeholder) untouched.
    if (is_object($opt) && isset($opt->option)) {
      $tid = (int) array_key_first((array) $opt->option);
      if (isset($hide[$tid])) {
        unset($form['field_status_target_id']['#options'][$key]);
      }
    }
  }
}
